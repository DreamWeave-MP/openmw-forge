--!strict
-- l3i stub for @jess/package (provided by jess.stdlib); the runtime module has this shape.
local module: {
    -- Opens a Package Source folder or a `.jpk` file; reads it, runs nothing.
    open: (location: string) -> JessPackage,
    -- Opens the JPK `source` holds, one that isn't a file of its own, named `label` in messages and plans; reads it, runs nothing.
    openJpk: (source: JessJpkSource, label: string) -> JessPackage,
    -- Reads the manifest of the package at `location` and nothing else: what a resolution needs to know whether to open it.
    peek: (location: string) -> JessPackageOffer,
    -- Every package directly inside `folder`, a package path: each Package Source folder and `.jpk` file, in name order.
    candidates: (folder: string) -> { JessPackageOffer },
    -- Packs the Package Source at `source` into the canonical JPK at `output`, written atomically; with `options.version`, at that version, the manifest revised.
    pack: (source: string, output: string, options: { version: string? }?) -> JessPackResult,
    -- `requirement` when it is a version requirement, else an error naming `what`: how a manifest's dependency is checked.
    requirement: (requirement: unknown, what: string) -> string,
    -- Resolves requested layers over `packages` into an activation plan, without running anything; the second result is the packages it selected.
    resolve: (packages: { JessPackage }, request: JessPackageRequest) -> (JessActivationPlan, { JessPackage }),
    -- Parses and checks a `jess.toml`.
    manifest: (text: string) -> JessPackageManifest,
    -- Whether `version` meets `requirement` (`^1.2`, `=1.2.3`).
    satisfies: (version: string, requirement: string) -> boolean,
} = (nil :: any)
return module
