--!strict
local fs = require '@dream/fs'
local process = require '@dream/process'
local planning = require '@forge/plan'
local argsModule = require '@forge/args'
local native = require '@forge/native'
local util = require '@forge/native-util'
local sourceModule = require '@forge/source'

type Options = argsModule.Options
type Plan = planning.Plan

local function required(path: string): (boolean, string?)
  if not fs.isFile(path) then
    return false, 'required file not found: ' .. path
  end
  return true, nil
end

local function preflight(options: Options): (boolean, string?)
  -- Build assets are embedded in the standalone Jess executable.
  -- Source checkouts are no longer needed for the build tool itself.

  if options.repo == '' and (options.command == 'build' or options.command == 'package' or options.command == 'pipeline') then
    local ok, message = required(options.source .. '/CMakeLists.txt')
    if not ok then
      return false, message
    end
  end

  if options.command == 'build' and not options.noPrepare and string.sub(options.archive, 1, 8) ~= 'https://' then
    local ok, message = required(options.archive)
    if not ok then
      return false, message
    end
  end

  if options.command == 'smoke' then
    return required(options.archive)
  end
  return true, nil
end

-- Project a destination through its nearest existing ancestor. This resolves
-- symlink aliases without creating anything, including for not-yet-made roots.
local function resolveProjected(path: string): (string?, string?)
  local candidate = path
  local suffix: { string } = {}
  while true do
    local resolved = fs.canonicalize(candidate)
    if resolved then
      if #suffix == 0 then
        return resolved, nil
      end

      return resolved .. '/' .. table.concat(suffix, '/'), nil
    end

    -- A dangling symlink must not be treated as an ordinary missing path.
    local entry = fs.lstat(candidate)
    if entry and entry.kind == 'symlink' then
      return nil, `unresolvable symlink in writable path: {candidate}`
    end
    local name = fs.fileName(candidate)
    local parent = fs.parent(candidate)
    if not name or not parent then
      return nil, `cannot resolve ancestor of {path}`
    end

    table.insert(suffix, 1, name)
    candidate = parent
  end
end

local function checkDestinations(options: Options): (boolean, string?)
  if options.source == '' then
    return true, nil
  end

  local source, message = resolveProjected(options.source)
  if not source then
    return false, `cannot resolve source path: {message or options.source}`
  end

  local resolvedRoots: { string } = {}
  for _, target in { options.build, options.deps, options.output, options.depsOutput } do
    local resolved, errorMessage = resolveProjected(target)
    if not resolved then
      return false, errorMessage
    end

    if planning.under(resolved, source) or planning.under(source, resolved) then
      return false, `writable path overlaps OpenMW source: {target}`
    end

    for _, earlier in resolvedRoots do
      if planning.under(resolved, earlier) or planning.under(earlier, resolved) then
        return false, `writable paths overlap through symlinks: {target}`
      end
    end
    table.insert(resolvedRoots, resolved)
  end
  return true, nil
end

-- Container tags derive from the actual packed Jess executable and Dockerfile,
-- so different versions never race to overwrite openmw-forge:alma9.
local function imageIdentity(options: Options): string
  local directory = options.root .. '/work/forge-assets'
  local digests: { string } = {}
  for _, file in { directory .. '/forge', directory .. '/Dockerfile' } do
    local stdout = util.checked('sha256sum', { file })
    local hash = stdout:match('^([a-f0-9]+)')
    if not hash or #hash ~= 64 then error('invalid builder input checksum: ' .. file) end
    table.insert(digests, hash:sub(1, 16))
  end
  return 'openmw-forge:alma9-' .. table.concat(digests, '-')
end

local function prepareImage(plan: Plan, options: Options)
  if options.mode ~= 'container' then return end
  local tag = imageIdentity(options)
  for _, item in plan.steps do
    for index, value in item.args do
      if value == 'openmw-forge:alma9' then item.args[index] = tag end
    end
  end
end

local function cachedImage(step: planning.Step): boolean
  if step.args[1] ~= 'build' or step.args[2] ~= '-t' then return false end
  local tag = step.args[3]
  if not tag or not tag:find('openmw-forge:alma9-', 1, true) then return false end

  local result = process.run(step.program, { 'image', 'inspect', '--format', '{{.Id}}', tag }, {
    stdout = 'capture', stderr = 'null',
  })
  -- A mock runner with an empty response does not count as a real image hit.
  return result ~= nil and result.success and (result.stdout or ''):find('sha256:', 1, true) ~= nil
end

local function executeUnlocked(plan: Plan, options: Options): (boolean, string?)
  local ok, message = preflight(options)
  if not ok then
    return false, message
  end

  if options.command == 'doctor' then
    if options.mode == 'local' then
      local osRelease = fs.readFileString('/etc/os-release') or ''
      if not osRelease:match('\nID=almalinux\n') and not osRelease:match('^ID=almalinux\n') then
        return false, 'local builds require an AlmaLinux 9 host (use --mode container on other Linux distributions)'
      end

      if not osRelease:match('VERSION_ID="?9[%."]') and not osRelease:match('VERSION_ID=9\n') then
        return false, 'local builds require AlmaLinux major version 9'
      end
    end
    local programs = if options.mode == 'container' then { options.engine, 'git' } else { 'git', 'cmake', 'tar', 'readelf' }

    for _, program in programs do
      local result, failure = process.run(program, { '--version' }, { stdout = 'capture', stderr = 'capture' })
      if result == nil or not result.success then
        return false, `cannot execute {program}: {failure or 'nonzero exit'}`
      end
      print('PASS ' .. program)
    end

    if options.mode == 'container' then
      local active = process.run(options.engine, { 'info' }, { stdout = 'capture', stderr = 'capture' })
      if not active or not active.success then return false, 'container engine daemon/service is unavailable' end
    end
    print('PASS AlmaLinux 9 profile and embedded assets')
    return true, nil
  end

  ok, message = checkDestinations(options)
  if not ok then
    return false, message
  end

  if #plan.steps > 0 then
    -- Embedded payload materialization can fail on filesystem access.
    local success, errorMessage = pcall(native.bootstrap, options)
    if not success then return false, `embedded asset staging failed: {tostring(errorMessage)}` end
  end

  if options.mode == 'container' and #plan.steps > 0 then
    -- Reading or hashing staged builder inputs may fail due to filesystem/tool errors.
    local identityOk, errorMessage = pcall(prepareImage, plan, options)
    if not identityOk then return false, 'builder identity failed: ' .. tostring(errorMessage) end
  end

  for _, directory in plan.directories do
    local created, failure = fs.mkdir(directory, { recursive = true })
    if not created then
      return false, `cannot prepare {directory}: {failure or ''}`
    end
  end

  for index, item in plan.steps do
    print(`[{index}/{#plan.steps}] {item.name}`)
    if item.program == '@forge' then
      -- A native build step can fail on toolchain, archive, or filesystem errors.
      local success, errorMessage = pcall(native.run, item.args[1] or '', options)
      if not success then return false, `{item.name}: {tostring(errorMessage)}` end

      if item.args[1] == 'source' then
        local valid, why = required(options.source .. '/CMakeLists.txt')
        if not valid then return false, why end
      end
      continue
    end

    if cachedImage(item) then
      print('PASS reuse matching AlmaLinux 9 builder image')
      continue
    end

    -- Docker bind mounts must be written by the host account, not root.
    -- Resolve only at execution time so the planner remains side-effect-free.
    if item.program == 'docker' then
      for argIndex, value in item.args do
        if value ~= '@forge-host-uidgid' then continue end
        local uid = util.checked('id', { '-u' }):match('^(%d+)')
        local gid = util.checked('id', { '-g' }):match('^(%d+)')
        if not uid or not gid then return false, 'cannot resolve Docker host UID/GID' end
        item.args[argIndex] = uid .. ':' .. gid
      end
    end

    local result, failure = process.run(item.program, item.args, { cwd = item.cwd, env = item.env })
    if result == nil then
      return false, `{item.name}: failed to start {item.program}: {failure or ''}`
    end

    if not result.success then
      return false, `{item.name}: {item.program} exited with {tostring(result.code or result.signal or 'unknown status')}`
    end
  end
  return true, nil
end

-- All entrypoints (public and internal workers) take the same canonical
-- resource locks. They live under the user's home cache, NOT options.root:
-- separate Forge workspaces targeting one --build-dir must contend.
-- Sorting canonical identities also rules out inverted-order deadlocks.
local function withResourceLocks(options: Options, action: () -> (boolean, string?)): (boolean, string?)
  local home = process.env('HOME')
  if not home or home:sub(1, 1) ~= '/' then
    return false, 'HOME must be an absolute path to coordinate Forge resource locks'
  end
  local lockRoot = home .. '/.cache/openmw-forge/locks'
  local ready, failure = fs.mkdir(lockRoot, { recursive = true })
  if not ready then return false, 'cannot initialize shared lock directory: ' .. (failure or '') end

  local identities: { string } = {}
  for _, path in { options.deps, options.build, options.output, options.depsOutput } do
    local canonical, problem = resolveProjected(path)
    if not canonical then return false, problem end
    table.insert(identities, canonical)
  end

  if options.repo ~= '' then
    local canonical, problem = resolveProjected(options.source)
    if not canonical then return false, problem end
    table.insert(identities, canonical)
  end

  table.sort(identities)
  local guards: { dream_fs_Lock } = {}
  local prior: string? = nil
  for _, resource in identities do
    if resource == prior then continue end
      local guard, problem = fs.lock(lockRoot .. '/resource-' .. sourceModule.key(resource) .. '.lock')
      if not guard then
        for index = #guards, 1, -1 do guards[index]:unlock() end
        return false, 'resource already in use: ' .. resource .. ': ' .. (problem or 'lock unavailable')
      end
      table.insert(guards, guard)
      prior = resource
  end

  -- Native workers can throw on external tools; locks must release on failure.
  local ok, success, message = pcall(action)
  for index = #guards, 1, -1 do guards[index]:unlock() end
  if not ok then return false, tostring(success) end
  return success, message
end

local function guardPreflight(options: Options): (boolean, string?)
  local ok, problem = preflight(options)
  if not ok then return false, problem end
  return checkDestinations(options)
end

local function execute(plan: Plan, options: Options): (boolean, string?)
  local needsBuild = options.command == 'build' or options.command == 'package' or options.command == 'pipeline'
  if not needsBuild then return executeUnlocked(plan, options) end
  local safe, problem = guardPreflight(options)
  if not safe then return false, problem end

  return withResourceLocks(options, function(): (boolean, string?)
    return executeUnlocked(plan, options)
  end)
end

-- Docker/Podman still calls these worker entrypoints, but they no longer have
-- an unguarded fast path through native.run.
local function executeWorker(options: Options): (boolean, string?)
  local safe, problem = guardPreflight(options)
  if not safe then return false, problem end

  local action = function(): (boolean, string?)
    -- A native worker can throw on toolchain or filesystem errors.
    local ok, message = pcall(native.run, options.command, options)
    if not ok then return false, tostring(message) end
    return true, nil
  end

  if options.command == 'build' or options.command == 'package' or options.command == 'deps' then
    return withResourceLocks(options, action)
  end
  return action()
end

return table.freeze {
  execute = execute, executeWorker = executeWorker,
  preflight = preflight, checkDestinations = checkDestinations,
}
