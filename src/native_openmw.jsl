--!strict
-- OpenMW build worker: prepare toolchains, configure, compile, test.
local fs = require '@dream/fs'
local process = require '@dream/process'
local util = require '@forge/native-util'
local args = require '@forge/args'
local archiveSafety = require '@forge/native-archive'
local packaging = require '@forge/native-package'
local qt = require '@forge/native-qt'
local treeIntegrity = require '@forge/native-tree-integrity'

type Options = args.Options

local function setTools(options: Options): { [string]: string }
  local path = process.env('PATH') or '/usr/bin:/bin'
  return {
    PATH = '/opt/rh/gcc-toolset-13/root/usr/bin:/usr/local/bin:' .. path,
    CC = '/opt/rh/gcc-toolset-13/root/usr/bin/gcc',
    CXX = '/opt/rh/gcc-toolset-13/root/usr/bin/g++',
    CCACHE_DIR = process.env('CCACHE_DIR') or (if options.mode == 'local' then options.root .. '/work/cache/ccache' else '/forge/work/ccache'),
    CCACHE_MAXSIZE = process.env('CCACHE_MAXSIZE') or '2G',
    CCACHE_COMPRESS = 'true',
  }
end

local function installHostDeps()
  util.stream('dnf', { 'install', '-y', 'epel-release', 'dnf-plugins-core' })
  local crb = process.run('crb', { 'enable' }, { stdout = 'null', stderr = 'null' })
  if not crb or not crb.success then
    util.stream('dnf', { 'config-manager', '--set-enabled', 'crb' })
  end

  util.stream('dnf', {
    'install', '-y', 'gcc-toolset-13', 'cmake', 'ccache', 'git', 'python3-pip',
    'mesa-libGL-devel', 'mesa-libEGL-devel', 'libxkbcommon-devel',
    'libxkbcommon-x11', 'libxcb', 'xcb-util', 'xcb-util-image',
    'xcb-util-keysyms', 'xcb-util-wm', 'xcb-util-renderutil',
    'xcb-util-cursor', 'binutils', 'tar', 'gzip', 'p7zip', 'curl',
  })
end

local function extractDeps(options: Options)
  local archive = options.archive
  if string.sub(archive, 1, 8) == 'https://' then
    local suffix = if archive:match('%.tar%.xz$') then '.tar.xz' elseif archive:match('%.7z$') then '.7z' else nil
    if not suffix then error('dependency HTTPS URL must end in .7z or .tar.xz') end
    if options.depsSha256 == '' then error('HTTPS dependency archive requires --deps-sha256') end
    local dest = options.deps .. '/archive-cache/' .. options.depsSha256:lower() .. suffix
    util.mkdir(options.deps .. '/archive-cache')
    if not fs.isFile(dest) then
      local tempDownload = dest .. '.incomplete'
      util.remove(tempDownload)
      util.stream('curl', { '--fail', '--location', '--retry', '3', '--output', tempDownload, archive })
      local digest = util.checked('sha256sum', { tempDownload }):match('^([0-9a-fA-F]+)')
      if not digest or digest:lower() ~= options.depsSha256:lower() then
        util.remove(tempDownload)
        error('downloaded dependency archive SHA-256 mismatch')
      end
      local moved, failure = fs.rename(tempDownload, dest)
      if not moved then error('cannot publish download cache: ' .. (failure or 'unknown')) end
    end
    archive = dest
  end

  if not fs.isFile(archive) then error('missing AlmaLinux 9 dependencies archive: ' .. archive) end

  if options.depsSha256 ~= '' then
    local digest = util.checked('sha256sum', { archive }):match('^([0-9a-fA-F]+)')
    if not digest or digest:lower() ~= options.depsSha256:lower() then
      error('dependency archive SHA-256 mismatch: ' .. archive)
    end
  end
  local digest = util.checked('sha256sum', { archive }):match('^([0-9a-fA-F]+)')
  if not digest then error('could not fingerprint dependency archive') end
  local final = options.deps .. '/openmw-deps'
  util.recoverManagedDirectory(final)

  local fingerprint = digest:lower() .. ':' .. options.triplet .. '\n'
  if util.managed(final) and fs.isFile(final .. '/.forge-extract-id')
    and util.file(final .. '/.forge-extract-id') == fingerprint
    and fs.isFile(final .. '/scripts/buildsystems/vcpkg.cmake')
    and fs.isDir(final .. '/installed/' .. options.triplet .. '/lib')
    and treeIntegrity.qualified(final) then
    print('Reusing verified dependency extraction ' .. digest:sub(1, 12))
    return
  end
  archiveSafety.requireSafeArchive(archive)
  local temp = options.deps .. '/extracting' 
  util.resetManaged(temp)
  if string.match(archive, '%.tar%.xz$') then
    util.stream('tar', { '-xJf', archive, '-C', temp })
  else
    util.stream(util.tool { '7zz', '7z', '7za' }, archiveSafety.extractionArgs(temp, archive))
    -- Preflight already proved no member can be written through an archived
    -- symlink. The first full extraction is also our single decompression.
    -- Match the actual link bytes to the listing before using or publishing
    -- anything from this isolated staging directory.
    archiveSafety.validateArchiveEntries(util.tool { '7zz', '7z', '7za' }, archive,
      function(member: string): string
        local path = temp .. '/' .. member
        local stat = fs.lstat(path)
        if not stat or stat.kind ~= 'symlink' then
          error('extracted dependency link does not match archive: ' .. member)
        end
        local target, failure = fs.readLink(path)
        if not target then error('cannot inspect dependency link: ' .. (failure or member)) end
        return target
      end)
  end
  archiveSafety.validateExtractedLinks(temp)
  local discovered, failure = fs.walk(temp, { include = 'files', sort = true })
  if not discovered then error(failure or 'dependency extraction failed') end
  local root: string? = nil
  local suffix = '/scripts/buildsystems/vcpkg.cmake'
  for _, relative in discovered.paths do
    if relative:sub(-#suffix) == suffix then
      root = temp .. '/' .. relative:sub(1, -#suffix - 1)
      break
    end
  end

  if not root or not fs.isDir(root .. '/installed/' .. options.triplet .. '/lib') then
    error('dependency export lacks vcpkg.cmake and installed triplet libraries')
  end
  -- Validate and populate the *replacement* before touching a working
  -- export. Recovery keeps the previous tree if publication is interrupted.
  local nextTree = options.deps .. '/openmw-deps-next'
  util.resetManaged(nextTree)
  -- The extracted archive is already on the destination filesystem.
  -- Renaming its verified root avoids a second full SDK copy and the peak
  -- disk amplification that copy caused on 14 GB GitHub-hosted runners.
  util.remove(nextTree)
  local kind = fs.lstat(root)
  if not kind or kind.kind ~= 'dir' then error('unsafe extracted SDK root: ' .. root) end
  util.write(root .. '/.openmw-forge-managed', 'openmw-forge-managed-v1\n')
  local renamed, message = fs.rename(root, nextTree)
  if not renamed then error('cannot stage verified dependency export: ' .. (message or 'rename failed')) end
  util.write(nextTree .. '/.forge-extract-id', fingerprint)
  treeIntegrity.record(nextTree)
  util.publishManagedDirectory(nextTree, final)
  util.remove(temp)
end

local function prepare(options: Options)
  if not options.noSystemPackages then installHostDeps() end
  util.mkdir(options.deps)
  qt.prepare(options)
  extractDeps(options)
end

local function configure(options: Options)
  local installed = options.deps .. '/openmw-deps'
  local lib = installed .. '/installed/' .. options.triplet
  local qtRoot = qt.requireInstallation(options)
  if not fs.isDir(lib .. '/lib') then error('missing vcpkg installed libs: ' .. lib) end
  if not fs.isFile(installed .. '/scripts/buildsystems/vcpkg.cmake') then error('missing vcpkg CMake toolchain') end

  local flags = {
    '-S', options.source, '-B', options.build,
    '-DCMAKE_C_COMPILER=' .. (process.env('CC') or (if fs.isFile('/opt/rh/gcc-toolset-13/root/usr/bin/gcc') then '/opt/rh/gcc-toolset-13/root/usr/bin/gcc' else '/usr/bin/cc')),
    '-DCMAKE_CXX_COMPILER=' .. (process.env('CXX') or (if fs.isFile('/opt/rh/gcc-toolset-13/root/usr/bin/g++') then '/opt/rh/gcc-toolset-13/root/usr/bin/g++' else '/usr/bin/c++')),
    '-DOPENMW_CXX_FLAGS=',
    '-DCMAKE_INSTALL_RPATH=$ORIGIN/../lib',
    '-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON',
    '-DCMAKE_PREFIX_PATH=' .. lib .. ';' .. qtRoot,
    '-Dcollada_dom_DIR=' .. lib .. '/share/collada-dom',
    '-DOPENMW_USE_SYSTEM_RECASTNAVIGATION=OFF',
    '-DOPENMW_USE_SYSTEM_SQLITE3=OFF',
    '-DVCPKG_HOST_TRIPLET=' .. options.triplet,
    '-DVCPKG_TARGET_TRIPLET=' .. options.triplet,
    '-DCMAKE_TOOLCHAIN_FILE=' .. installed .. '/scripts/buildsystems/vcpkg.cmake',
    '-DCMAKE_BUILD_TYPE=' .. options.buildType,
  }

  -- New build trees prefer Ninja; preserve a previously selected generator
  -- when an existing CMakeCache.txt is present.
  if not fs.isFile(options.build .. '/CMakeCache.txt') then
    local ninja = process.run('ninja', { '--version' }, { stdout = 'null', stderr = 'null' })
    if ninja and ninja.success then
      table.insert(flags, '-G')
      table.insert(flags, 'Ninja')
    end
  end

  if not options.noCcache then
    table.insert(flags, '-DCMAKE_C_COMPILER_LAUNCHER=ccache')
    table.insert(flags, '-DCMAKE_CXX_COMPILER_LAUNCHER=ccache')
  end

  if options.runTests then
    table.insert(flags, '-DBUILD_OPENMW_TESTS=ON')
    table.insert(flags, '-DBUILD_COMPONENTS_TESTS=ON')
  end

  for _, value in options.cmakeArgs do table.insert(flags, value) end
  util.stream('cmake', flags, nil, setTools(options))
end

local function build(options: Options)
  util.prepareBuildRoot(options.build, options.clean)
  if not options.noPrepare then prepare(options) end
  configure(options)
  local jobs = util.resolveJobs(options.jobs)
  print('OpenMW CMake parallelism: ' .. tostring(jobs) .. ' jobs (' .. tostring(options.jobs) .. ')')
  util.stream('cmake', { '--build', options.build, '--parallel', tostring(jobs) }, nil, setTools(options))
  if options.runTests then
    util.stream('cmake', { '--build', options.build, '--target', 'openmw-tests', 'components-tests', '--parallel', tostring(jobs) }, nil, setTools(options))
    local env = { LD_LIBRARY_PATH = options.deps .. '/openmw-deps/installed/' .. options.triplet .. '/lib:' .. options.deps .. '/QT/' .. options.qtVersion .. '/gcc_64/lib' }
    for _, name in { 'openmw-tests', 'components-tests' } do
      local binary = options.build .. '/' .. name
      if not fs.isFile(binary) then error('missing GoogleTest binary: ' .. binary) end
      util.stream(binary, { '--gtest_filter=' .. options.gtestFilter }, options.build, env)
    end
  end

  if not options.noCcache then
    -- Report actual reuse rather than claiming hypothetical speedups.
    util.stream('ccache', { '--show-stats' }, nil, setTools(options))
  end

  packaging.package(options)
end


return table.freeze { build = build, prepare = prepare, configure = configure, extractDeps = extractDeps }
