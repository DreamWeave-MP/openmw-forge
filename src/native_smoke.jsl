--!strict
-- Validate actual executable invocations, not just archive contents.
local fs = require '@dream/fs'
local process = require '@dream/process'
local util = require '@forge/native-util'
local archive = require '@forge/native-archive'
local abi = require '@forge/native-abi'
local args = require '@forge/args'

type Options = args.Options

-- These OpenMW tools intentionally return 1 after printing --help. A nonzero
-- exit is acceptable only when the tool emits its own unmistakable help text;
-- accepting every exit 1 would hide missing libraries and broken launchers.
local HelpExitOne: { [string]: string } = {
  bsatool = 'Inspect and extract files from Bethesda BSA archives',
  esmtool = 'Inspect and extract from Morrowind ES files',
  niftest = 'Ensure that OpenMW can use the provided NIF',
}

local function validateHelpResult(tool: string, label: string, success: boolean,
  code: number?, signal: number?, stdout: string?, stderr: string?): (boolean, string?)
  local out = stdout or ''
  local err = stderr or ''
  local combined = out .. err
  for _, problem in {
    'error while loading shared libraries', 'symbol lookup error',
    'undefined symbol', 'cannot open shared object',
  } do
    if combined:find(problem, 1, true) then
      return false, `smoke failure in {label}: {combined}`
    end
  end

  local banner = HelpExitOne[tool]
  if banner and out:find(banner, 1, true) ~= nil and err == ''
    and (success or code == 1) then
    return true, nil
  end

  if not success then
    return false, `smoke {label} exited with {tostring(code or signal)}: stdout: {out} stderr: {err}`
  end

  if banner then
    return false, `smoke {label} did not print expected help: stdout: {out} stderr: {err}`
  end
  return true, nil
end

-- GUI programs are launched without --help: OpenMW-CS interprets positional
-- arguments as content filenames, and tries to open a nonexistent '--help'.
-- Its ability to stay alive through a bounded startup window is a liveness
-- check, not a successful help response. Reject fatal startup diagnostics.
local GuiTools = { ['openmw-launcher'] = true, ['openmw-cs'] = true, ['openmw-wizard'] = true }
local GuiWaitSeconds = 5
local CliWaitSeconds = 30

local function smokeInvocationArgs(tool: string): { string }
  if GuiTools[tool] then return {} end
  return { '--help' }
end

local function validateGuiResult(label: string, code: number?, timedOut: boolean,
  stdout: string?, stderr: string?): (boolean, string?)
  local out = stdout or ''
  local err = stderr or ''
  local combined = (out .. err):lower()
  for _, problem in {
    'error while loading shared libraries', 'symbol lookup error',
    'undefined symbol', 'cannot open shared object',
    'could not load the qt platform plugin',
    'no qt platform plugin could be initialized',
    'could not find the qt platform plugin',
    'could not connect to display',
    'failed to create context',
    'fatal error:',
  } do
    if combined:find(problem, 1, true) then
      return false, `GUI smoke {label} failed startup: stdout: {out} stderr: {err}`
    end
  end

  if timedOut then return true, nil end
  if code == 0 then return true, nil end
  return false, `GUI smoke {label} exited with {tostring(code)}: stdout: {out} stderr: {err}`
end

local function validateBoundedResult(tool: string, label: string, code: number?,
  timedOut: boolean, stdout: string?, stderr: string?): (boolean, string?)
  if GuiTools[tool] then return validateGuiResult(label, code, timedOut, stdout, stderr) end
  if timedOut then return false, `CLI smoke {label} exceeded {CliWaitSeconds}s deadline` end
  return validateHelpResult(tool, label, code == 0, code, nil, stdout, stderr)
end

-- Exercise the installed POSIX launchers as users actually invoke them.
-- Testing only .x86_64 binaries misses broken wrappers, paths and library setup.
local function runPackageCommand(stage: string, tool: string, name: string, program: string,
  env: { [string]: string })
  -- GNU timeout terminates the full process group; 124 is accepted only for
  -- known GUI programs that survived a bounded startup without fatal diagnostics.
  local seconds = if GuiTools[tool] then GuiWaitSeconds else CliWaitSeconds
  local invocation = {
    '--signal=TERM', '--kill-after=2s', tostring(seconds) .. 's', program,
  }

  for _, argument in smokeInvocationArgs(tool) do table.insert(invocation, argument) end
  local result, failure = process.run('timeout', invocation,
    { cwd = stage, env = env, stdout = 'capture', stderr = 'capture' })

  if not result then error(`smoke could not run {name}: {failure or ''}`) end
  local valid, reason = validateBoundedResult(tool, name, result.code, result.code == 124,
    result.stdout, result.stderr)
  if not valid then error(reason or `smoke failed: {name}`) end
end

local function smokeBinaries(stage: string, withQt: boolean?)
  local names = {
    'openmw', 'openmw-iniimporter', 'openmw-essimporter', 'openmw-navmeshtool',
    'openmw-bulletobjecttool', 'bsatool', 'esmtool', 'niftest',
  }

  if withQt then
    for _, name in { 'openmw-launcher', 'openmw-cs', 'openmw-wizard' } do
      table.insert(names, name)
    end
  end

  if not fs.isFile(stage .. '/openmw.x86_64') then error('required OpenMW executable is missing from package') end
  if not fs.isFile(stage .. '/openmw') then error('required OpenMW launcher is missing from package') end

  if withQt and not fs.isFile(stage .. '/openmw-launcher.x86_64') then
    error('required OpenMW Qt launcher is missing from package')
  end

  local ran = 0
  for _, name in names do
    local binary = stage .. '/' .. name .. '.x86_64'
    if not fs.isFile(binary) then continue end
    local wrapper = stage .. '/' .. name
    if not fs.isFile(wrapper) then error('missing installed launcher: ' .. name) end
    local env = { LD_LIBRARY_PATH = stage .. '/lib', QT_PLUGIN_PATH = stage .. '/plugins' }
    runPackageCommand(stage, name, name .. '.x86_64', binary, env)
    runPackageCommand(stage, name, name .. ' launcher', wrapper, env)
    ran += 1
    print('PASS smoke binary + launcher ' .. name)
  end

  if ran == 0 then error('no smoke binaries were executed') end
end

-- Qt GUI tools need GL/EGL/GLib and may transitively need Kerberos GSSAPI
-- through QtNetwork. Keep explicit runtime packages in minimal smoke images:
-- dependency-closure preflight below catches further missing SONAMEs at once.
local DistroImages: { [string]: { string } } = {
  ['almalinux-9'] = { 'almalinux:9', 'dnf install -y mesa-libGL libglvnd-egl glib2 krb5-libs libwayland-cursor libwayland-egl' },
  ['debian-12'] = { 'debian:12', 'apt-get update && apt-get install -y libgl1 libegl1 libglib2.0-0 libgssapi-krb5-2 libwayland-cursor0 libwayland-egl1' },
  ['debian-13'] = { 'debian:trixie', 'apt-get update && apt-get install -y libgl1 libegl1 libglib2.0-0t64 libgssapi-krb5-2 libwayland-cursor0 libwayland-egl1' },
  ['ubuntu-22.04'] = { 'ubuntu:22.04', 'apt-get update && apt-get install -y libgl1 libegl1 libglib2.0-0 libgssapi-krb5-2 libwayland-cursor0 libwayland-egl1' },
  ['ubuntu-24.04'] = { 'ubuntu:24.04', 'apt-get update && apt-get install -y libgl1 libegl1 libglib2.0-0t64 libgssapi-krb5-2 libwayland-cursor0 libwayland-egl1' },
  ['fedora-latest'] = { 'fedora:latest', 'dnf install -y mesa-libGL libglvnd-egl glib2 krb5-libs libwayland-cursor libwayland-egl' },
  ['archlinux'] = { 'archlinux:latest', 'pacman -Sy --noconfirm --needed libglvnd glib2 krb5 wayland' },
  ['opensuse-tumbleweed'] = { 'opensuse/tumbleweed', 'zypper --non-interactive install Mesa-libGL1 Mesa-libEGL1 libglib-2_0-0 krb5 libwayland-cursor0 libwayland-egl1' },
  ['voidlinux'] = { 'ghcr.io/void-linux/void-glibc-full:latest', 'xbps-install -Sy libglvnd glib mit-krb5-libs wayland' },
}

local function imageDockerfile(tag: string): string
  local image = DistroImages[tag]
  if not image then error('unknown smoke distro: ' .. tag) end
  return `FROM {image[1]}\nRUN {image[2]}\n`
end

-- Check the actual dynamic-linker closure *inside* each smoke distro before
-- attempting to start applications. Include Qt's dlopen-loaded plugins, not
-- only the DT_NEEDED chain of executable entry points. ldd must run in the
-- target image so that its system library set, not the builder's, is tested.
-- Batches bound argument length and prevent one enormous captured output.
local ClosureBatchSize = 64

local function closureEntries(stage: string): { string }
  local found, problem = fs.walk(stage, { include = 'files', sort = true })
  if not found then error(problem or 'cannot enumerate packaged ELF files') end
  local entries: { string } = {}
  for _, relative in found.paths do
    if abi.isElf(stage .. '/' .. relative) then
      table.insert(entries, '/pkg/' .. relative)
    end
  end

  if #entries == 0 then error('runtime dependency audit found no ELF files') end
  return entries
end

-- ldd often exits successfully even when a DT_NEEDED library is absent.
-- Always inspect the text. Headers tie each unresolved dependency back to the
-- file that requires it; do not mistake a 'statically linked' ELF for failure.
local function closureProblems(stdout: string, stderr: string, code: number?): { string }
  local problems: { string } = {}
  local current = '(unknown ELF)'
  local seen: { [string]: boolean } = {}
  for line in (stdout .. '\n' .. stderr):gmatch('[^\r\n]+') do
    local header = line:match('^(/pkg/[^:]+):%s*$')
    if header then current = header end
    local lower = line:lower()
    if lower:find('not found', 1, true)
      or lower:find('cannot open shared object', 1, true)
      or lower:find('no such file or directory', 1, true)
      or lower:find('symbol lookup error', 1, true)
      or lower:find('undefined symbol', 1, true)
      or lower:find('inconsistency detected', 1, true) then
      local message = current .. ': ' .. line:gsub('^%s+', '')
      if not seen[message] then
        seen[message] = true
        table.insert(problems, message)
      end
    end
  end

  if code ~= 0 and #problems == 0 then
    local details = (stderr ~= '' and stderr or stdout):sub(1, 500)
    table.insert(problems, `ldd failed (exit {tostring(code)}): {details}`)
  end
  return problems
end

-- ldd repeats the same missing SONAME for every consumer. Group by distro
-- and SONAME while preserving one affected ELF for diagnosis. Non-library
-- failures (such as GLIBC symbol-version errors) remain verbatim.
local function summarizeClosureFailures(missing: { string }): { string }
  local groups: { [string]: { count: number, example: string } } = {}
  local order: { string }, unusual: { string } = {}, {}
  local seenOther: { [string]: boolean } = {}
  for _, diagnostic in missing do
    local distro, path, soname = diagnostic:match('^([^:]+): (/pkg/[^:]+): ([^%s]+) => not found')
    if distro and path and soname then
      local key = distro .. ': ' .. soname
      if not groups[key] then
        groups[key] = { count = 0, example = path }
        table.insert(order, key)
      end
      groups[key].count += 1
    elseif not seenOther[diagnostic] then
      seenOther[diagnostic] = true
      table.insert(unusual, diagnostic)
    end
  end

  table.sort(order)
  local output: { string } = {}
  for _, key in order do
    local group = groups[key]
    table.insert(output, `{key} => not found ({group.count} affected ELF reports; example {group.example})`)
  end

  for _, diagnostic in unusual do table.insert(output, diagnostic) end
  return output
end

local function closureCommand(imageTag: string, volume: string,
  entries: { string }, from: number, last: number): { string }
  local command = {
    'run', '--rm', '--network', 'none', '-v', volume, '-w', '/pkg',
    '-e', 'LD_LIBRARY_PATH=/pkg/lib', '-e', 'QT_PLUGIN_PATH=/pkg/plugins',
    imageTag, 'timeout', '--signal=TERM', '--kill-after=2s', '120s', 'ldd',
  }

  for index = from, last do table.insert(command, entries[index]) end
  return command
end

local function auditDistroClosure(engine: string, imageTag: string, volume: string,
  tag: string, entries: { string }, testEnvironment: { [string]: string }?): { string }
  local problems: { string } = {}
  for first = 1, #entries, ClosureBatchSize do
    local last = math.min(first + ClosureBatchSize - 1, #entries)
    local result, failure = process.run(engine,
      closureCommand(imageTag, volume, entries, first, last),
      { stdout = 'capture', stderr = 'capture', env = testEnvironment })
    if not result then
      table.insert(problems, `could not start closure audit: {failure or 'unknown'}`)
    else
      for _, problem in closureProblems(result.stdout or '', result.stderr or '', result.code) do
        table.insert(problems, problem)
      end

      if not result.success and result.code == nil then
        table.insert(problems, `dependency audit terminated unexpectedly: {result.stderr or ''}`)
      end
    end
  end

  if #problems == 0 then print(`PASS {tag}: dependency closure ({#entries} packaged ELF files)`) end
  return problems
end

-- Detached containers let Forge poll GUI startup without blocking in
-- @dream/process.run. A stopped container remains inspectable until cleanup.
-- No shell, no background subshell, no orphaned GUI after a normal smoke run.
local function runDistroCommand(engine: string, imageTag: string, volume: string,
  tag: string, tool: string, entry: string, maxRoundsOverride: number?,
  testEnvironment: { [string]: string }?)
  local label = tag .. '/' .. entry
  local invocation = {
    'run', '--detach', '--network', 'none', '-v', volume, '-w', '/pkg',
    '-e', 'LD_LIBRARY_PATH=/pkg/lib', '-e', 'QT_PLUGIN_PATH=/pkg/plugins',
    '-e', 'QT_QPA_PLATFORM=offscreen', imageTag, '/pkg/' .. entry,
  }

  for _, argument in smokeInvocationArgs(tool) do table.insert(invocation, argument) end
  local start, why = process.run(engine, invocation,
    { stdout = 'capture', stderr = 'capture', env = testEnvironment })

  if not start or not start.success then
    error(`{label} failed to start container: {why or ''} {if start then start.stderr or '' else ''}`)
  end
  local cid = (start.stdout or ''):match('^%s*([a-f0-9]+)%s*$')
  if not cid then error(`{label} returned invalid container ID: {start.stdout or ''}`) end

  local running = false
  local exitCode: number? = nil
  local inspectFailure: string? = nil
  local maxRounds = maxRoundsOverride or (if GuiTools[tool] then 20 else 120)
  for round = 1, maxRounds do
    local state, failure = process.run(engine, { 'inspect', '--format',
      '{{.State.Running}}:{{.State.ExitCode}}:{{.State.OOMKilled}}', cid },
      { stdout = 'capture', stderr = 'capture', env = testEnvironment })

    if not state or not state.success then
      inspectFailure = `inspect {label}: {failure or ''} {if state then state.stderr or '' else ''}`
      break
    end
    local isRunning, code, oom = (state.stdout or ''):match('^(%a+):(%d+):(%a+)%s*$')
    if not isRunning or not code or not oom then
      inspectFailure = `malformed container status for {label}: {state.stdout or ''}`
      break
    end
    running = isRunning == 'true'
    exitCode = tonumber(code)
    if oom == 'true' then
      inspectFailure = `smoke {label} was killed by out-of-memory`
      break
    end

    if not running then break end
    if round < maxRounds then process.sleep(0.25) end
  end

  local logs, logFailure = process.run(engine, { 'logs', cid }, {
    stdout = 'capture', stderr = 'capture', env = testEnvironment,
  })

  -- Observe the state once more before stopping; a late crash is not liveness.
  if running and not inspectFailure then
    local state = process.run(engine, { 'inspect', '--format',
      '{{.State.Running}}:{{.State.ExitCode}}:{{.State.OOMKilled}}', cid },
      { stdout = 'capture', stderr = 'capture', env = testEnvironment })

    if not state or not state.success then
      inspectFailure = `could not verify final container status for {label}`
    else
      local isRunning, code, oom = (state.stdout or ''):match('^(%a+):(%d+):(%a+)%s*$')
      if not isRunning or not code or not oom then
        inspectFailure = `malformed final container status for {label}`
      else
        running = isRunning == 'true'
        exitCode = tonumber(code)
        if oom == 'true' then inspectFailure = `smoke {label} was killed by out-of-memory` end
      end
    end
  end

  local removed, removeFailure = process.run(engine, { 'rm', '-f', '-v', cid }, {
    stdout = 'null', stderr = 'capture', env = testEnvironment,
  })

  if not removed or not removed.success then
    error(`failed to remove smoke container {cid} for {label}: {removeFailure or ''} {if removed then removed.stderr or '' else ''}`)
  end

  if inspectFailure then error(inspectFailure) end

  if not logs or not logs.success then
    error(`could not read {label} container logs: {logFailure or ''}`)
  end
  local timedOut = running
  local valid, reason = validateBoundedResult(tool, label, exitCode, timedOut,
    logs.stdout, logs.stderr)
  if not valid then error(reason or `smoke {label} failed`) end
end

local function multiSmoke(options: Options, staging: string)
  local selected: { string } = {}
  for tag in options.distros:gmatch('[^,]+') do
    if not DistroImages[tag] then error('unknown smoke distro: ' .. tag) end
    table.insert(selected, tag)
  end

  if #selected == 0 then error('--distros needs at least one known distribution') end

  if not fs.isFile(staging .. '/openmw.x86_64') then error('required OpenMW executable is missing from package') end
  if not fs.isFile(staging .. '/openmw') then error('required OpenMW launcher is missing from package') end

  if options.withQt and not fs.isFile(staging .. '/openmw-launcher.x86_64') then
    error('required OpenMW Qt launcher is missing from package')
  end

  -- Build every chosen runtime image, then report the complete unresolved
  -- dependency set for all distros before starting any smoke executable.
  local volume = staging .. ':/pkg:ro' .. (if options.engine == 'podman' then ',z' else '')
  local entries = closureEntries(staging)
  for _, tag in selected do
    local buildDir = options.root .. '/work/forge-smoke-images/' .. tag
    util.mkdir(buildDir)
    util.write(buildDir .. '/Dockerfile', imageDockerfile(tag))
    local imageTag = 'openmw-forge-smoke:' .. tag
    util.stream(options.engine, { 'build', '-t', imageTag, '-f', buildDir .. '/Dockerfile', buildDir })
  end

  local missing: { string } = {}
  for _, tag in selected do
    local imageTag = 'openmw-forge-smoke:' .. tag
    local problems = auditDistroClosure(options.engine, imageTag, volume, tag, entries)
    for _, problem in problems do table.insert(missing, tag .. ': ' .. problem) end
  end

  if #missing > 0 then
    local summary = summarizeClosureFailures(missing)
    error(`runtime dependency closure failed ({#missing} raw diagnostics, {#summary} grouped diagnostics):\n`
      .. table.concat(summary, '\n'))
  end

  for _, tag in selected do
    local imageTag = 'openmw-forge-smoke:' .. tag
    local count = 0
    local names = {
      'openmw', 'openmw-iniimporter', 'openmw-essimporter', 'openmw-navmeshtool',
      'openmw-bulletobjecttool', 'bsatool', 'esmtool', 'niftest',
    }

    if options.withQt then
      for _, name in { 'openmw-launcher', 'openmw-cs', 'openmw-wizard' } do
        table.insert(names, name)
      end
    end

    for _, name in names do
      if not fs.isFile(staging .. '/' .. name .. '.x86_64') then continue end
      if not fs.isFile(staging .. '/' .. name) then error('missing installed launcher: ' .. name) end
      count += 1
      -- Run both entry points; a distro-specific wrapper failure is a release failure.
      for _, entry in { name .. '.x86_64', name } do
        runDistroCommand(options.engine, imageTag, volume, tag, name, entry)
      end
      print(`PASS {tag}: binary + launcher {name}`)
    end

    if count == 0 then error('no binaries available for distro smoke tests') end
  end
end

local function smokeUnlocked(options: Options)
  archive.listTar(options.archive)
  local root = options.root .. '/work/forge-smoke'
  util.resetManaged(root)
  util.stream('tar', { 'xzf', options.archive, '-C', root })
  -- Inspect every link after extraction; never follow a link outside this root.
  local walk, problem = fs.walk(root, { include = 'all', sort = true })
  if not walk then error(problem or 'cannot inspect extracted archive') end

  for index, name in walk.paths do
    if walk.kinds[index] ~= 'symlink' then continue end

    local target = root .. '/' .. name
      local resolved = fs.canonicalize(target)
      if not resolved or (resolved ~= root and resolved:sub(1, #root + 1) ~= root .. '/') then
        error('archive has escaping or dangling symbolic link: ' .. name)
      end
  end
  local first = archive.listTar(options.archive)[1]
  local top = first:match('^[^/]+') or ''
  if not archive.isSafeName(top) then error('unsafe archive root') end
  local staging = root .. '/' .. top
  if not fs.isDir(staging) then error('archive does not have a single package root') end
  abi.scanAbi(staging)
  if options.distros == '' then smokeBinaries(staging, options.withQt)
  else multiSmoke(options, staging) end
  print('PASS tarball smoke ' .. options.archive)
end


-- Both archive extraction and generated smoke-image Dockerfiles are shared
-- under one Forge root. A second smoke run must not replace either while the
-- first run is inspecting or executing its extracted package.
local function smoke(options: Options)
  util.mkdir(options.root .. '/work')
  local lock, failure = fs.lock(options.root .. '/work/.forge-smoke.lock')
  if not lock then error('smoke workspace already in use: ' .. (failure or 'lock unavailable')) end

  -- Keep the kernel lock until all archive and distro subprocesses have exited.
  local ok, problem = pcall(smokeUnlocked, options)
  lock:unlock()
  if not ok then error(tostring(problem)) end
end

return table.freeze {
  smoke = smoke, smokeBinaries = smokeBinaries, validateHelpResult = validateHelpResult,
  validateBoundedResult = validateBoundedResult, imageDockerfile = imageDockerfile,
  runDistroCommand = runDistroCommand, smokeInvocationArgs = smokeInvocationArgs,
  closureEntries = closureEntries, closureProblems = closureProblems,
  closureCommand = closureCommand, auditDistroClosure = auditDistroClosure,
  summarizeClosureFailures = summarizeClosureFailures,
}
