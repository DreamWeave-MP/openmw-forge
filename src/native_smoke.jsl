--!strict
-- Validate actual executable invocations, not just archive contents.
local fs = require '@dream/fs'
local process = require '@dream/process'
local util = require '@forge/native-util'
local archive = require '@forge/native-archive'
local abi = require '@forge/native-abi'
local args = require '@forge/args'

type Options = args.Options

-- These OpenMW tools intentionally return 1 after printing --help. A nonzero
-- exit is acceptable only when the tool emits its own unmistakable help text;
-- accepting every exit 1 would hide missing libraries and broken launchers.
local HelpExitOne: { [string]: string } = {
  bsatool = 'Inspect and extract files from Bethesda BSA archives',
  esmtool = 'Inspect and extract from Morrowind ES files',
  niftest = 'Ensure that OpenMW can use the provided NIF',
}

local function validateHelpResult(tool: string, label: string, success: boolean,
  code: number?, signal: number?, stdout: string?, stderr: string?): (boolean, string?)
  local out = stdout or ''
  local err = stderr or ''
  local combined = out .. err
  for _, problem in {
    'error while loading shared libraries', 'symbol lookup error',
    'undefined symbol', 'cannot open shared object',
  } do
    if combined:find(problem, 1, true) then
      return false, `smoke failure in {label}: {combined}`
    end
  end

  local banner = HelpExitOne[tool]
  if banner and out:find(banner, 1, true) ~= nil and err == ''
    and (success or code == 1) then
    return true, nil
  end

  if not success then
    return false, `smoke {label} exited with {tostring(code or signal)}: stdout: {out} stderr: {err}`
  end

  if banner then
    return false, `smoke {label} did not print expected help: stdout: {out} stderr: {err}`
  end
  return true, nil
end

-- Exercise the installed POSIX launchers as users actually invoke them.
-- Testing only .x86_64 binaries misses broken wrappers, paths and library setup.
local function runPackageCommand(stage: string, tool: string, name: string, program: string,
  env: { [string]: string })
  local result, failure = process.run(program, { '--help' }, {
    cwd = stage, env = env, stdout = 'capture', stderr = 'capture',
  })

  if not result then error(`smoke could not run {name}: {failure or ''}`) end
  local valid, reason = validateHelpResult(tool, name, result.success,
    result.code, result.signal, result.stdout, result.stderr)
  if not valid then error(reason or `smoke failed: {name}`) end
end

local function smokeBinaries(stage: string, withQt: boolean?)
  local names = {
    'openmw', 'openmw-iniimporter', 'openmw-essimporter', 'openmw-navmeshtool',
    'openmw-bulletobjecttool', 'bsatool', 'esmtool', 'niftest',
  }

  if withQt then
    for _, name in { 'openmw-launcher', 'openmw-cs', 'openmw-wizard' } do
      table.insert(names, name)
    end
  end

  if not fs.isFile(stage .. '/openmw.x86_64') then error('required OpenMW executable is missing from package') end
  if not fs.isFile(stage .. '/openmw') then error('required OpenMW launcher is missing from package') end

  if withQt and not fs.isFile(stage .. '/openmw-launcher.x86_64') then
    error('required OpenMW Qt launcher is missing from package')
  end

  local ran = 0
  for _, name in names do
    local binary = stage .. '/' .. name .. '.x86_64'
    if not fs.isFile(binary) then continue end
    local wrapper = stage .. '/' .. name
    if not fs.isFile(wrapper) then error('missing installed launcher: ' .. name) end
    local env = { LD_LIBRARY_PATH = stage .. '/lib', QT_PLUGIN_PATH = stage .. '/plugins' }
    runPackageCommand(stage, name, name .. '.x86_64', binary, env)
    runPackageCommand(stage, name, name .. ' launcher', wrapper, env)
    ran += 1
    print('PASS smoke binary + launcher ' .. name)
  end

  if ran == 0 then error('no smoke binaries were executed') end
end

-- Qt GUI tools require GL and EGL at runtime. mesa-libGL alone does not
-- install the EGL dispatch library on AlmaLinux or Fedora.
local DistroImages: { [string]: { string } } = {
  ['almalinux-9'] = { 'almalinux:9', 'dnf install -y mesa-libGL libglvnd-egl' },
  ['debian-12'] = { 'debian:12', 'apt-get update && apt-get install -y libgl1 libegl1' },
  ['debian-13'] = { 'debian:trixie', 'apt-get update && apt-get install -y libgl1 libegl1' },
  ['ubuntu-22.04'] = { 'ubuntu:22.04', 'apt-get update && apt-get install -y libgl1 libegl1' },
  ['ubuntu-24.04'] = { 'ubuntu:24.04', 'apt-get update && apt-get install -y libgl1 libegl1' },
  ['fedora-latest'] = { 'fedora:latest', 'dnf install -y mesa-libGL libglvnd-egl' },
  ['archlinux'] = { 'archlinux:latest', 'pacman -Sy --noconfirm --needed libglvnd' },
  ['opensuse-tumbleweed'] = { 'opensuse/tumbleweed', 'zypper --non-interactive install Mesa-libGL1 Mesa-libEGL1' },
  ['voidlinux'] = { 'ghcr.io/void-linux/void-glibc-full:latest', 'xbps-install -Sy libglvnd' },
}

local function imageDockerfile(tag: string): string
  local image = DistroImages[tag]
  if not image then error('unknown smoke distro: ' .. tag) end
  return `FROM {image[1]}\nRUN {image[2]}\n`
end

local function multiSmoke(options: Options, staging: string)
  local selected: { string } = {}
  for tag in options.distros:gmatch('[^,]+') do
    if not DistroImages[tag] then error('unknown smoke distro: ' .. tag) end
    table.insert(selected, tag)
  end

  if #selected == 0 then error('--distros needs at least one known distribution') end

  if not fs.isFile(staging .. '/openmw.x86_64') then error('required OpenMW executable is missing from package') end
  if not fs.isFile(staging .. '/openmw') then error('required OpenMW launcher is missing from package') end

  if options.withQt and not fs.isFile(staging .. '/openmw-launcher.x86_64') then
    error('required OpenMW Qt launcher is missing from package')
  end

  for _, tag in selected do
    local buildDir = options.root .. '/work/forge-smoke-images/' .. tag
    util.mkdir(buildDir)
    util.write(buildDir .. '/Dockerfile', imageDockerfile(tag))
    local imageTag = 'openmw-forge-smoke:' .. tag
    util.stream(options.engine, { 'build', '-t', imageTag, '-f', buildDir .. '/Dockerfile', buildDir })
    local count = 0
    local names = {
      'openmw', 'openmw-iniimporter', 'openmw-essimporter', 'openmw-navmeshtool',
      'openmw-bulletobjecttool', 'bsatool', 'esmtool', 'niftest',
    }

    if options.withQt then
      for _, name in { 'openmw-launcher', 'openmw-cs', 'openmw-wizard' } do
        table.insert(names, name)
      end
    end

    for _, name in names do
      if not fs.isFile(staging .. '/' .. name .. '.x86_64') then continue end
      if not fs.isFile(staging .. '/' .. name) then error('missing installed launcher: ' .. name) end
      count += 1
      local volume = staging .. ':/pkg:ro' .. (if options.engine == 'podman' then ',z' else '')
      -- Run both entry points; a distro-specific wrapper failure is a release failure.
      for _, entry in { name .. '.x86_64', name } do
        local result, failure = process.run(options.engine, {
          'run', '--rm', '--network', 'none', '-v', volume, '-w', '/pkg',
          '-e', 'LD_LIBRARY_PATH=/pkg/lib', '-e', 'QT_PLUGIN_PATH=/pkg/plugins',
          '-e', 'QT_QPA_PLATFORM=offscreen', imageTag, '/pkg/' .. entry, '--help',
        }, { stdout = 'capture', stderr = 'capture' })

        if not result then error(`{tag}/{entry} failed to execute: {failure or ''}`) end
        local valid, reason = validateHelpResult(name, tag .. '/' .. entry, result.success,
          result.code, result.signal, result.stdout, result.stderr)
        if not valid then error(reason or `{tag}/{entry} failed smoke`) end
      end
      print(`PASS {tag}: binary + launcher {name}`)
    end

    if count == 0 then error('no binaries available for distro smoke tests') end
  end
end

local function smokeUnlocked(options: Options)
  archive.listTar(options.archive)
  local root = options.root .. '/work/forge-smoke'
  util.resetManaged(root)
  util.stream('tar', { 'xzf', options.archive, '-C', root })
  -- Inspect every link after extraction; never follow a link outside this root.
  local walk, problem = fs.walk(root, { include = 'all', sort = true })
  if not walk then error(problem or 'cannot inspect extracted archive') end

  for index, name in walk.paths do
    if walk.kinds[index] ~= 'symlink' then continue end

    local target = root .. '/' .. name
      local resolved = fs.canonicalize(target)
      if not resolved or (resolved ~= root and resolved:sub(1, #root + 1) ~= root .. '/') then
        error('archive has escaping or dangling symbolic link: ' .. name)
      end
  end
  local first = archive.listTar(options.archive)[1]
  local top = first:match('^[^/]+') or ''
  if not archive.isSafeName(top) then error('unsafe archive root') end
  local staging = root .. '/' .. top
  if not fs.isDir(staging) then error('archive does not have a single package root') end
  abi.scanAbi(staging)
  if options.distros == '' then smokeBinaries(staging, options.withQt)
  else multiSmoke(options, staging) end
  print('PASS tarball smoke ' .. options.archive)
end


-- Both archive extraction and generated smoke-image Dockerfiles are shared
-- under one Forge root. A second smoke run must not replace either while the
-- first run is inspecting or executing its extracted package.
local function smoke(options: Options)
  util.mkdir(options.root .. '/work')
  local lock, failure = fs.lock(options.root .. '/work/.forge-smoke.lock')
  if not lock then error('smoke workspace already in use: ' .. (failure or 'lock unavailable')) end

  -- Keep the kernel lock until all archive and distro subprocesses have exited.
  local ok, problem = pcall(smokeUnlocked, options)
  lock:unlock()
  if not ok then error(tostring(problem)) end
end

return table.freeze {
  smoke = smoke, smokeBinaries = smokeBinaries, validateHelpResult = validateHelpResult,
  imageDockerfile = imageDockerfile,
}
