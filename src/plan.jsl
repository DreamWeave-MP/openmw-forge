--!strict
local argsModule = require '@forge/args'
local sourceModule = require '@forge/source'

type Options = argsModule.Options
export type Step = { name: string, program: string, args: { string }, cwd: string, env: { [string]: string } }
export type Plan = { steps: { Step }, directories: { string }, requiredFiles: { string } }

local function normalize(path: string): string?
  if string.sub(path, 1, 1) ~= '/' then
    return nil
  end
  local components: { string } = {}
  for piece in string.gmatch(path, '[^/]+') do
    if piece == '..' then
      if #components == 0 then
        return nil
      end
      table.remove(components)
    elseif piece ~= '.' then
      table.insert(components, piece)
    end
  end
  return '/' .. table.concat(components, '/')
end

local function under(path: string, parent: string): boolean
  return path == parent or string.sub(path, 1, #parent + 1) == parent .. '/'
end

local function step(plan: Plan, name: string, program: string, argv: { string }, cwd: string, env: { [string]: string }?)
  local environment: { [string]: string } = if not env then {} else env
  local item: Step = { name = name, program = program, args = argv, cwd = cwd, env = environment }
  table.insert(plan.steps, item)
end

local function addOption(argv: { string }, flag: string, value: string)
  table.insert(argv, flag)
  table.insert(argv, value)
end

local function flags(options: Options, inner: boolean): { string }
  local output = {
    '--source', if inner then '/src' else options.source,
    '--build-dir', if inner then '/build' else options.build,
    '--deps-prefix', if inner then '/deps' else options.deps,
    '--output-dir', if inner then '/out' else options.output,
    '--triplet', options.triplet, '--qt-version', options.qtVersion,
    '--build-type', options.buildType, '--jobs', tostring(options.jobs),
  }

  for _, toggle in {
    { options.clean, '--clean' }, { options.portable, '--portable' },
    { options.stageOnly, '--stage-only' }, { options.runTests, '--run-tests' },
    { options.noQt, '--no-qt' }, { options.noSystemPackages, '--no-system-packages' },
    { options.noCcache, '--no-ccache' }, { options.noPrepare, '--no-prepare' },
    { options.noCompat, '--no-compat' }, { options.noSmoke, '--no-smoke' },
  } do
    if toggle[1] then table.insert(output, toggle[2] :: string) end
  end

  if options.runTests then addOption(output, '--gtest-filter', options.gtestFilter) end
  if options.depsSha256 ~= '' then addOption(output, '--deps-sha256', options.depsSha256) end
  for _, arg in options.cmakeArgs do addOption(output, '--cmake-arg', arg) end
  return output
end

local function containerVolume(options: Options, host: string, guest: string, readonly: boolean): string
  local suffix = if readonly then ':ro' else ''
  if options.engine == 'podman' then suffix ..= if readonly then ',z' else ':Z' end
  return host .. ':' .. guest .. suffix
end

local function depsSteps(plan: Plan, options: Options)
  table.insert(plan.directories, options.depsOutput)
  if options.mode == 'container' then
    local command = {
      'run', '--rm', '-v', containerVolume(options, options.depsOutput, '/depout', false),
      'openmw-forge:alma9', '/usr/local/bin/openmw-forge', '__deps',
      '--deps-output', '/depout', '--triplet', options.triplet, '--jobs', tostring(options.jobs),
    }

    if options.noSystemPackages then table.insert(command, '--no-system-packages') end
    if options.clean then table.insert(command, '--clean') end
    step(plan, 'build dependencies with Jess', options.engine, command, options.root)
  else
    step(plan, 'build dependencies with Jess', '@forge', { 'deps' }, options.root)
  end
end

local function buildSteps(plan: Plan, options: Options, packageOnly: boolean)
  table.insert(plan.directories, options.build)
  table.insert(plan.directories, options.deps)
  table.insert(plan.directories, options.output)
  table.insert(plan.requiredFiles, options.source .. '/CMakeLists.txt')
  if options.mode == 'container' then
    local exec = {
      'run', '--rm',
      '-v', containerVolume(options, options.source, '/src', true),
      '-v', containerVolume(options, options.build, '/build', false),
      '-v', containerVolume(options, options.deps, '/deps', false),
      '-v', containerVolume(options, options.output, '/out', false),
    }

    if options.archive ~= '' and not packageOnly and not options.noPrepare then
      if string.sub(options.archive, 1, 8) ~= 'https://' then
        if options.command == 'pipeline' then
          table.insert(exec, '-v')
          table.insert(exec, containerVolume(options, options.depsOutput, '/depout', true))
        else
          table.insert(exec, '-v')
          table.insert(exec, containerVolume(options, options.archive, if options.archive:match('%.tar%.xz$') then '/input/deps.tar.xz' else (if options.archive:match('%.tar%.xz$') then '/input/deps.tar.xz' else '/input/deps.7z'), true))
          table.insert(plan.requiredFiles, options.archive)
        end
      end
    end
    table.insert(exec, 'openmw-forge:alma9')
    table.insert(exec, '/usr/local/bin/openmw-forge')
    table.insert(exec, if packageOnly then '__package' else '__build')
    for _, value in flags(options, true) do table.insert(exec, value) end

    if not packageOnly and not options.noPrepare and options.archive ~= '' then
      local archive = options.archive
      if string.sub(archive, 1, 8) ~= 'https://' then
        archive = if options.command == 'pipeline' then '/depout/vcpkg-' .. options.triplet .. '.7z' else (if options.archive:match('%.tar%.xz$') then '/input/deps.tar.xz' else '/input/deps.7z')
      end
      addOption(exec, '--deps-archive', archive)
    end
    step(plan, if packageOnly then 'assemble OpenMW with Jess' else 'build and package OpenMW with Jess', options.engine, exec, options.root)
  else
    step(plan, if packageOnly then 'assemble OpenMW with Jess' else 'build and package OpenMW with Jess', '@forge', {
      if packageOnly then 'package' else 'build',
    }, options.root)
  end
end

local function build(options: Options): (Plan?, string?)
  if options.mode ~= 'container' and options.mode ~= 'local' then
    return nil, 'mode must be container or local; distrobox orchestration is no longer supported'
  end

  if options.engine ~= 'podman' and options.engine ~= 'docker' then
    return nil, 'engine must be podman or docker'
  end

  if not string.match(options.triplet, '^[%w%-]+$') then
    return nil, 'invalid triplet'
  end

  if options.buildType ~= 'Debug' and options.buildType ~= 'Release' and options.buildType ~= 'RelWithDebInfo' and options.buildType ~= 'MinSizeRel' and options.buildType ~= 'None' then
    return nil, 'invalid CMake build type'
  end

  if not string.match(options.qtVersion, '^%d+%.%d+%.%d+$') then
    return nil, 'invalid Qt version'
  end

  if options.noPrepare and options.command == 'pipeline' then
    return nil, '--no-prepare is incompatible with pipeline'
  end

  if options.runTests and options.command ~= 'build' and options.command ~= 'pipeline' then
    return nil, '--run-tests requires build or pipeline'
  end

  if options.noCompat or options.noSmoke then
    if options.command ~= 'package' and options.command ~= 'build' and options.command ~= 'pipeline' then
      return nil, '--no-compat/--no-smoke require build, pipeline, or package'
    end
  end

  if options.withQt and options.command ~= 'smoke' then
    return nil, '--with-qt is only valid for smoke'
  end

  if options.distros ~= '' and options.command ~= 'smoke' then
    return nil, '--distros is only valid for smoke'
  end

  if options.stageOnly and options.command ~= 'build' and options.command ~= 'pipeline' and options.command ~= 'package' then
    return nil, '--stage-only requires build, pipeline, or package'
  end
  local needsSource = options.command == 'build' or options.command == 'pipeline' or options.command == 'package'
  if options.repo ~= '' then
    if not needsSource then return nil, '--repo requires build, pipeline or package' end
    if options.source ~= '' then return nil, '--repo and --source cannot be combined' end
    if not sourceModule.validRepo(options.repo) then return nil, 'invalid --repo; use HTTPS or SSH URL' end
    if not sourceModule.validRef(options.ref) then return nil, 'invalid --ref' end
    options.source = sourceModule.path(options.root, options.repo)
  elseif options.ref ~= 'HEAD' then
    return nil, '--ref requires --repo; a local --source checkout is never modified'
  end

  if needsSource and options.source == '' then
    return nil, '--source or --repo is required for this command'
  end

  if options.command == 'smoke' and options.archive == '' then
    return nil, 'smoke requires --archive pointing to an OpenMW .tar.gz'
  end

  if options.command == 'smoke' and not string.match(options.archive, '%.tar%.gz$') then
    return nil, 'smoke requires a .tar.gz archive'
  end

  if options.command == 'pipeline' and options.depsSha256 ~= '' then
    return nil, 'pipeline creates the archive; --deps-sha256 is only for external dependencies'
  end

  if options.command == 'pipeline' and options.archive ~= '' then
    return nil, 'pipeline generates its own dependency archive; omit --archive'
  end

  local roots: { [string]: string } = {
    root = options.root,
    build = options.build,
    deps = options.deps,
    output = options.output,
    depsOutput = options.depsOutput,
  }

  if needsSource then
    roots.source = options.source
  end

  for key, raw in roots do
    local fixed = normalize(raw)
    if not fixed or fixed == '/' then
      return nil, `unsafe path for {key}: {raw}`
    end

    if key == 'root' then options.root = fixed
    elseif key == 'build' then options.build = fixed
    elseif key == 'deps' then options.deps = fixed
    elseif key == 'output' then options.output = fixed
    elseif key == 'depsOutput' then options.depsOutput = fixed
    elseif key == 'source' then options.source = fixed
    end
  end

  if needsSource then
    for _, dest in { options.build, options.deps, options.output, options.depsOutput } do
      if under(dest, options.source) or under(options.source, dest) then
        return nil, 'source and writable paths must be disjoint'
      end
    end
  end

  for firstIndex = 1, 4 do
    local targets = { options.build, options.deps, options.output, options.depsOutput }
    for secondIndex = firstIndex + 1, 4 do
      if under(targets[firstIndex], targets[secondIndex]) or under(targets[secondIndex], targets[firstIndex]) then
        return nil, 'writable roots must be disjoint'
      end
    end
  end

  if options.depsSha256 ~= '' and not options.depsSha256:match('^[0-9a-fA-F]+$') then
    return nil, '--deps-sha256 must be 64 hexadecimal digits'
  end

  if options.depsSha256 ~= '' and #options.depsSha256 ~= 64 then
    return nil, '--deps-sha256 must be 64 hexadecimal digits'
  end

  if options.archive ~= '' then
    if string.sub(options.archive, 1, 8) == 'https://' and options.depsSha256 == '' then
      return nil, 'HTTPS dependency archives require --deps-sha256'
    end

    if string.sub(options.archive, 1, 8) ~= 'https://' then
      if string.find(options.archive, '://', 1, true) then
        return nil, 'only https:// dependency URLs are allowed'
      end

      local fixed = normalize(options.archive)
      if not fixed or fixed == '/' then
        return nil, 'archive must be an absolute file path or HTTPS URL'
      end
      options.archive = fixed
    end
  elseif options.command == 'build' or options.command == 'pipeline' then
    options.archive = options.depsOutput .. '/vcpkg-' .. options.triplet .. '.7z'
  end
  local plan: Plan = { steps = {}, directories = {}, requiredFiles = {} }
  if options.repo ~= '' then
    step(plan, 'resolve remote OpenMW revision', '@forge', { 'source' }, options.root)
  end

  if options.mode == 'container' and (options.command == 'pipeline' or options.command == 'deps'
    or options.command == 'build' or options.command == 'package') then
    step(plan, 'build AlmaLinux 9 Jess image', options.engine, {
      'build', '-t', 'openmw-forge:alma9', '-f', options.root .. '/work/forge-assets/Dockerfile',
      options.root .. '/work/forge-assets',
    }, options.root)
  end

  if options.command == 'pipeline' or options.command == 'deps' then depsSteps(plan, options) end

  if options.command == 'pipeline' or options.command == 'build' or options.command == 'package' then
    buildSteps(plan, options, options.command == 'package')
  end

  if options.command == 'verify' then
    step(plan, 'verify dependencies in Jess', '@forge', { 'verify' }, options.root)
  end

  if options.command == 'smoke' then
    table.insert(plan.requiredFiles, options.archive)
    step(plan, 'smoke test package in Jess', '@forge', { 'smoke' }, options.root)
  end
  return plan, nil
end

local function quote(value: string): string
  if string.match(value, '^[%w%-%._/:=,+@]+$') then
    return value
  end
  return "'" .. string.gsub(value, "'", "'\\''") .. "'"
end

local function display(plan: Plan): string
  local lines = {}
  for index, item in plan.steps do
    table.insert(lines, `{index}. {item.name}`)
    local env: { string } = {}
    for key, value in item.env do
      table.insert(env, key .. '=' .. quote(value))
    end
    table.sort(env)
    local argv = { quote(item.program) }
    for _, part in item.args do
      table.insert(argv, quote(part))
    end
    table.insert(lines, '   cwd: ' .. quote(item.cwd))
    table.insert(lines, '   cmd: ' .. table.concat(env, ' ') .. (if #env > 0 then ' ' else '') .. table.concat(argv, ' '))
  end
  return table.concat(lines, '\n')
end

return table.freeze { build = build, display = display, normalize = normalize, under = under }
