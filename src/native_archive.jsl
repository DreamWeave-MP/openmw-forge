--!strict
-- Refuse unsafe archive members before invoking unpackers.
local util = require '@forge/native-util'
local fs = require '@dream/fs'

local function isSafeName(name: string): boolean
  if name == '' or name:sub(1, 1) == '/' or name:find('\\', 1, true)
    or name:match('^[%a]:') or name:find('%c')
    or name:find('//', 1, true) then return false end

  for component in name:gmatch('[^/]+') do
    if component == '..' or component == '.' then return false end
  end
  return true
end

local function listTar(archive: string): { string }
  local contents = util.checked('tar', { '-tf', archive })
  local paths: { string } = {}
  for line in contents:gmatch('[^\r\n]+') do
    if not isSafeName(line) then error('unsafe tar path: ' .. line) end
    table.insert(paths, line)
  end

  -- GNU tar's verbose listing exposes links before any extraction. Refuse links
  -- with absolute/parent targets instead of discovering an escape afterward.
  local verbose = util.checked('tar', { '-tvf', archive })
  local index = 0
  for line in verbose:gmatch('[^\r\n]+') do
    index += 1
    local kind = line:sub(1, 1)
    if kind == 'l' or kind == 'h' then
      local link = line:match(' %-%> (.+)$') or line:match(' link to (.+)$')
      if not link or not isSafeName(link) then
        error(`unsafe link entry {paths[index] or tostring(index)}`)
      end
    elseif kind ~= 'd' and kind ~= '-' then
      error(`unsupported tar entry type: {kind}`)
    end
  end

  if index ~= #paths then error('tar listing length mismatch') end
  if #paths == 0 then error('archive contains no files') end
  return paths
end

-- Conservative pre-extraction validation of 7z's structured listing.
-- Native .7z encodes a POSIX symlink's target in the file's data stream;
-- unlike tar, 7z l -slt usually does NOT include a "Symbolic Link" field.
-- Resolve those targets separately before allowing extraction, never by
-- assuming that an absent metadata field means the link is safe.
local function safeLinkTarget(path: string, target: string): boolean
  if target == '' or target:sub(1, 1) == '/' or target:find('\\', 1, true) then return false end
  if target:match('^[%a]:') or target:find('\0', 1, true) then return false end
  local components: { string } = {}
  for piece in path:gmatch('[^/]+') do table.insert(components, piece) end
  table.remove(components)
  for piece in target:gmatch('[^/]+') do
    if piece == '..' then
      if #components == 0 then return false end
      table.remove(components)
    elseif piece ~= '.' then
      table.insert(components, piece)
    end
  end
  return #components > 0
end

local function validate7zListing(listing: string, readTarget: ((string) -> string)?, deferTargets: boolean?)
  local separator = listing:find('%-%-%-%-%-%-%-%-%-')
  if not separator then error('7zip listing missing archive entries') end
  local payload = listing:sub(separator)
  local found = false
  local count = 0
  local entry: { [string]: string } = {}
  local seen: { [string]: boolean }, symlinks: { [string]: boolean } = {}, {}

  local function validate()
    local path = entry.Path
    if not path then return end
    count += 1
    if not isSafeName(path) or path:match('^[%a]:') or path:find('\0', 1, true) then
      error('unsafe dependency archive entry: ' .. path)
    end

    -- 7z may render directories with trailing slash. Normalize them here so
    -- a differently spelled member cannot overwrite an already created link.
    local canonicalPath = path:gsub('/+$', '')
    if seen[canonicalPath] then error('duplicate dependency archive entry: ' .. path) end
    seen[canonicalPath] = true

    if path:find('installed/', 1, true) then found = true end
    local attributesEntry: { [string]: string } = entry
    if attributesEntry['Hard Link'] or attributesEntry['Alternate Stream'] then
      error('unsupported dependency archive link or stream: ' .. path)
    end
    local link = attributesEntry['Symbolic Link'] or attributesEntry['Link'] or attributesEntry['Target']
    local attributes = attributesEntry['Attributes'] or ''
    local isSymlink = link ~= nil or attributes:match('^l') ~= nil or attributes:match('%sl') ~= nil
    if isSymlink then
      symlinks[canonicalPath] = true
      -- Native 7z stores POSIX symlink targets as compressed file data. Only
      -- a metadata preflight is safe to defer: the extracted link is checked
      -- against this exact entry before its tree is ever published or used.
      local rawSize = attributesEntry['Size']
      local size = if rawSize then tonumber(rawSize) else nil
      if (not link and not size) or (size and (size < 1 or size > 4095 or size % 1 ~= 0)) then
        error('uninspectable dependency symlink size: ' .. path)
      end

      if readTarget then
        local actual = readTarget(path)
        if size and #actual ~= size then error('invalid dependency symlink data: ' .. path) end

        if link and actual ~= link then
          error('dependency symlink target does not match archive listing: ' .. path)
        end
        link = actual
      elseif not link and not deferTargets then
        error('uninspectable dependency symlink: ' .. path)
      end

      if link and not safeLinkTarget(path, link) then
        error('unsafe dependency archive link: ' .. path)
      end
    end
  end

  for line in (payload .. '\n'):gmatch('[^\r\n]+') do
    local name, value = line:match('^([%a ]+) = (.*)$')
    if name == 'Path' then
      validate()
      entry = { Path = value }
    elseif name then
      entry[name] = value
    elseif line ~= '----------' then
      -- A path containing a newline must not silently truncate the listing;
      -- such a file can otherwise impersonate a second metadata field.
      error('malformed dependency archive listing line')
    end
  end
  validate()
  if count == 0 then error('dependency archive has no entries') end
  if not found then error('dependency archive lacks installed triplet tree') end

  -- Even an otherwise internal link may cause an extractor to write through
  -- it if another archive member names a child of that link. Ban that layout
  -- before extraction; vcpkg's versioned .so symlinks are leaf entries.
  for path in seen do
    local prefix = ''
    for segment in path:gmatch('[^/]+') do
      prefix = if prefix == '' then segment else prefix .. '/' .. segment
      if prefix ~= path and symlinks[prefix] then
        error('dependency archive writes beneath symbolic link: ' .. path)
      end
    end
  end
end

local function validateArchiveEntries(program: string, path: string, localLinkTarget: ((string) -> string)?)
  if not localLinkTarget then
    error('7z link validation requires a locally inspected tree; use preflightArchiveEntries before extraction')
  end
  validate7zListing(util.checked(program, { 'l', '-slt', path }), localLinkTarget)
end

-- One metadata-only scan before extracting into a NEW, isolated, managed
-- directory. This rejects path traversal, duplicates, symlink descendants,
-- special links, and structurally impossible symlinks. No symlink target is
-- trusted until validateArchiveEntries reads it from the extracted tree.
-- Crucially, this NEVER launches 7z once per compressed symlink.
local function preflightArchiveEntries(program: string, path: string)
  validate7zListing(util.checked(program, { 'l', '-slt', path }), nil, true)
end

local function validateExtractedLinks(root: string)
  local entries, failure = fs.walk(root, { include = 'all', sort = true })
  if not entries then error('failed to inspect extracted archive: ' .. (failure or '')) end
  local canonical = fs.canonicalize(root)
  if not canonical then error('cannot resolve extracted root') end

  for index, relative in entries.paths do
    if entries.kinds[index] ~= 'symlink' then continue end
    local link = root .. '/' .. relative
    local resolved = fs.canonicalize(link)
    if not resolved or (resolved ~= canonical and resolved:sub(1, #canonical + 1) ~= canonical .. '/') then
      error('escaping or dangling archive link: ' .. relative)
    end
  end
end

local function requireSafeArchive(archive: string)
  if string.match(archive, '%.tar%.xz$') then
    listTar(archive)
  else
    preflightArchiveEntries(util.tool { '7zz', '7z', '7za' }, archive)
  end
end


return table.freeze {
  isSafeName = isSafeName, listTar = listTar, requireSafeArchive = requireSafeArchive,
  validate7zListing = validate7zListing, validateArchiveEntries = validateArchiveEntries,
  preflightArchiveEntries = preflightArchiveEntries,
  validateExtractedLinks = validateExtractedLinks,
}
