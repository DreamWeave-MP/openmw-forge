--!strict
local fs = require '@dream/fs'
local util = require '@forge/native-util'
local embedded = require '@forge/native-assets'
local dependencies = require '@forge/native-deps'
local openmw = require '@forge/native-openmw'
local packaging = require '@forge/native-package'
local smoke = require '@forge/native-smoke'
local args = require '@forge/args'
local process = require '@dream/process'
local files = require '@forge/assets'
local source = require '@forge/source'

type Options = args.Options

-- The toolchain recipe is a vendored source asset shared by CLI and CI.
-- In hosted CI an already-published toolchain image replaces expensive DNF
-- provisioning; standalone builds retain the fully functional local fallback.
local RuntimeLayer = [[COPY forge /usr/local/bin/openmw-forge
COPY deps/ /forge/work/forge-assets/deps/
COPY openmw/ /forge/work/forge-assets/openmw/
WORKDIR /forge
]]

local function recipe(): string
  local base = process.env('FORGE_TOOLCHAIN_IMAGE')
  local pinnedBase = process.env('FORGE_TOOLCHAIN_BASE_IMAGE')
  if base and base ~= '' then
    -- A named digest can be supplied by CI after resolving a qualified GHCR
    -- image. Refuse metacharacters or additional Dockerfile instructions.
    if not base:match('^[%w%._/@:%-]+$') or base:find('..', 1, true) then
      error('invalid FORGE_TOOLCHAIN_IMAGE reference')
    end

    if pinnedBase and pinnedBase ~= '' then error('cannot set both a published toolchain and a fallback base image') end
    return 'FROM ' .. base .. '\n' .. RuntimeLayer
  end
  local toolchain = files['builder/Dockerfile']
  if not toolchain then error('embedded AlmaLinux 9 toolchain definition is missing') end

  if pinnedBase and pinnedBase ~= '' then
    if not pinnedBase:match('^[%w%._/@:%-]+$') or pinnedBase:find('..', 1, true) then
      error('invalid FORGE_TOOLCHAIN_BASE_IMAGE reference')
    end
    local replaced, count = toolchain:gsub('FROM almalinux/9%-base:9%.5%-20250519', 'FROM ' .. pinnedBase, 1)
    if count ~= 1 then error('pinned fallback base does not match the embedded builder recipe') end
    toolchain = replaced
  end

  return toolchain .. RuntimeLayer
end


local function bootstrap(options: Options)
  local dir = embedded.stage(options.root, options.mode == 'container')
  if options.mode == 'container' then
    local recipe = recipe()
    util.write(dir .. '/Dockerfile', recipe)
  end
end

local function run(action: string, options: Options)
  if action == 'source' then source.checkout(options)
  elseif action == 'deps' then dependencies.run(options)
  elseif action == 'build' then openmw.build(options)
  elseif action == 'package' then packaging.package(options)
  elseif action == 'verify' then dependencies.verify(options)
  elseif action == 'smoke' then smoke.smoke(options)
  else error('unknown native action: ' .. action)
  end
end

return table.freeze { bootstrap = bootstrap, run = run }
