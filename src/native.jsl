--!strict
local fs = require '@dream/fs'
local util = require '@forge/native-util'
local embedded = require '@forge/native-assets'
local dependencies = require '@forge/native-deps'
local openmw = require '@forge/native-openmw'
local packaging = require '@forge/native-package'
local smoke = require '@forge/native-smoke'
local args = require '@forge/args'
local config = require '@forge/config'
local source = require '@forge/source'

type Options = args.Options

local Dockerfile = [[
FROM almalinux:9
# Build tooling belongs to the image layer, not every short-lived worker.
RUN dnf install -y epel-release dnf-plugins-core
RUN dnf config-manager --set-enabled crb
RUN dnf install -y git tar gzip p7zip zip unzip curl gcc-toolset-13 cmake ninja-build ccache \
    perl autoconf autoconf-archive automake libtool nasm pkgconfig mesa-libGL-devel \
    mesa-libEGL-devel libXcursor-devel libX11-devel libXft-devel libXext-devel \
    libxkbcommon-devel libxkbcommon-x11 wayland-devel texinfo gettext-devel \
    kernel-headers python3 python3-pip make binutils patch libstdc++ \
    libxcb xcb-util xcb-util-image xcb-util-keysyms xcb-util-wm \
    xcb-util-renderutil xcb-util-cursor && dnf clean all
# vcpkg requires Autoconf 2.72. Build it ONCE in the cached image rather than
# recompiling it in each disposable dependency worker. Verify before extraction.
RUN curl --fail --location --retry 3 -o /tmp/autoconf-2.72.tar.gz \
      https://ftp.gnu.org/gnu/autoconf/autoconf-2.72.tar.gz \
    && echo '@AUTOCONF_SHA512@  /tmp/autoconf-2.72.tar.gz' | sha512sum --check - \
    && tar xzf /tmp/autoconf-2.72.tar.gz -C /tmp \
    && cd /tmp/autoconf-2.72 && ./configure --prefix=/usr/local \
    && make -j2 && make install \
    && rm -rf /tmp/autoconf-2.72 /tmp/autoconf-2.72.tar.gz
COPY forge /usr/local/bin/openmw-forge
COPY deps/ /forge/work/forge-assets/deps/
COPY openmw/ /forge/work/forge-assets/openmw/
WORKDIR /forge
]]

local function bootstrap(options: Options)
  local dir = embedded.stage(options.root, options.mode == 'container')
  if options.mode == 'container' then
    local recipe = Dockerfile:gsub('@AUTOCONF_SHA512@', config.autoconfSha512)
    util.write(dir .. '/Dockerfile', recipe)
  end
end

local function run(action: string, options: Options)
  if action == 'source' then source.checkout(options)
  elseif action == 'deps' then dependencies.run(options)
  elseif action == 'build' then openmw.build(options)
  elseif action == 'package' then packaging.package(options)
  elseif action == 'verify' then dependencies.verify(options)
  elseif action == 'smoke' then smoke.smoke(options)
  else error('unknown native action: ' .. action)
  end
end

return table.freeze { bootstrap = bootstrap, run = run }
