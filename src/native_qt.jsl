--!strict
-- Qt is a required OpenMW release input. Never accept an incomplete cached
-- installation just because its `lib/` directory exists.
local fs = require '@dream/fs'
local util = require '@forge/native-util'
local config = require '@forge/config'
local abi = require '@forge/native-abi'
local args = require '@forge/args'

type Options = args.Options

local function location(options: Options): string
  return options.deps .. '/QT/' .. options.qtVersion .. '/gcc_64'
end

local function identity(options: Options): string
  return 'qt=' .. options.qtVersion .. '\naqtinstall=' .. config.aqtVersion .. '\nplatform=linux-gcc_64\n'
end

-- This is OpenMW's actual Qt release contract, not simply a directory
-- presence check. The official Qt 6.6.3 desktop archive installs these
-- libraries and CMake targets through qtbase/declarative/svg/tools.
local Libraries = { 'Core', 'Gui', 'Widgets', 'Network', 'OpenGL', 'OpenGLWidgets', 'Svg', 'Qml', 'Quick' }
local CmakeTargets = { 'Core', 'Gui', 'Widgets', 'Network', 'OpenGL', 'OpenGLWidgets', 'Svg', 'Qml', 'Quick', 'LinguistTools' }

local function elf(path: string): boolean
  if not fs.isFile(path) then return false end
  return abi.isElf(path)
end

local function usable(path: string): boolean
  if not fs.isDir(path .. '/lib') or not fs.isDir(path .. '/lib/cmake') then return false end
  local plugin = path .. '/plugins/platforms/libqxcb.so'
  if not elf(plugin) then return false end
  local libs = fs.list(path .. '/lib')
  if not libs then return false end

  for _, name in Libraries do
    local found = false
    for _, file in libs do
      if file:match('^libQt6' .. name .. '%.so%.%d') and elf(path .. '/lib/' .. file) then
        found = true
        break
      end
    end

    if not found then return false end
  end

  for _, name in CmakeTargets do
    local cmake = path .. '/lib/cmake/Qt6' .. name .. '/Qt6' .. name .. 'Config.cmake'
    if not fs.isFile(cmake) then return false end
  end
  return fs.isFile(path .. '/lib/cmake/Qt6/Qt6Config.cmake')
end

local function qualified(options: Options): boolean
  local path = location(options)
  if not usable(path) then return false end

  if util.managed(path) then
    return fs.isFile(path .. '/.forge-qt-id') and util.file(path .. '/.forge-qt-id') == identity(options)
  end
  -- An explicitly supplied Qt tree is accepted for local use if the actual
  -- release-critical library and plugin files are present. It is never
  -- overwritten or treated as a Forge-owned cache.
  return true
end

local function requireInstallation(options: Options): string
  if not qualified(options) then
    error('missing or incomplete Qt SDK (ELF libraries, CMake modules and XCB plugin required): ' .. location(options))
  end
  return location(options)
end

local function prepare(options: Options)
  local final = location(options)
  util.recoverManagedDirectory(final)
  if qualified(options) then
    print('Reusing complete Qt installation: ' .. final)
    return
  end

  if fs.lstat(final) and not util.managed(final) then
    error('refusing to replace incomplete user-owned Qt installation: ' .. final)
  end

  local pending = options.deps .. '/qt-install-staging'
  util.resetManaged(pending)
  util.stream('python3', { '-m', 'pip', 'install', '--user', 'aqtinstall==' .. config.aqtVersion })
  util.stream('python3', {
    '-m', 'aqt', 'install-qt', 'linux', 'desktop', options.qtVersion, 'gcc_64',
    '--archives', 'qtbase', 'qtdeclarative', 'qtsvg', 'qttools', 'qtwayland', 'icu',
    '-O', pending,
  })
  local candidate = pending .. '/' .. options.qtVersion .. '/gcc_64'
  if not usable(candidate) then error('downloaded Qt installation lacks required libraries or platform plugins') end
  util.write(candidate .. '/.openmw-forge-managed', 'openmw-forge-managed-v1\n')
  util.write(candidate .. '/.forge-qt-id', identity(options))
  util.mkdir(options.deps .. '/QT/' .. options.qtVersion)
  util.publishManagedDirectory(candidate, final)
  util.remove(pending)
  print('Published qualified Qt installation: ' .. final)
end

return table.freeze {
  location = location, identity = identity, usable = usable,
  qualified = qualified, requireInstallation = requireInstallation, prepare = prepare,
}
