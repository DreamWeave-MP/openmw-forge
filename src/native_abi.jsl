--!strict
-- One AlmaLinux 9 ABI ceiling policy for vcpkg exports and OpenMW packages.
local fs = require '@dream/fs'
local process = require '@dream/process'

local Ceilings: { [string]: string } = {
  GLIBC = '2.34', GLIBCXX = '3.4.29', CXXABI = '1.3.13',
}

local function newer(left: string, right: string): boolean
  local leftParts: { number }, rightParts: { number } = {}, {}
  for part in left:gmatch('%d+') do table.insert(leftParts, tonumber(part) or 0) end
  for part in right:gmatch('%d+') do table.insert(rightParts, tonumber(part) or 0) end

  for index = 1, math.max(#leftParts, #rightParts) do
    if (leftParts[index] or 0) > (rightParts[index] or 0) then return true end
    if (leftParts[index] or 0) < (rightParts[index] or 0) then return false end
  end
  return false
end

local function scanAbi(root: string)
  local walkResult, failure = fs.walk(root, { include = 'files', sort = true })
  if not walkResult then error(failure or 'cannot walk ABI scan root') end

  local count = 0
  for _, name in walkResult.paths do
    local path = root .. '/' .. name
    local first = fs.readAt(path, 0, 4)
    if not first or buffer.readstring(first, 0, 4) ~= '\127ELF' then continue end

    count += 1
    local result = process.run('readelf', { '--version-info', path }, { stdout = 'capture', stderr = 'capture' })
    if not result or not result.success then error('readelf failed: ' .. path) end
    local info = result.stdout or ''
    for symbol, max in Ceilings do
      for version in info:gmatch(symbol .. '_([%d%.]+)') do
        if newer(version, max) then error(`ABI violation: {path} needs {symbol}_{version} (max {max})`) end
      end
    end
  end

  if count == 0 then error('ABI audit found no ELF files') end
  print(`PASS {count} ELF files meet AlmaLinux 9 ABI ceilings`)
end

return table.freeze { scanAbi = scanAbi, newer = newer }
