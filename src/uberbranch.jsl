--!strict
-- CI release orchestrator. Source/ref come from the selected release profile.
local fs = require '@dream/fs'
local process = require '@dream/process'
local json = require '@jess/json'
local util = require '@forge/native-util'
local source = require '@forge/source'
type Profile = {
  read id: string, read repository: string, read ref: string, read releaseTag: string,
  read releaseTitle: string, read jobs: number | string, read cmakeArgs: { string },
  read artifactNamespace: string, read distros: string,
  read features: { read vulkan: boolean, read luau: boolean, read luaUi: boolean },
  read testPolicy: { read googleTests: boolean, read packageSmoke: boolean, read qtSmoke: boolean },
}
local profiles = require '@forge/release-profiles' :: { [string]: Profile }

local function validate(settings: Profile): (boolean, string?)
  if not settings.id:match('^[a-z][a-z0-9%-]*$') then return false, 'invalid release profile id' end
  if not source.validRepo(settings.repository) then return false, 'invalid release profile repository' end
  if not source.validRef(settings.ref) then return false, 'invalid release profile ref' end
  if not source.validRef(settings.releaseTag) then return false, 'invalid release profile tag' end
  if settings.releaseTitle == '' or settings.releaseTitle:find('%c') then return false, 'invalid release profile title' end
  if not settings.artifactNamespace:match('^[a-z][a-z0-9%-]*$') then return false, 'invalid artifact namespace' end

  if settings.jobs ~= 'auto' then
    if type(settings.jobs) ~= 'number' or settings.jobs < 1 or settings.jobs > 1024 or settings.jobs % 1 ~= 0 then
      return false, 'profile jobs must be auto or an integer between 1 and 1024'
    end
  end

  local cmake: { [string]: string } = {}
  for _, arg in settings.cmakeArgs do
    local key, value = arg:match('^%-D([%w_]+)=(.*)$')
    if not key then return false, 'profile CMake arguments must use -DNAME=VALUE form' end
    if cmake[key] then return false, 'duplicate profile CMake option: ' .. key end
    cmake[key] = value
  end

  if settings.features.vulkan and cmake.OPENMW_USE_VULKAN ~= 'ON' then
    return false, 'profile requires Vulkan but OPENMW_USE_VULKAN is not ON'
  end

  if not settings.features.vulkan and cmake.OPENMW_USE_VULKAN == 'ON' then
    return false, 'profile disables Vulkan but OPENMW_USE_VULKAN is ON'
  end

  if settings.testPolicy.qtSmoke and not settings.testPolicy.packageSmoke then
    return false, 'profile Qt smoke policy requires package smoke'
  end

  return true, nil
end

local function validateProfiles(profileSet: { [string]: Profile }?): (boolean, string?)
  local tags: { [string]: string }, namespaces: { [string]: string } = {}, {}
  local selectedProfiles = profileSet or profiles
  local ids: { string } = {}
  for id in selectedProfiles do table.insert(ids, id) end
  table.sort(ids)

  for _, id in ids do
    local settings = selectedProfiles[id]
    local valid, reason = validate(settings)
    if not valid then return false, id .. ': ' .. (reason or 'invalid profile') end
    if tags[settings.releaseTag] then return false, 'release tag collision between ' .. tags[settings.releaseTag] .. ' and ' .. id end

    if namespaces[settings.artifactNamespace] then
      return false, 'artifact namespace collision between ' .. namespaces[settings.artifactNamespace] .. ' and ' .. id
    end
    tags[settings.releaseTag] = id
    namespaces[settings.artifactNamespace] = id
  end
  return true, nil
end

local function profile(id: string?): Profile
  local name = id or 'clockwork'
  local selected = (profiles :: { [string]: Profile })[name]
  if not selected then error('unknown release profile: ' .. name) end
  return selected
end

local function appendBuildSettings(command: { string }, settings: Profile, output: string)
  table.insert(command, '--engine')
  table.insert(command, 'docker')
  table.insert(command, '--jobs')
  table.insert(command, tostring(settings.jobs))
  for _, arg in settings.cmakeArgs do
    table.insert(command, '--cmake-arg')
    table.insert(command, arg)
  end

  if settings.testPolicy.googleTests then table.insert(command, '--run-tests') end

  local features = {
    { name = 'vulkan', enabled = settings.features.vulkan },
    { name = 'luau', enabled = settings.features.luau },
    { name = 'lua-ui', enabled = settings.features.luaUi },
  }

  for _, feature in features do
    if feature.enabled then
      table.insert(command, '--require-feature')
      table.insert(command, feature.name)
    end
  end
  table.insert(command, '--output-dir')
  table.insert(command, output)
end

local function buildArgs(settings: Profile, output: string): { string }
  local command = { 'pipeline', '--repo', settings.repository, '--ref', settings.ref }
  appendBuildSettings(command, settings, output)
  return command
end

local function depsArgs(settings: Profile): { string }
  return { 'deps', '--engine', 'docker', '--jobs', tostring(settings.jobs) }
end

local function buildOnlyArgs(settings: Profile, output: string, resolvedSha: string?): { string }
  local ref = resolvedSha or settings.ref
  local command = { 'build', '--repo', settings.repository, '--ref', ref }
  appendBuildSettings(command, settings, output)
  return command
end

local function smokeArgs(settings: Profile, archive: string): { string }?
  if not settings.testPolicy.packageSmoke then return nil end
  local command = { 'smoke', '--archive', archive, '--engine', 'docker', '--distros', settings.distros }
  if settings.testPolicy.qtSmoke then table.insert(command, '--with-qt') end

  if settings.features.vulkan then
    table.insert(command, '--require-feature')
    table.insert(command, 'vulkan')
  end
  return command
end

local function isMainTarball(name: string): boolean
  return name:match('^openmw%-.*%-Linux%-64Bit%.tar%.gz$') ~= nil
end

local function findOutputs(directory: string): (string, string)
  local main: string? = nil
  local debug: string? = nil
  for _, name in util.list(directory) do
    if isMainTarball(name) then
      if main then error('more than one OpenMW archive in scheduled output') end
      main = directory .. '/' .. name
    elseif name:match('^openmw%-.*%-Linux%-64Bit%-debug%.tar%.gz$') then
      if debug then error('more than one OpenMW debug archive in scheduled output') end
      debug = directory .. '/' .. name
    end
  end

  if not main or not debug then error('scheduled release requires exactly one main and one debug archive') end

  for _, path in { main, debug } do
    local stat = fs.stat(path)
    if not stat or stat.size == 0 then error('missing or empty release artifact: ' .. path) end
  end

  return main :: string, debug :: string
end

local function releaseIdentityMatches(settings: Profile, body: string): boolean
  return body:find('OpenMW repository: ' .. settings.repository, 1, true) ~= nil
    and body:find('OpenMW requested ref: ' .. settings.ref, 1, true) ~= nil
end

local function publish(settings: Profile, root: string, files: { string }, notes: string)
  local env = { GH_PROMPT_DISABLED = '1' }
  local tag = settings.releaseTag
  local view = process.run('gh', { 'release', 'view', tag }, { cwd = root, env = env, stdout = 'capture', stderr = 'capture' })
  if not view or not view.success then
    -- A network/authentication error must not be mistaken for permission to
    -- overwrite an existing release; create will fail safely if it exists.
    local target = process.env('GITHUB_SHA') or 'HEAD'
    util.stream('gh', { 'release', 'create', tag, '--target', target, '--title', settings.releaseTitle,
      '--prerelease', '--notes-file', notes }, root, env)
  end

  if view and view.success then
    local identity = process.run('gh', { 'release', 'view', tag, '--json', 'body' }, {
      cwd = root, env = env, stdout = 'capture', stderr = 'capture',
    })

    if not identity or not identity.success then error('cannot inspect existing release identity') end
    local release = json.decode(identity.stdout or '') :: { body: string? }
    if type(release) ~= 'table' or type(release.body) ~= 'string'
      or not releaseIdentityMatches(settings, release.body) then
      error('refusing to publish ' .. settings.id .. ' into ' .. tag
        .. ': release currently belongs to a different OpenMW source; delete the old release first')
    end
  end

  -- Invalidate an existing completion marker BEFORE changing any release
  -- assets. Otherwise a previous SHA256SUMS remains publicly visible while
  -- a new payload is partially uploaded; a failed upload can leave a release
  -- falsely appearing qualified. An incomplete release must fail closed.
  if view and view.success then
    local listed = process.run('gh', { 'release', 'view', tag, '--json', 'assets' }, {
      cwd = root, env = env, stdout = 'capture', stderr = 'capture',
    })

    if not listed or not listed.success then
      error('cannot inspect existing release assets before publication')
    end

    local release = json.decode(listed.stdout or '') :: { assets: { { name: string } } }
    if type(release) ~= 'table' or type(release.assets) ~= 'table' then
      error('existing release does not provide an asset inventory')
    end
    local markerCount = 0
    for _, asset in release.assets do
      if asset.name == 'SHA256SUMS' then markerCount += 1 end
    end

    if markerCount > 1 then error('existing release has duplicate checksum completion markers') end

    if markerCount == 1 then
      util.stream('gh', { 'release', 'delete-asset', tag, 'SHA256SUMS', '--yes' }, root, env)
    end
    -- Old Clockwork releases may still carry renderer proof from the retired
    -- gate. Remove this obsolete asset rather than leaving a false claim.
    local legacyProofCount = 0
    for _, asset in release.assets do
      if asset.name == 'VULKAN-QUALIFICATION.txt' then legacyProofCount += 1 end
    end

    if legacyProofCount > 1 then error('existing release has duplicate obsolete Vulkan evidence') end

    if legacyProofCount == 1 then
      util.stream('gh', { 'release', 'delete-asset', tag, 'VULKAN-QUALIFICATION.txt', '--yes' }, root, env)
    end
  end

  -- A rolling GitHub release cannot update several assets atomically. Upload
  -- content first, then publish the checksum manifest LAST as the completion
  -- marker. A reader must verify SHA256SUMS before accepting any artifact.
  local payload = { 'release', 'upload', tag }
  for _, path in files do
    if fs.fileName(path) ~= 'SHA256SUMS' then table.insert(payload, path) end
  end
  table.insert(payload, '--clobber')
  util.stream('gh', payload, root, env)

  local marker = files[#files]
  if fs.fileName(marker) ~= 'SHA256SUMS' then error('last release artifact must be SHA256SUMS') end
  util.stream('gh', { 'release', 'upload', tag, marker, '--clobber' }, root, env)
  util.stream('gh', { 'release', 'edit', tag, '--notes-file', notes, '--prerelease' }, root, env)

  -- Each upstream revision has a distinct filename. Keep this rolling release
  -- focused on the most recently qualified build, not a growing list of old
  -- archives. Prune only Forge-named tarballs, never unrelated release assets.
  local listed, failure = process.run('gh', {
    'release', 'view', tag, '--json', 'assets',
  }, { cwd = root, env = env, stdout = 'capture', stderr = 'capture' })

  if not listed or not listed.success then error('cannot list rolling release assets: ' .. (failure or 'unknown')) end
  local release = json.decode(listed.stdout or '') :: { assets: { { name: string } } }
  local current: { [string]: boolean } = {}
  for _, path in files do
    current[fs.fileName(path) or path] = true
  end

  for _, asset in release.assets do
    local name = asset.name
    if (isMainTarball(name) or name:match('^openmw%-.*%-Linux%-64Bit%-debug%.tar%.gz$'))
      and not current[name] then
      util.stream('gh', { 'release', 'delete-asset', tag, name, '--yes' }, root, env)
    end
  end
end

-- Verify artifacts received from the low-privilege build runner before
-- allowing the high-privilege publication job to touch a GitHub release.
local function verifyArtifacts(directory: string, settings: Profile): { string }
  local main, debug = findOutputs(directory)
  local notes = directory .. '/SOURCE.txt'
  local checksums = directory .. '/SHA256SUMS'
  local provenancePath = directory .. '/PROVENANCE.json'
  local content = util.file(notes)
  if not content:find('Profile: ' .. settings.id .. '\n', 1, true)
    or not content:find('GitHub release: ' .. settings.releaseTag .. '\n', 1, true)
    or not content:find('OpenMW repository: ' .. settings.repository .. '\n', 1, true)
    or not content:find('OpenMW requested ref: ' .. settings.ref .. '\n', 1, true) then
    error('release provenance does not match the checked-in source selection')
  end
  local revision = content:match('OpenMW resolved SHA: ([0-9a-f]+)\n')
  if not revision or #revision ~= 40 then error('release provenance missing full source SHA') end
  local fingerprint = process.env('FORGE_INPUT_FINGERPRINT') or ''
  local expectedSha = process.env('FORGE_RESOLVED_SOURCE_SHA') or ''
  local expectedInputs = process.env('FORGE_INPUTS_JSON') or ''
  local expectedProfile = process.env('FORGE_RELEASE_PROFILE') or settings.id
  if expectedProfile ~= settings.id then error('publish profile differs from selected release profile') end

  if #fingerprint ~= 64 or not fingerprint:match('^[0-9a-f]+$') or revision ~= expectedSha then
    error('published source SHA or full input fingerprint does not match preflight')
  end

  if not content:find('Build input fingerprint: ' .. fingerprint .. '\n', 1, true) then
    error('human-readable release provenance does not match the full input fingerprint')
  end

  if expectedInputs == '' then error('missing canonical preflight input JSON') end
  -- Malformed JSON raises from the decoder, which fails the publish closed.
  local provenanceDocument = json.decode(util.file(provenancePath)) :: {
    schema: string?, qualified: boolean?, input_fingerprint: string?, source_sha: string?,
    repository: string?, requested_ref: string?, profile: string?, release_tag: string?,
    inputs: unknown?,
  }
  -- Canonical encodings sort keys, so comparing them is the same as comparing the objects.
  local verified = provenanceDocument.schema == 'forge-qualified-release/v1'
    and provenanceDocument.qualified == true
    and provenanceDocument.input_fingerprint == fingerprint
    and provenanceDocument.source_sha == revision
    and provenanceDocument.repository == settings.repository
    and provenanceDocument.requested_ref == settings.ref
    and provenanceDocument.profile == expectedProfile
    and provenanceDocument.release_tag == settings.releaseTag
    and json.encodeTable(provenanceDocument.inputs) == json.encodeTable(json.decode(expectedInputs))

  if not verified then error('qualified release JSON does not match preflight identity') end

  local expectedDebug = main:gsub('%.tar%.gz$', '-debug.tar.gz')
  if not main:find('-g' .. revision:sub(1, 12) .. '-', 1, true) or debug ~= expectedDebug then
    error('release tarball filename does not match source provenance')
  end
  local allowed: { [string]: string } = {}
  for _, path in { main, debug, notes, provenancePath } do allowed[fs.fileName(path) or ''] = path end
  local expected: { [string]: boolean } = {}
  for line in util.file(checksums):gmatch('[^\r\n]+') do
    local hash, filename = line:match('^([0-9a-f]+)  ([^/\\]+)$')
    if not hash or #hash ~= 64 or not filename or not allowed[filename] or expected[filename] then
      error('invalid or duplicate release checksum entry: ' .. line)
    end
    local actual = util.sha256(allowed[filename])
    if actual ~= hash then error('release checksum mismatch: ' .. filename) end
    expected[filename] = true
  end

  for filename in allowed do
    if not expected[filename] then error('missing checksum for ' .. filename) end
  end
  local publishFiles = { main, debug, notes, provenancePath }
  table.insert(publishFiles, checksums)
  return publishFiles
end

local function publishArtifacts(directory: string, root: string, settings: Profile)
  local token = process.env('GH_TOKEN')
  if process.env('GITHUB_ACTIONS') ~= 'true' or not token or token == '' then
    error('publishing requires GitHub Actions and GH_TOKEN')
  end
  local publishFiles = verifyArtifacts(directory, settings)
  local notes = directory .. '/SOURCE.txt'
  publish(settings, root, publishFiles, notes)
end

local function run(argv: { string })
  local root, failure = fs.cwd()
  if not root then error(failure or 'cannot determine repository root') end
  if not fs.isFile(root .. '/jess.toml') then error('run from the OpenMW Forge repository root') end
  local selectedId: string? = process.env('FORGE_RELEASE_PROFILE')
  local profileOptionSeen = false
  local publishDirectory: string? = nil
  local verifyDirectory: string? = nil
  local scan = 1
  while scan <= #argv do
    if argv[scan] == '--release-profile' then
      if profileOptionSeen then error('--release-profile may be supplied only once') end
      profileOptionSeen = true
      scan += 1
      local requestedId = argv[scan]
      if not requestedId or requestedId == '' then error('--release-profile requires an id') end

      if selectedId and selectedId ~= requestedId then
        error('--release-profile conflicts with FORGE_RELEASE_PROFILE')
      end
      selectedId = requestedId
    elseif argv[scan] == '--publish-artifacts' then
      if publishDirectory then error('--publish-artifacts may be supplied only once') end
      scan += 1
      publishDirectory = argv[scan]
      if not publishDirectory or publishDirectory == '' then
        error('usage: --publish-artifacts /absolute/output/dir [--release-profile id]')
      end
    elseif argv[scan] == '--verify-artifacts' then
      if verifyDirectory then error('--verify-artifacts may be supplied only once') end
      scan += 1
      verifyDirectory = argv[scan]
      if not verifyDirectory or verifyDirectory == '' then
        error('usage: --verify-artifacts /absolute/candidate/dir [--release-profile id]')
      end
    end
    scan += 1
  end
  local settings = profile(selectedId)
  local profilesValid, profilesReason = validateProfiles()
  if not profilesValid then error(profilesReason or 'invalid release profiles') end

  if publishDirectory and verifyDirectory then error('publish and verify artifact modes are mutually exclusive') end

  if verifyDirectory then
    verifyArtifacts(verifyDirectory, settings)
    print('PASS candidate artifacts match current preflight identity and checksums')
    return
  end

  if publishDirectory then
    publishArtifacts(publishDirectory, root, settings)
    return
  end

  local dry = false
  local depsOnly = false
  local buildOnly = false
  local binary = process.env('FORGE_BIN') or (root .. '/build/openmw-forge-linux-x64')
  local index = 1
  while index <= #argv do
    local flag = argv[index]
    if flag == '--release-profile' then
      index += 2
      continue
    end

    if flag == '--dry-run' then dry = true
    elseif flag == '--prepare-deps' then depsOnly = true
    elseif flag == '--build-only' then buildOnly = true
    elseif flag == '--forge' then
      index += 1
      binary = argv[index] or ''
    else error('unknown scheduled option: ' .. flag) end
    index += 1
  end

  if binary == '' then error('--forge requires an executable path') end
  if depsOnly and buildOnly then error('--prepare-deps and --build-only are mutually exclusive') end

  local runId = process.env('GITHUB_RUN_ID') or 'local'
  local attempt = process.env('GITHUB_RUN_ATTEMPT') or '1'
  if not runId:match('^[%w%-]+$') or not attempt:match('^%d+$') then error('invalid CI run identity') end
  local output = root .. '/artifacts/' .. settings.artifactNamespace .. '/' .. runId .. '-' .. attempt
  local resolvedSha = process.env('FORGE_RESOLVED_SOURCE_SHA')
  if resolvedSha and (#resolvedSha ~= 40 or not resolvedSha:match('^[0-9a-f]+$')) then
    error('invalid preflight source SHA')
  end
  local command = if depsOnly then depsArgs(settings) elseif buildOnly then buildOnlyArgs(settings, output, resolvedSha) else buildArgs(settings, output)

  print(`Release profile: {settings.id}`)
  print(`OpenMW source: {settings.repository} @ {settings.ref}`)
  print(`GitHub release: {settings.releaseTag} ({settings.releaseTitle})`)
  print(`Artifact namespace: {settings.artifactNamespace}`)
  print('Required features: Vulkan=' .. tostring(settings.features.vulkan)
    .. ', Luau=' .. tostring(settings.features.luau) .. ', Lua UI=' .. tostring(settings.features.luaUi))
  print('Test policy: GoogleTests=' .. tostring(settings.testPolicy.googleTests)
    .. ', package smoke=' .. tostring(settings.testPolicy.packageSmoke)
    .. ', Qt smoke=' .. tostring(settings.testPolicy.qtSmoke))
  for _, arg in settings.cmakeArgs do print('CMake argument: ' .. arg) end
  print('Forge command: ' .. binary .. ' ' .. table.concat(command, ' '))

  if dry then return end
  if not fs.isFile(binary) then error('compiled Forge executable missing: ' .. binary) end
  if not depsOnly and fs.exists(output) then error('refusing to reuse previously populated scheduled output: ' .. output) end
  util.stream(binary, command, root)
  if depsOnly then
    print('PASS qualified dependency export is ready for caching')
    return
  end

  local main, debug = findOutputs(output)
  local checkout = source.path(root, settings.repository)
  local revision = util.file(checkout .. '/.git/forge-revision'):gsub('%s+$', '')
  if not revision:match('^[0-9a-f]+$') or #revision ~= 40 then error('invalid resolved source SHA') end

  if not main:find('-g' .. revision:sub(1, 12) .. '-', 1, true) then
    error('archive name does not match resolved OpenMW revision')
  end
  -- Run the packaged launchers inside real distribution containers; publication
  -- is disabled if this release gate fails.

  local smoke = smokeArgs(settings, main)
  if smoke then util.stream(binary, smoke, root) end

  local notes = output .. '/SOURCE.txt'
  local requestedRef = process.env('FORGE_REQUESTED_REF') or settings.ref
  local fingerprint = process.env('FORGE_INPUT_FINGERPRINT') or ''
  local inputs = process.env('FORGE_INPUTS_JSON') or ''
  if #fingerprint ~= 64 or not fingerprint:match('^[0-9a-f]+$') or inputs == '' then
    error('missing versioned preflight input identity')
  end

  if resolvedSha and revision ~= resolvedSha then error('built source differs from preflight-resolved SHA') end
  util.write(notes, `Profile: {settings.id}\nGitHub release: {settings.releaseTag}\nOpenMW repository: {settings.repository}\nOpenMW requested ref: {requestedRef}\nOpenMW resolved SHA: {revision}\nBuild input fingerprint: {fingerprint}\nForge CI run: {runId}/{attempt}\n`)
  local provenancePath = output .. '/PROVENANCE.json'
  local provenance = json.encodeTable {
    schema = 'forge-qualified-release/v1',
    qualified = true,
    input_fingerprint = fingerprint,
    source_sha = revision,
    repository = settings.repository,
    requested_ref = requestedRef,
    profile = settings.id,
    release_tag = settings.releaseTag,
    inputs = json.decode(inputs),
  }
  util.write(provenancePath, provenance .. '\n')
  local checksums = output .. '/SHA256SUMS'
  local lines: { string } = {}
  local qualifiedFiles = { main, debug, notes, provenancePath }

  for _, path in qualifiedFiles do
    local checksum = util.sha256(path)
    if not checksum or #checksum ~= 64 then error('failed to compute artifact SHA-256: ' .. path) end
    table.insert(lines, checksum .. '  ' .. (fs.fileName(path) or path))
  end
  util.write(checksums, table.concat(lines, '\n') .. '\n')
  print('PASS qualified scheduled OpenMW artifacts at ' .. output)
end

return table.freeze {
  validate = validate, validateProfiles = validateProfiles, profile = profile,
  buildArgs = buildArgs, depsArgs = depsArgs, buildOnlyArgs = buildOnlyArgs,
  smokeArgs = smokeArgs,
  isMainTarball = isMainTarball,
  findOutputs = findOutputs, verifyArtifacts = verifyArtifacts, publishArtifacts = publishArtifacts,
  releaseIdentityMatches = releaseIdentityMatches, run = run,
}
