  ['openmw/templates/README.packagecontents.txt'] = [===[=== Package Content README ===

This package contains Linux binaries for openmw and its suite of utilities. It is intended to run on most moderately old and recent Linux distributions. These archives are built on Alma Linux and should work on any distribution with glibc 2.34 or later when the configured symbol-version audit passes.

=== Running the provided binaries ===
The binaries depend on libraries that might not be installed on your system or in an incompatible version. Therefore these libraries are included in the "lib" subdirectory. To automatically use the provided libraries there are scripts which set the LD_LIBRARY_PATH variable to the "lib" directory.

To run openmw or a utility simply run the provided shell script (the file without a suffix -> <filename> not <filename>.x86_64). In case of openmw this would be "openmw" not openmw.x86_64.
]===],
  ['openmw/templates/runtime_wrapper.sh.in'] = [===[#!/bin/sh

# Follow launcher symlinks relative to each link's containing directory.
# In particular: /opt/bin/openmw -> ../openmw/openmw must work when the
# caller's current working directory is unrelated to either location.
SCRIPT=$0
COUNT=0
while [ -L "$SCRIPT" ]
do
  TARGET=$(command readlink -- "$SCRIPT") || exit 1
  case "$TARGET" in
    /*) SCRIPT=$TARGET ;;
    *) SCRIPT=$(dirname -- "$SCRIPT")/$TARGET ;;
  esac
  COUNT=$((COUNT + 1))
  if [ "$COUNT" -gt 100 ]
  then
    echo "Too many symbolic links" >&2
    exit 1
  fi
done
GAMEDIR=$(CDPATH='' cd -P -- "$(dirname -- "$SCRIPT")" && pwd) || exit 1
BINNAME=$(basename -- "$0")
cd "$GAMEDIR" || exit 1

# If openmw was started under gdb, keep the original executable contract.
if [ "$BINNAME" = "openmw" ] && [ -n "$DEBUG" ] && [ -n "$DEBUG_START_FROM_LAUNCHER" ]
then
  exec ./openmw.x86_64 "$@"
fi

export LD_LIBRARY_PATH="./lib"

# Qt apps need the plugin path.
case "$BINNAME" in
  openmw-launcher|openmw-cs|openmw-wizard)
    export QT_PLUGIN_PATH="./plugins"

    wayland_client_has_symbol() {
      client_lib=$1

      if command -v readelf >/dev/null 2>&1
      then
        readelf -sW "$client_lib" 2>/dev/null | grep -q "wl_proxy_marshal_flags"
        return $?
      elif command -v objdump >/dev/null 2>&1
      then
        objdump -T "$client_lib" 2>/dev/null | grep -q "wl_proxy_marshal_flags"
        return $?
      else
        return 2
      fi
    }

    # Debian 11 ships libwayland-client 1.18, but Qt 6.6.3's wayland
    # backend expects wl_proxy_marshal_flags. Force xcb when probing fails.
    if [ -z "${QT_QPA_PLATFORM+x}" ] && ( [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || [ -n "${WAYLAND_DISPLAY:-}" ] )
    then
      WAYLAND_CLIENT=""

      if command -v ldconfig >/dev/null 2>&1
      then
        WAYLAND_CLIENT="$(ldconfig -p 2>/dev/null | awk '/libwayland-client\.so\.0/{print $NF; exit}')"
      fi

      if [ -n "$WAYLAND_CLIENT" ]
      then
        if ! wayland_client_has_symbol "$WAYLAND_CLIENT"
        then
          export QT_QPA_PLATFORM="xcb"
        fi
      else
        export QT_QPA_PLATFORM="xcb"
      fi
    fi
    ;;
esac

if [ -n "$DEBUG" ]
then
  which gdb >/dev/null 2>/dev/null
  if [ "$?" -ne 0 ]
  then
    echo "Could not find gdb"
    exit 1
  fi
  export DEBUGINFOD_URLS=""

  if [ "$BINNAME" = "openmw-launcher" ]
  then
    export DEBUG_START_FROM_LAUNCHER=1
    gdb -iex "set follow-fork-mode child" -iex "set detach-on-fork off" -iex "set follow-exec-mode same" --args "./${BINNAME}.x86_64" "$@"
  else
    gdb --args "./${BINNAME}.x86_64" "$@"
  fi
  exit $?
fi

"./${BINNAME}.x86_64" "$@"
]===],
}
return table.freeze(files)
