--!strict
local fs = require '@dream/fs'
local process = require '@dream/process'
local util = require '@forge/native-util'
local config = require '@forge/config'
local args = require '@forge/args'
local archiveSafety = require '@forge/native-archive'

type Options = args.Options
local sdkCache = require '@forge/native-sdk-cache'
local abi = require '@forge/native-abi'
local vcpkgPython = require '@forge/native-vcpkg-python'
local Revision = config.vcpkgRevision

local function installDependencies()
  util.stream('dnf', { 'install', '-y', 'epel-release', 'dnf-plugins-core' })
  local crb = process.run('crb', { 'enable' }, { stdout = 'null', stderr = 'null' })
  if not crb or not crb.success then
    util.stream('dnf', { 'config-manager', '--set-enabled', 'crb' })
  end

  util.stream('dnf', {
    'install', '-y', 'git', 'tar', 'p7zip', 'zip', 'unzip', 'curl-minimal', 'gcc-toolset-13',
    'cmake', 'ninja-build', 'perl', 'autoconf', 'autoconf-archive', 'automake',
    'libtool', 'nasm', 'pkgconfig', 'mesa-libGL-devel', 'mesa-libEGL-devel',
    'libXcursor-devel', 'libX11-devel', 'libXft-devel', 'libXext-devel',
    'libxkbcommon-devel', 'wayland-devel', 'texinfo', 'gettext-devel',
    'kernel-headers', 'python3', 'make', 'binutils', 'patch',
  })
end

local function setupAutoconf(root: string)
  local result = process.run('/usr/local/bin/autoconf', { '--version' }, { stdout = 'capture', stderr = 'null' })
  if result and result.success and string.find(result.stdout or '', '2.72', 1, true) then return end
  local temp = root .. '/work/autoconf-build'
  util.resetManaged(temp)
  local archive = temp .. '/autoconf-2.72.tar.gz'
  util.stream('curl', { '--fail', '--location', '--retry', '3', '--output', archive, 'https://ftp.gnu.org/gnu/autoconf/autoconf-2.72.tar.gz' })
  local sha = util.checked('sha512sum', { archive })
  if string.sub(sha, 1, #config.autoconfSha512) ~= config.autoconfSha512 then error('Autoconf source SHA-512 mismatch') end
  util.stream('tar', { 'xzf', archive, '-C', temp })
  local source = temp .. '/autoconf-2.72'
  util.stream('./configure', { '--prefix=/usr/local' }, source)
  util.stream('make', {}, source)
  util.stream('make', { 'install' }, source)
  util.remove(temp)
end

local function toolsetEnv(): { [string]: string }
  local path = process.env('PATH') or '/usr/bin:/bin'
  return { PATH = '/opt/rh/gcc-toolset-13/root/usr/bin:/usr/local/bin:' .. path,
    CC = '/opt/rh/gcc-toolset-13/root/usr/bin/gcc',
    CXX = '/opt/rh/gcc-toolset-13/root/usr/bin/g++' }
end

local function exportPath(options: Options): string
  return options.depsOutput .. '/vcpkg-' .. options.triplet .. '.7z'
end

-- The manifest is embedded in the image at /forge/work/forge-assets/deps.
-- That directory belongs to the image's root user. Our Docker workers use
-- the invoking host UID, so vcpkg's default manifest-adjacent
-- `vcpkg_installed` location is read-only. Keep the installed tree under the
-- separately mounted, writable vcpkg checkout instead. Both install AND
-- export must use the same root or export will find no installed ports.
local function installedRoot(vcpkg: string): string
  return vcpkg .. '/installed'
end

local function installedRootFlag(vcpkg: string): string
  return '--x-install-root=' .. installedRoot(vcpkg)
end

-- The outer vcpkg process normally prints only the name of a CMake log after
-- compiler detection fails. Emit the underlying CMake diagnostics while the
-- disposable CI container still exists, or the useful evidence is lost.
local function reportCompilerDetection(vcpkg: string, triplet: string)
  local base = vcpkg .. '/buildtrees/detect_compiler/'
  for _, filename in {
    'config-' .. triplet .. '-rel-err.log',
    'config-' .. triplet .. '-rel-out.log',
    'stdout-' .. triplet .. '.log',
  } do
    local path = base .. filename
    if not fs.isFile(path) then continue end
    local contents = util.file(path)
    print('=== vcpkg compiler diagnostic: ' .. filename .. ' ===')
    print(contents:sub(-12000))
  end
end

local verify: (Options, string?) -> ()

local function runUnlocked(options: Options)
  if options.triplet ~= config.triplet then error('only pinned x64-linux-dynamic triplet is qualified') end
  local root = options.root .. '/work/forge-assets/deps'
  if not fs.isFile(root .. '/vcpkg.json') then error('embedded dependency assets not staged') end
  util.mkdir(options.depsOutput)
  if not options.noSystemPackages then installDependencies() end
  setupAutoconf(options.root)
  local inputs = sdkCache.fingerprint(root, options.triplet)
  if not options.clean and sdkCache.cacheHit(options.depsOutput, options.triplet, inputs) then
    print('PASS reuse SHA-256-verified AlmaLinux 9 SDK export ' .. inputs:sub(1, 12))
    return
  end
  local vcpkg = options.root .. '/work/vcpkg'
  local marker = vcpkg .. '/.git/forge-owner'
  if options.clean and fs.isDir(vcpkg .. '/.git') then
    if not fs.isFile(marker) or util.file(marker) ~= 'openmw-forge-vcpkg-v1\n' then
      error('refusing --clean on unmanaged vcpkg checkout')
    end
    util.stream('git', { '-C', vcpkg, 'clean', '-ffdqx' })
  end

  if not fs.isDir(vcpkg .. '/.git') then
    util.stream('git', { 'clone', 'https://github.com/microsoft/vcpkg.git', vcpkg })
  else
    util.stream('git', { 'fetch', 'origin', Revision }, vcpkg)
  end
  util.stream('git', { 'checkout', '--detach', Revision }, vcpkg)
  util.write(marker, 'openmw-forge-vcpkg-v1\n')
  -- vcpkg owns its bootstrap shell script; Forge never runs a Bash orchestration worker.
  if not fs.isFile(vcpkg .. '/vcpkg') then
    util.stream('./bootstrap-vcpkg.sh', { '-disableMetrics' }, vcpkg, toolsetEnv())
  end
  local env = vcpkgPython.prepare(vcpkg, toolsetEnv())
  env.VCPKG_ROOT = vcpkg
  env.VCPKG_MAX_CONCURRENCY = tostring(options.jobs)
  -- The binary cache is a host volume for containers, and persistent locally.
  -- Never restore packages built against the previous, floating EL9 glibc.
  -- The host-mounted parent persists, but the ABI baseline has a dedicated
  -- vcpkg binary-cache namespace for local and container executions.
  local binaryCache = options.root .. '/work/vcpkg-binaries/alma9-6-glibc234-v1'
  util.mkdir(binaryCache)
  env.VCPKG_DEFAULT_BINARY_CACHE = binaryCache
  local install = installedRoot(vcpkg)
  util.mkdir(install)
  -- A failed vcpkg install leaves valuable compiler-detection logs in its
  -- buildtrees; continue only to print those logs before propagating failure.
  local installed, installFailure = pcall(util.stream, vcpkg .. '/vcpkg', {
    'install', '--overlay-ports=' .. root .. '/ports', '--overlay-triplets=' .. root .. '/triplets',
    '--triplet', options.triplet, '--host-triplet', options.triplet,
    installedRootFlag(vcpkg),
  }, root, env)

  if not installed then
    vcpkgPython.reportFailure(vcpkg, options.triplet)
    reportCompilerDetection(vcpkg, options.triplet)
    error(tostring(installFailure))
  end

  -- Audit the actual installed ELF tree BEFORE compression. The previous
  -- implementation spent ~32 silent minutes inspecting 7z link payloads and
  -- only then found a GLIBC_2.35 dependency in libsystemd's debug library.
  -- Keep auditing debug libraries: a Debug OpenMW build can use them too.
  local installedTree = install .. '/' .. options.triplet
  if not fs.isDir(installedTree) then error('missing installed vcpkg triplet: ' .. installedTree) end
  print('Preflight: verifying installed SDK symlinks and AlmaLinux 9 ABI before 7z export')
  archiveSafety.validateExtractedLinks(installedTree)
  abi.scanAbi(installedTree)

  -- vcpkg exports to a temporary directory. Validation must pass before the
  -- previous production artifact can be replaced.
  local pending = options.depsOutput .. '/.forge-export-pending'
  util.resetManaged(pending)
  util.stream(vcpkg .. '/vcpkg', {
    'export', '--x-all-installed', '--7zip', '--output-dir', pending,
    '--output', 'vcpkg-' .. options.triplet, installedRootFlag(vcpkg),
  }, root, env)
  local candidate = table.clone(options)
  candidate.depsOutput = pending
  -- Verify against the already inspected installed tree, no extraction.
  util.write(pending .. '/vcpkg-' .. options.triplet .. '.build-meta',
    sdkCache.record(options.triplet, inputs, pending .. '/vcpkg-' .. options.triplet .. '.7z'))
  verify(candidate, installedTree)
  for _, suffix in { '.7z', '.build-meta' } do
    local name = 'vcpkg-' .. options.triplet .. suffix
    local published, failure = fs.rename(pending .. '/' .. name, options.depsOutput .. '/' .. name)
    if not published then error('failed to publish dependency export: ' .. (failure or name)) end
  end
  util.remove(pending)
  print('Exported verified dependency archive: ' .. exportPath(options))
end

-- A kernel-owned advisory lock prevents two Forge instances from replacing the
-- same SDK export or using the same vcpkg installed tree simultaneously.
-- Unlike a sentinel directory, a crashed process cannot strand the lock.
local function run(options: Options)
  util.mkdir(options.depsOutput)
  local lock, failure = fs.lock(options.depsOutput .. '/.forge-sdk.lock')
  if not lock then error('SDK export already in use: ' .. (failure or 'cannot lock directory')) end
  -- Run the entire vcpkg transaction under a lock; release it even when a
  -- tool fails so another invocation can retry safely.
  local ok, problem = pcall(runUnlocked, options)
  lock:unlock()
  if not ok then error(tostring(problem)) end
end

verify = function(options: Options, scanOverride: string?)
  local archive = exportPath(options)
  local info = fs.stat(archive)
  if not info or info.size == 0 then error('missing or empty dependency export ' .. archive) end
  local meta = sdkCache.metadata(util.file(options.depsOutput .. '/vcpkg-' .. options.triplet .. '.build-meta'))
  if meta.profile ~= 'alma9' or meta.triplet ~= options.triplet or meta.vcpkg_revision ~= Revision then
    error('dependency metadata profile/triplet/vcpkg pin mismatch')
  end

  if meta.cache_schema ~= '3' or meta.sdk_recipe ~= config.sdkRecipe then
    error('dependency export uses an unsupported or outdated SDK recipe')
  end

  if meta.archive_sha256 ~= sdkCache.digest(archive) then
    error('dependency export checksum mismatch')
  end
  local sevenZip = util.tool { '7zz', '7z', '7za' }
  if scanOverride then
    -- The exporter just serialized our audited, local installed tree. 7z's
    -- symlink target is stored as compressed file data: reopening its solid
    -- archive for EVERY symlink can take over half an hour. Inspect the 7z
    -- membership once, resolve links from the original installed tree, and
    -- cross-check each entry's archived size. The local export is trusted only
    -- on this path; cache restores and external archives still read each link
    -- directly from the archive BEFORE extraction.
    print('Validating fresh SDK archive against audited source symlinks (single 7z listing)')
    local prefix = 'vcpkg-' .. options.triplet .. '/installed/' .. options.triplet .. '/'
    archiveSafety.validateArchiveEntries(sevenZip, archive, function(member: string): string
      if member:sub(1, #prefix) == prefix then
        local original = scanOverride .. '/' .. member:sub(#prefix + 1)
        local stat = fs.lstat(original)
        if not stat or stat.kind ~= 'symlink' then
          error('fresh SDK export symlink is missing from inspected source: ' .. member)
        end
        local target, failure = fs.readLink(original)
        if not target then error('cannot inspect source SDK symlink: ' .. (failure or member)) end
        return target
      end
      -- Never assume that unrecognized archive locations correspond to our
      -- trusted vcpkg installed tree.
      return util.checked(sevenZip, { 'e', '-so', '-spd', archive, member })
    end)
  else
    archiveSafety.validateArchiveEntries(sevenZip, archive)
  end
  local root = scanOverride or (options.root .. '/work/deps-verify')
  if not scanOverride then
    util.resetManaged(root)
    util.stream(sevenZip, { 'x', '-y', '-o' .. root, archive })
    archiveSafety.validateExtractedLinks(root)
  end
  local scan = root
  if not scanOverride then
    local walkResult, failure = fs.walk(root, { include = 'dirs', sort = true })
    if not walkResult then error(failure or 'failed to locate extracted dependencies') end
    local wanted = '/installed/' .. options.triplet
    for _, name in walkResult.paths do
      if string.sub('/' .. name, -#wanted) == wanted then scan = root .. '/' .. name break end
    end
  end

  if not fs.isDir(scan) then error('ABI scan root not found: ' .. scan) end
  -- runUnlocked already audited the source tree before export. Repeat this
  -- only for independently extracted/cached archives, not the same source.
  if not scanOverride then abi.scanAbi(scan) end
end

-- A direct `verify` must serialize with an SDK export, too. Internal
-- verification inside runUnlocked already holds this very same lock.
local function verifyLocked(options: Options)
  util.mkdir(options.depsOutput)
  local lock, failure = fs.lock(options.depsOutput .. '/.forge-sdk.lock')
  if not lock then error('SDK export is being modified: ' .. (failure or 'lock unavailable')) end

  -- A failed ABI/archive audit cannot strand the advisory lock.
  local ok, problem = pcall(function(): boolean
    verify(options, nil)
    return true
  end)
  lock:unlock()
  if not ok then error(tostring(problem)) end
end

return table.freeze { run = run, verify = verifyLocked, validateArchiveEntries = archiveSafety.validateArchiveEntries,
  installedRoot = installedRoot, installedRootFlag = installedRootFlag }
