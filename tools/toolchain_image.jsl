#!/usr/bin/env -S jess run --trusted --package .
--!strict
-- Resolve the independently qualified GHCR builder image to its immutable
-- OCI digest. A missing first-run image is an explicit local-build fallback.
local process = require '@dream/process'
local fs = require '@dream/fs'
local json = require '@jess/json'
local util = require '@forge/native-util'

local root, failure = fs.cwd()
if not root then error(failure or 'cannot find repo root') end
local recipe = root .. '/vendor/builder/Dockerfile'
if not fs.isFile(recipe) then error('missing canonical builder Dockerfile') end
local source = util.sha256(recipe)
if not source or #source ~= 64 then error('cannot identify builder recipe') end
local repository = process.env('GITHUB_REPOSITORY') or ''
if not repository:match('^[%w._%-]+/[%w._%-]+$') then
  error('GITHUB_REPOSITORY must contain owner/repository')
end

local image = 'ghcr.io/' .. repository:lower() .. '-builder:alma9-' .. source:sub(1, 20)
local dry = ... == '--dry-run'
local preflight = ... == '--preflight'
if dry then
  print(image)
  return
end

local key = 'fallback-' .. source:sub(1, 20)
local pinned = ''
local toolchainId = ''
local buildBase = ''
local runnerOs = process.env('RUNNER_OS') or 'Linux'
local runnerArch = process.env('RUNNER_ARCH') or 'X64'
local architecture = if runnerArch == 'X64' then 'amd64' elseif runnerArch == 'ARM64' then 'arm64' else ''
if runnerOs ~= 'Linux' or architecture == '' then
  error('unsupported OCI toolchain runner platform: ' .. runnerOs .. '/' .. runnerArch)
end

type Platform = { os: string?, architecture: string? }
type Descriptor = { digest: string?, platform: Platform? }
-- docker manifest inspect --verbose prints a list of platform manifests, an index with
-- manifests, or one manifest; the field spellings vary across Docker releases.
type Manifest = {
  Descriptor: Descriptor?, descriptor: Descriptor?,
  digest: string?, Digest: string?,
  platform: Platform?, Platform: Platform?,
  manifests: { Manifest }?,
}

local function manifestPlatform(manifest: Manifest): Platform
  local platform = (manifest.Descriptor and manifest.Descriptor.platform)
    or (manifest.descriptor and manifest.descriptor.platform)
    or manifest.platform
    or manifest.Platform
  return platform or {}
end

local function entryDigest(manifest: Manifest): string?
  return (manifest.Descriptor and manifest.Descriptor.digest)
    or (manifest.descriptor and manifest.descriptor.digest)
    or manifest.digest
    or manifest.Digest
end

local function isSha256Digest(value: string?): boolean
  return value ~= nil and #value == 71 and value:match('^sha256:[0-9a-f]+$') ~= nil
end

-- The one distinct valid digest for linux/<architecture>, or '' when there is not exactly one.
local function platformDigest(manifests: { Manifest }, architecture: string): string
  local digests: { string } = {}
  for _, manifest in manifests do
    local platform = manifestPlatform(manifest)
    if (platform.os or '') == 'linux' and (platform.architecture or '') == architecture then
      local digest = entryDigest(manifest)
      if digest and isSha256Digest(digest) and not table.find(digests, digest) then
        table.insert(digests, digest)
      end
    end
  end

  if #digests == 1 then return digests[1] end
  return ''
end

local function manifestDigest(reference: string): string
  local result = process.run('docker', { 'manifest', 'inspect', '--verbose', reference }, {
    stdout = 'capture', stderr = 'capture',
  })

  if not result or not result.success then return '' end

  -- json.decode raises on output that is not JSON. Docker then describes no digest we
  -- can use, so the result is the same as a missing image: the explicit fallback.
  local decoded, document = pcall(json.decode, result.stdout or '')
  if not decoded or type(document) ~= 'table' then return '' end

  local manifests = document :: { Manifest }
  local digest = ''
  if #manifests > 0 then
    digest = platformDigest(manifests, architecture)
  else
    local manifest = document :: Manifest
    if manifest.manifests ~= nil then
      digest = platformDigest(manifest.manifests, architecture)
    elseif manifestPlatform(manifest).os ~= nil or manifestPlatform(manifest).architecture ~= nil then
      local platform = manifestPlatform(manifest)
      if (platform.os or '') == 'linux' and (platform.architecture or '') == architecture then
        digest = entryDigest(manifest) or ''
      end
    else
      digest = entryDigest(manifest) or ''
    end
  end

  if isSha256Digest(digest) then return digest end
  return ''
end

if preflight then
  local digest = manifestDigest(image)
  if digest ~= '' then
    pinned = image:gsub(':[^:]+$', '') .. '@' .. digest
    toolchainId = pinned
    key = digest:sub(8)
    print('PASS resolved OCI toolchain manifest without pulling layers: ' .. pinned)
  end
else
  local digest = manifestDigest(image)
  if digest ~= '' then
    pinned = image:gsub(':[^:]+$', '') .. '@' .. digest
    toolchainId = pinned
    key = digest:sub(8)
    local pulled = process.run('docker', { 'pull', pinned }, { stdout = 'capture', stderr = 'capture' })
    if not pulled or not pulled.success then error('cannot pull resolved OCI toolchain image: ' .. pinned) end
    print('PASS verified OCI toolchain image: ' .. pinned)
  end
end

if pinned == '' then
  local base = 'almalinux/9-base:9.5-20250519'
  local digest = manifestDigest(base)
  if digest == '' then error('cannot resolve immutable AlmaLinux 9 builder base for ' .. runnerArch) end
  local baseName = base:gsub(':[^:]+$', '')
  local basePinned = baseName .. '@' .. digest
  key = 'fallback-' .. source:sub(1, 12) .. '-' .. digest:sub(8, 23)
  toolchainId = 'fallback:' .. source .. ':' .. digest:sub(8)

  if preflight then
    print('PASS resolved fallback builder base without pulling layers: ' .. basePinned)
  else
    print('WARN no published toolchain image; using local AlmaLinux 9 toolchain build (first run/fork)')
    local pulled = process.run('docker', { 'pull', basePinned }, { stdout = 'capture', stderr = 'capture' })
    if not pulled or not pulled.success then error('cannot pull resolved AlmaLinux builder base: ' .. basePinned) end
    buildBase = basePinned
  end
end

local output = process.env('GITHUB_OUTPUT')
if output and output ~= '' then
  local identity = if toolchainId ~= '' then toolchainId else ('unresolved:' .. source)
  local ok, problem = fs.writeFile(output, 'cache_key=' .. key:sub(1, 32)
    .. '\ntoolchain_id=' .. identity .. '\n', { append = true })
  if not ok then error(problem or 'cannot report OCI cache identity') end
end

local envFile = process.env('GITHUB_ENV')
if toolchainId ~= '' and envFile and envFile ~= '' then
  local environment = (if pinned ~= '' then 'FORGE_TOOLCHAIN_IMAGE=' .. pinned .. '\n' else '')
    .. (if buildBase ~= '' then 'FORGE_TOOLCHAIN_BASE_IMAGE=' .. buildBase .. '\n' else '')
    .. 'FORGE_TOOLCHAIN_ID=' .. toolchainId .. '\n'
  local ok, problem = fs.writeFile(envFile, environment, { append = true })
  if not ok then error(problem or 'cannot set pinned OCI toolchain identity') end
end
