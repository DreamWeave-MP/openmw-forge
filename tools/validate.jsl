#!/usr/bin/env jess
--!strict
local fs = require '@dream/fs'
local process = require '@dream/process'
local argv = { ... }
local binary = argv[1] or process.env('FORGE_BIN')
local jessBin = process.env('JESS_BIN') or 'jess'
if not binary or binary == '' then error('usage: tools/validate.jsl /absolute/path/to/compiled-forge') end
if not fs.isFile(binary) then error('compiled Forge binary is missing: ' .. binary) end

local function gate(label: string, command: { string })
  print('=== ' .. label .. ' ===')
  local result, failure = process.run(jessBin, command, { stdout = 'capture', stderr = 'capture' })
  if not result or not result.success then
    error(`{label} failed: {failure or ''}\n{if result then result.stdout or '' else ''}\n{if result then result.stderr or '' else ''}`)
  end
  print('PASS ' .. label)
end

gate('strict package', { 'package', 'check', '.' })
gate('Jess source/packed tests', { 'workspace', 'test' })
gate('Jess style', { 'run', '--trusted', 'tools/style.jsl' })
print('=== compiled integration ===')
local result, failure = process.run(jessBin, { 'run', '--trusted', '--package', '.', 'tools/integration.jsl', binary }, {
  env = { JESS_BIN = jessBin }, stdout = 'capture', stderr = 'capture',
})

if not result or not result.success then
  error(`compiled integration failed: {failure or ''}\n{if result then result.stdout or '' else ''}\n{if result then result.stderr or '' else ''}`)
end
print(result.stdout or '')
print('ALL Jess-native validation gates passed')
