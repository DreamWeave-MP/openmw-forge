#!/usr/bin/env -S jess run --trusted --package .
--!strict
local fs = require '@dream/fs'
local process = require '@dream/process'
local util = require '@forge/native-util'
local sourceModule = require '@forge/source'
local argsModule = require '@forge/args'
local nativeOpenmw = require '@forge/native-openmw'
local nativeQt = require '@forge/native-qt'
local nativeAbi = require '@forge/native-abi'
local nativeArchive = require '@forge/native-archive'
local releaseArtifacts = require '@forge/native-release-artifacts'
local sdkCache = require '@forge/native-sdk-cache'
local config = require '@forge/config'
local assets = require '@forge/assets'
local vcpkgPython = require '@forge/native-vcpkg-python'

local binary = ...
if type(binary) ~= 'string' or not fs.isFile(binary) then error('usage: tools/integration.jsl /absolute/path/to/compiled-forge') end
local root, failure = fs.cwd()
if not root then error(failure or 'cannot determine current directory') end
local scratch = root .. '/work/native-integration'
util.remove(scratch)
util.mkdir(scratch)
local cases = 0

local function check(condition: boolean, message: string)
  if not condition then error('integration assertion: ' .. message) end
  cases += 1
end

-- Resolve automatic parallelism under trusted execution, where process.spawn
-- is available. Unit tests can validate explicit jobs without that grant.
local detectedJobs = util.resolveJobs('auto')
check(detectedJobs >= 1 and detectedJobs <= 1024, 'auto jobs must resolve to available CPUs')
check(util.resolveJobs(2) == 2, 'explicit parallelism must override auto detection')

-- The real GNU timeout used for local smoke must stop an event-loop-like
-- process rather than leaving Forge blocked in @dream/process.run.
local bounded, boundedFailure = process.run('timeout', {
  '--signal=TERM', '--kill-after=2s', '1s', 'sleep', '20',
}, { stdout = 'capture', stderr = 'capture' })

if not bounded then error('bounded fixture failed to start: ' .. (boundedFailure or '')) end
check(bounded.code == 124,
  'bounded local GUI startup must terminate a non-exiting child')
local guiAlive = require('@forge/native-smoke').validateBoundedResult(
  'openmw-launcher', 'fixture', bounded.code, bounded.code == 124, bounded.stdout, bounded.stderr)
check(guiAlive, 'bounded GUI liveness must accept a non-exiting process with no startup diagnostics')
local cliAlive = require('@forge/native-smoke').validateBoundedResult(
  'openmw', 'fixture', bounded.code, bounded.code == 124, bounded.stdout, bounded.stderr)
check(not cliAlive, 'non-exiting CLI programs must not be mistaken for healthy GUI applications')

-- Archive preflight is intentionally metadata-only; the post-extraction phase
-- must verify the actual filesystem symlinks, without invoking 7z per link.
local linkRoot = scratch .. '/validated-archive-links'
local linkParent = linkRoot .. '/package/installed/x64-linux-dynamic/lib'
util.mkdir(linkParent)
util.write(linkParent .. '/libfixture.so.1', 'payload')
local madeLink, linkFailure = fs.symlink('libfixture.so.1', linkParent .. '/libfixture.so')
if not madeLink then error('cannot create archive link fixture: ' .. (linkFailure or 'unknown')) end
local Member = 'package/installed/x64-linux-dynamic/lib/libfixture.so'
local listing = '7-Zip listing\n----------\nPath = ' .. Member
  .. '\nAttributes =  lrwxrwxrwx\nSize = 15\n'
nativeArchive.validate7zListing(listing, nil, true)
nativeArchive.validate7zListing(listing, function(path: string): string
  local link, why = fs.readLink(linkRoot .. '/' .. path)
  if not link then error('cannot read integration link: ' .. (why or path)) end
  return link
end)
nativeArchive.validateExtractedLinks(linkRoot)
check(true, 'archived symlink targets are verified from isolated extracted files')

-- CI's 7-Zip 26.04 rejects these ordinary aliases under its default setting:
-- libfixture.so.alias -> libfixture.so -> libfixture.so.1. The chosen
-- extraction level must permit the chain without dropping containment checks.
local chainLink, chainFailure = fs.symlink('libfixture.so', linkParent .. '/libfixture.so.alias')
if not chainLink then error('cannot create chained link fixture: ' .. (chainFailure or 'unknown')) end
nativeArchive.validateExtractedLinks(linkRoot)
check(true, 'post-extraction validation permits internal symlink chains')
local extractArgs = nativeArchive.extractionArgs(scratch .. '/isolated', scratch .. '/SDK.7z')
check(extractArgs[3] == '-snld10' and extractArgs[4] == '-o' .. scratch .. '/isolated',
  '7-Zip extraction must permit safe chains without the insecure -snld20 mode')

-- Parent-relative symlinks are common in the systemd subtree of the SDK.
local sockets = linkParent .. '/systemd/system'
util.mkdir(sockets .. '/sockets.target.wants')
util.write(sockets .. '/dbus.socket', 'fixture')
local systemdLink, systemdFailure = fs.symlink('../dbus.socket', sockets .. '/sockets.target.wants/dbus.socket')
if not systemdLink then error('cannot create systemd fixture: ' .. (systemdFailure or 'unknown')) end
nativeArchive.validateExtractedLinks(linkRoot)
check(true, 'post-extraction validation permits contained parent-relative links')

local escaped = linkParent .. '/escape.so'
local escapedLink, escapedFailure = fs.symlink('../../../../../etc/passwd', escaped)
if not escapedLink then error('cannot create escape fixture: ' .. (escapedFailure or 'unknown')) end
-- An escaping extracted symlink is deliberately rejected by the validator.
local rejectedEscape, escapeError = pcall(nativeArchive.validateExtractedLinks, linkRoot)
check(not rejectedEscape and type(escapeError) == 'string'
  and escapeError:find('escaping or dangling archive link: ', 1, true) ~= nil
  and escapeError:find('escape.so', 1, true) ~= nil,
  'post-extraction validation must report the escaping link, not an unrelated exception')
local chainEscape, chainEscapeFailure = fs.symlink('escape.so', linkParent .. '/escape-chain.so')
if not chainEscape then error('cannot create escape-chain fixture: ' .. (chainEscapeFailure or 'unknown')) end
-- validateExtractedLinks must reject escape-chain.so even though it traverses another link;
-- this negative security fixture intentionally catches that precise rejection to continue testing.
local rejectedChainedEscape, chainError = pcall(nativeArchive.validateExtractedLinks, linkRoot)
check(not rejectedChainedEscape and type(chainError) == 'string'
  and chainError:find('escaping or dangling archive link: ', 1, true) ~= nil
  and chainError:find('escape-chain.so', 1, true) ~= nil,
  'post-extraction validation must reject the chained escape, not an unrelated exception')
util.remove(linkRoot)

-- vcpkg installs many non-ELF files (including zero/short byte files).
-- A short successful read is NOT a four-byte ELF header. The old scanner
-- crashed after auditing 100 ELFs because it read past such a buffer.
local abiFixture = scratch .. '/abi-short-headers'
util.mkdir(abiFixture)
for size = 0, 3 do
  local path = abiFixture .. '/short-' .. tostring(size)
  util.write(path, string.rep('X', size))
  local prefix, why = fs.readAt(path, 0, 4)
  if not prefix then error('readAt fixture failed: ' .. (why or path)) end
  check(buffer.len(prefix) == size, 'readAt must return the actual short buffer length')
  check(not nativeAbi.isElf(path), 'ABI scanner must skip a ' .. tostring(size) .. '-byte file')
end
util.write(abiFixture .. '/header-only', '\127ELF')
check(nativeAbi.isElf(abiFixture .. '/header-only'), 'four-byte ELF magic must be recognized')
util.remove(abiFixture .. '/header-only')
util.copy(binary, abiFixture .. '/real-forge-elf')
check(nativeAbi.isElf(abiFixture .. '/real-forge-elf'), 'packed Forge executable must be recognized as ELF')
nativeAbi.scanAbi(abiFixture)
check(true, 'ABI scanner must traverse short files and audit a real ELF without crashing')

-- Reproduce the glibc 9.5 false-positive and prove the frozen 9.7 symbol
-- gate only matches dangerous *defined* exports, not mere version nodes.
local dockerfile = assets['builder/Dockerfile']
local nmPattern = dockerfile:match("grep %-E '([^']+)'" )
check(nmPattern ~= nil, 'builder must contain dynamic-export ABI guard')
if not nmPattern then error('missing nm export guard') end

local function unsafeExport(text: string): boolean
  local result, problem = process.run('grep', { '-E', nmPattern :: string }, {
    stdin = text, stdout = 'capture', stderr = 'capture',
  })

  if not result or (result.code ~= 0 and result.code ~= 1) then
    error('invalid glibc preflight regex: ' .. (problem or (if result then result.stderr or '' else '')))
  end
  return result.success
end
check(not unsafeExport('  Name: GLIBC_2.35 Flags: none Version: 40\n'),
  'legacy version nodes must not fail the 9.5 sysroot preflight')
check(not unsafeExport('00000000 T __memcmpeq@@GLIBC_2.34\n'),
  'compatible GLIBC_2.34 exports must pass')
check(not unsafeExport('00000000 T __memcmpeq@@GLIBC_2.36\n'),
  'non-target symbol versions do not trigger the narrow export preflight')
for _, symbol in { '__epoll_pwait2_time64', '__memcmpeq', '_dl_find_object', 'epoll_pwait2',
  'posix_spawn_file_actions_addtcsetpgrp_np', 'posix_spawnattr_tcgetpgrp_np', 'posix_spawnattr_tcsetpgrp_np' } do
  check(unsafeExport('0000000000001000 T ' .. symbol .. '@@GLIBC_2.35\n'),
    '9.7 backport must be detected: ' .. symbol)
end

-- Failed upstream Python-port diagnostics must survive the disposable
-- container and surface the underlying pip stderr, not just vcpkg's exit 1.
local fakeVcpkg = scratch .. '/vcpkg-pip-failure'
local pipLog = fakeVcpkg .. '/buildtrees/libsystemd/pip-install-packages-x64-linux-dynamic-err.log'
util.write(pipLog, 'ERROR: pip fixture could not install Jinja2\n')
check(vcpkgPython.reportFailure(fakeVcpkg, config.triplet) == 1,
  'failed libsystemd pip-install diagnostic must be discovered')

-- Managed dependency publication must preserve the last complete SDK if a
-- replacement fails or a previous process stops between the two renames.
local liveTree = scratch .. '/published-deps'
local firstTree = scratch .. '/prepared-deps-1'
util.resetManaged(firstTree)
util.write(firstTree .. '/version', 'v1')
util.publishManagedDirectory(firstTree, liveTree)
check(util.file(liveTree .. '/version') == 'v1', 'first managed publication must install the candidate')
local secondTree = scratch .. '/prepared-deps-2'
util.resetManaged(secondTree)
util.write(secondTree .. '/version', 'v2')
util.publishManagedDirectory(secondTree, liveTree)
check(util.file(liveTree .. '/version') == 'v2', 'replacement must publish the new complete tree')
check(not fs.exists(liveTree .. '-previous'), 'successful publication must retire the prior tree')
local moved, moveFailure = fs.rename(liveTree, liveTree .. '-previous')
if not moved then error('cannot simulate interrupted publication: ' .. (moveFailure or 'unknown')) end
util.recoverManagedDirectory(liveTree)
check(util.file(liveTree .. '/version') == 'v2', 'recovery must restore the previous complete tree')
check(not fs.exists(liveTree .. '-previous'), 'recovery must clear the backup name')
local foreignTree = scratch .. '/foreign-deps'
util.mkdir(foreignTree)
util.write(foreignTree .. '/KEEP', 'user-owned')
local foreignCandidate = scratch .. '/foreign-candidate'
util.resetManaged(foreignCandidate)
-- publishManagedDirectory must throw for an unowned target; this negative test intentionally continues.
local replacedForeign = pcall(util.publishManagedDirectory, foreignCandidate, foreignTree)
check(not replacedForeign, 'managed publication must not overwrite user-owned directories')
check(util.file(foreignTree .. '/KEEP') == 'user-owned', 'foreign publication rejection must preserve contents')

check(#sdkCache.hashText('OpenMW Forge') == 64, 'SDK cache keys must be full SHA-256 values')
check(sdkCache.hashText('OpenMW Forge') ~= sdkCache.hashText('OpenMW Forge!'),
  'SDK cache input changes must invalidate their fingerprints')

-- Exercise real archive extraction and unchanged-input reuse. The candidate
-- should be RENAMED, not copied, after archive safety validation.
local sdkSource = scratch .. '/SDK-source'
local sdkPackage = sdkSource .. '/mock-vcpkg'
local sdkArchive = scratch .. '/SDK-fixture.tar.xz'
local sdkExtract = scratch .. '/SDK-extracted'
util.mkdir(sdkPackage .. '/scripts/buildsystems')
util.mkdir(sdkPackage .. '/installed/x64-linux-dynamic/lib')
util.write(sdkPackage .. '/scripts/buildsystems/vcpkg.cmake', '# fixture toolchain\n')
util.write(sdkPackage .. '/installed/x64-linux-dynamic/lib/libfixture.so', 'v1')
util.stream('tar', { '-cJf', sdkArchive, '-C', sdkSource, 'mock-vcpkg' })
local sdkOptions, sdkError = argsModule.parse({ 'build', '--mode', 'local',
  '--deps-archive', sdkArchive, '--deps-prefix', sdkExtract }, root)

if not sdkOptions then error(sdkError or 'SDK extraction fixture parse failed') end
nativeOpenmw.extractDeps(sdkOptions)
check(util.file(sdkExtract .. '/openmw-deps/installed/x64-linux-dynamic/lib/libfixture.so') == 'v1',
  'tar.xz dependency extraction must stage a full vcpkg tree')
nativeOpenmw.extractDeps(sdkOptions)
check(util.file(sdkExtract .. '/openmw-deps/installed/x64-linux-dynamic/lib/libfixture.so') == 'v1',
  'unchanged extracted SDK must remain valid')
util.write(sdkExtract .. '/openmw-deps/installed/x64-linux-dynamic/lib/libfixture.so', 'CORRUPTED')
nativeOpenmw.extractDeps(sdkOptions)
check(util.file(sdkExtract .. '/openmw-deps/installed/x64-linux-dynamic/lib/libfixture.so') == 'v1',
  'corrupted extracted SDK library must be restored from the verified archive')
check(not fs.exists(sdkExtract .. '/extracting'), 'SDK extraction must discard the temporary tree')
check(not fs.exists(sdkExtract .. '/openmw-deps-next'), 'SDK publication must not leave a staging copy')

-- Cached exports must never pass a reused input key if bytes changed or
-- the exact archive fingerprint changed. Corrupt files fail before 7z runs.
local cacheDir = scratch .. '/sdk-cache'
util.mkdir(cacheDir)
local prefix = cacheDir .. '/vcpkg-x64-linux-dynamic'
util.write(prefix .. '.7z', 'invalid cache bytes')
util.write(prefix .. '.build-meta', 'profile=alma9\ntriplet=x64-linux-dynamic\n'
  .. 'vcpkg_revision=6d332a018c433fad20822ff4b536e4ccdc3413bd\n'
  .. 'cache_schema=3\nsdk_recipe=' .. config.sdkRecipe .. '\ninputs_sha256=' .. string.rep('a', 64)
  .. '\narchive_sha256=' .. string.rep('0', 64) .. '\n')
check(not sdkCache.cacheHit(cacheDir, 'x64-linux-dynamic', string.rep('b', 64)),
  'SDK input mismatch must invalidate the restored export')
check(not sdkCache.cacheHit(cacheDir, 'x64-linux-dynamic', string.rep('a', 64)),
  'SDK byte mismatch must invalidate the restored export')
-- Even a matching checksum doesn't make a bogus archive acceptable. The
-- absence of 7z or an invalid listing is an ordinary cache miss, not a fatal
-- error that permanently bricks an immutable CI cache key.
local bogusHash = sdkCache.digest(prefix .. '.7z')
util.write(prefix .. '.build-meta', 'profile=alma9\ntriplet=x64-linux-dynamic\n'
  .. 'vcpkg_revision=' .. config.vcpkgRevision .. '\n'
  .. 'cache_schema=3\nsdk_recipe=' .. config.sdkRecipe .. '\n'
  .. 'inputs_sha256=' .. string.rep('a', 64) .. '\narchive_sha256=' .. bogusHash .. '\n')
check(not sdkCache.cacheHit(cacheDir, 'x64-linux-dynamic', string.rep('a', 64)),
  'matching SHA-256 with an invalid archive must fall back to rebuilding')

-- Even a valid cache candidate cannot be audited while another writer owns
-- the same SDK export path.
local sdkLock, sdkLockFailure = fs.lock(cacheDir .. '/.forge-sdk.lock')
if not sdkLock then error(sdkLockFailure or 'cannot lock SDK verification fixture') end

local sdkVerifyOptions, sdkVerifyError = argsModule.parse({ 'verify', '--mode', 'local',
  '--deps-output', cacheDir }, root)

if not sdkVerifyOptions then error(sdkVerifyError or 'cannot parse SDK verification fixture') end

local depsModule = require '@forge/native-deps'
check(depsModule.installedRoot('/forge/work/vcpkg') == '/forge/work/vcpkg/installed',
  'vcpkg installed state must be placed in the writable, host-mounted checkout')
check(depsModule.installedRootFlag('/forge/work/vcpkg') == '--x-install-root=/forge/work/vcpkg/installed',
  'manifest-mode vcpkg install and export must use the same explicit writable root')
-- The deliberately contested SDK verification is expected to throw.
local okToVerify = pcall(depsModule.verify, sdkVerifyOptions)
check(not okToVerify, 'dependency verification must respect a concurrent SDK export lock')
sdkLock:unlock()


local function invoke(argv: { string }, cwd: string, env: { [string]: string }?): dream_process_Result
  local result, problem = process.run(binary, argv, { cwd = cwd, env = env, stdout = 'capture', stderr = 'capture' })
  if not result then error('could not start binary: ' .. (problem or 'unknown')) end
  return result
end

local empty = scratch .. '/empty'
util.mkdir(empty)
local dry = invoke({ 'deps', '--dry-run' }, empty)
check(dry.success, 'the standalone executable must plan without a workspace')
check((dry.stdout or ''):find('openmw-forge:alma9', 1, true) ~= nil, 'missing AlmaLinux 9 native image')
check(not fs.exists(empty .. '/work'), 'dry-run must have no write effects')

-- The fake Podman is itself a packed Jess executable, not a shell test shim.
local mockedBin = scratch .. '/bin'
local mockSource = scratch .. '/mock-package'
util.mkdir(mockedBin)
util.mkdir(mockSource .. '/tools')
util.write(mockSource .. '/jess-workspace.toml', 'manifest_version = 1\n[workspace]\nmembers = ["."]\n')
util.write(mockSource .. '/jess.toml', [=[manifest_version = 1
[package]
id = "org.openmw.forge.mock"
version = "0.1.0"
jess_api = "1"
include = ["tools"]
default_target = "mock"
[[layer]]
id = "openmw.forge.mock"
exports = []
[targets.mock]
kind = "command"
command = "podman"
entry = "tools/mock.jsl"
capabilities = ["process.environment", "filesystem.write"]
]=])
util.write(mockSource .. '/tools/mock.jsl', [[--!strict
local fs = require '@dream/fs'
local process = require '@dream/process'
local arguments = { ... }
local destination = process.env('FORGE_MOCK_LOG')
if not destination then error('missing mock command log') end
local recorded, failure = fs.writeFile(destination, table.concat(arguments, '\t') .. '\n', { append = true })
if not recorded then error(failure or 'mock log write failed') end
if process.env('FORGE_MOCK_FAIL') == arguments[1] then error('intentional mock container failure') end
if process.env('FORGE_MOCK_FAIL_MANIFEST') == '1' and arguments[2] == 'upload'
  and arguments[4] and arguments[4]:find('SHA256SUMS', 1, true) then
  error('intentional checksum manifest upload failure')
end

-- Provide a deterministic detached container to test Forge's actual GUI
-- smoke lifecycle without relying on an installed Docker daemon.
if arguments[1] == 'run' and arguments[2] == '--detach' then
  print('abcdef012345')
  return
end
if arguments[1] == 'inspect' and arguments[2] == '--format' then
  print('true:0:false')
  return
end
if arguments[1] == 'logs' then
  print('Qt smoke fixture running')
  return
end
if arguments[1] == 'rm' and arguments[2] == '-f' then return end

if arguments[1] == 'release' and arguments[2] == 'view' then
  if process.env('FORGE_MOCK_GH_MISSING') == '1' and not arguments[4] then
    error('mock release not found')
  end

  if arguments[4] == '--json' then print(process.env('FORGE_MOCK_GH_ASSETS') or '') end
end

if arguments[1] == 'image' and process.env('FORGE_MOCK_IMAGE_PRESENT') == '1' then
  print('sha256:deadc0de')
end
]])
local jessBin = process.env('JESS_BIN') or util.checked('which', { 'jess' }):gsub('%s+$', '')

-- CI invokes Jess by command name, but the standalone packer requires a
-- real filesystem path for --runtime.  Exercise both the PATH-only fallback
-- and an invalid, relative JESS_BIN without relying on the host's shell.
local pathOnlyOutput = scratch .. '/path-only-forge'
local pathOnly, pathFailure = process.run(jessBin, {
  'run', '--trusted', 'tools/release.jsl', pathOnlyOutput,
}, { cwd = root, env = { JESS_BIN = '' }, stdout = 'capture', stderr = 'capture' })
check(pathOnly ~= nil and pathOnly.success and fs.isFile(pathOnlyOutput),
  'standalone release must resolve Jess from PATH when JESS_BIN is absent: '
    .. (pathFailure or (if pathOnly then pathOnly.stderr or '' else '')))
local invalidRuntime = process.run(jessBin, {
  'run', '--trusted', 'tools/release.jsl', scratch .. '/should-not-exist',
}, { cwd = root, env = { JESS_BIN = 'jess' }, stdout = 'capture', stderr = 'capture' })
check(invalidRuntime ~= nil and not invalidRuntime.success and not fs.exists(scratch .. '/should-not-exist'),
  'standalone release must reject a relative JESS_BIN before packing')


util.stream(jessBin, { 'workspace', 'pack', '--workspace', mockSource,
  '--output', mockedBin .. '/podman', '--runtime', jessBin })
-- Exercise the detached GUI container lifecycle without a real daemon.
local mockSmokeLog = scratch .. '/mock-gui-lifecycle.log'
local guiEnv = { FORGE_MOCK_LOG = mockSmokeLog }
local smokeModule = require '@forge/native-smoke'
smokeModule.runDistroCommand(mockedBin .. '/podman', 'smoke:test', '/fixture:/pkg:ro',
  'almalinux-9', 'openmw-launcher', 'openmw-launcher.x86_64', 1, guiEnv)
local smokeLifecycle = util.file(mockSmokeLog)
check(smokeLifecycle:find('run\t--detach', 1, true) ~= nil,
  'GUI smoke must launch a detached container rather than block in docker run')
local launcherRun = smokeLifecycle:match('^[^\n]+')
check(launcherRun ~= nil and launcherRun:find('/pkg/openmw-launcher.x86_64', 1, true) ~= nil
    and launcherRun:find('--help', 1, true) == nil,
  'GUI smoke must launch the actual GUI without an unwanted --help filename')
smokeModule.runDistroCommand(mockedBin .. '/podman', 'smoke:test', '/fixture:/pkg:ro',
  'almalinux-9', 'openmw-cs', 'openmw-cs.x86_64', 1, guiEnv)
local csRun = util.file(mockSmokeLog):match('[^\n]*openmw%-cs%.x86_64[^\n]*')
check(csRun ~= nil and csRun:find('--help', 1, true) == nil,
  'OpenMW-CS GUI smoke must not interpret --help as a missing content file')
check(smokeLifecycle:find('inspect\t--format', 1, true) ~= nil,
  'GUI smoke must poll the container status')
check(smokeLifecycle:find('logs\tabcdef012345', 1, true) ~= nil,
  'GUI smoke must capture startup diagnostics')
check(smokeLifecycle:find('rm\t-f\t-v\tabcdef012345', 1, true) ~= nil,
  'GUI smoke must forcibly clean up its container after bounded startup')

-- The disk reclamation helper must refuse local invocation, preserve unowned
-- checkout content without blocking a valid cached-SDK OpenMW build, and
-- reclaim only its explicitly Forge-owned transient checkout state.
local ciRoot = scratch .. '/ci-workspace'
local ciVcpkg = ciRoot .. '/work/cache/vcpkg'
local ciBinaries = ciRoot .. '/work/cache/vcpkg-binaries'
util.mkdir(ciVcpkg)
util.mkdir(ciBinaries)
util.write(ciVcpkg .. '/KEEP', 'personal data')
local cleanupArgs = { 'run', '--trusted', '--package', root,
  root .. '/tools/ci_resources.jsl', '--before-build' }
local cleanupEnv = { GITHUB_ACTIONS = 'true', GITHUB_WORKSPACE = ciRoot }
local localCleanup = process.run(jessBin, cleanupArgs, { cwd = ciRoot, stdout = 'capture', stderr = 'capture' })
check(localCleanup ~= nil and not localCleanup.success, 'CI cache cleanup must refuse non-GitHub invocation')
local foreignCleanup = process.run(jessBin, cleanupArgs, { cwd = ciRoot, env = cleanupEnv,
  stdout = 'capture', stderr = 'capture' })
check(foreignCleanup ~= nil and foreignCleanup.success,
  'CI cleanup must not abort when a vcpkg mount is unowned')
check(util.file(ciVcpkg .. '/KEEP') == 'personal data', 'rejected cleanup must preserve unowned files')
check(not fs.exists(ciBinaries), 'CI cleanup still reclaims binary cache if vcpkg mount is unowned')

-- An empty directory created by Docker for a cache-hit bind mount has no
-- ownership marker. Preserve it and continue instead of failing at build time.
util.remove(ciVcpkg)
util.mkdir(ciVcpkg)
local emptyCleanup = process.run(jessBin, cleanupArgs, { cwd = ciRoot, env = cleanupEnv,
  stdout = 'capture', stderr = 'capture' })
check(emptyCleanup ~= nil and emptyCleanup.success and fs.isDir(ciVcpkg),
  'empty unowned Docker mount must not abort a cached-SDK build')

-- A forged marker reached via a .git symlink must never authorize deletion.
local outside = scratch .. '/unowned-git'
util.mkdir(outside)
util.write(outside .. '/forge-owner', 'openmw-forge-vcpkg-v1\n')
local linked, linkedFailure = fs.symlink(outside, ciVcpkg .. '/.git')
if not linked then error('cannot create marker symlink fixture: ' .. (linkedFailure or 'unknown')) end

local linkedCleanup = process.run(jessBin, cleanupArgs, { cwd = ciRoot, env = cleanupEnv,
  stdout = 'capture', stderr = 'capture' })
check(linkedCleanup ~= nil and linkedCleanup.success and fs.lstat(ciVcpkg .. '/.git') ~= nil,
  'symlinked ownership marker must not authorize cleanup')
util.remove(ciVcpkg .. '/.git')
util.mkdir(ciBinaries)
util.mkdir(ciVcpkg .. '/.git')
util.write(ciVcpkg .. '/.git/forge-owner', 'openmw-forge-vcpkg-v1\n')
local permittedCleanup = process.run(jessBin, cleanupArgs, { cwd = ciRoot, env = cleanupEnv,
  stdout = 'capture', stderr = 'capture' })
check(permittedCleanup ~= nil and permittedCleanup.success,
  'CI-only cleanup must remove correctly owned transient dependencies')
check(not fs.exists(ciVcpkg) and not fs.exists(ciBinaries),
  'CI-only cleanup should release vcpkg disk space after successful SDK publication')

local mockLog = scratch .. '/mock.log'
local mockEnv = {
  PATH = mockedBin .. ':' .. (fs.parent(jessBin) or '') .. ':' .. (process.env('PATH') or ''),
  FORGE_MOCK_LOG = mockLog,
}
-- A fake Docker backend verifies that host identity is substituted by the
-- actual executable at runtime, while the pure planner retains a placeholder.
util.copy(mockedBin .. '/podman', mockedBin .. '/docker')
util.write(mockLog, '')
local dockerRun = invoke({ 'deps', '--engine', 'docker' }, empty, mockEnv)
check(dockerRun.success, 'Docker build worker plan must execute: ' .. (dockerRun.stderr or ''))
local hostUid = util.checked('id', { '-u' }):match('^(%d+)')
local hostGid = util.checked('id', { '-g' }):match('^(%d+)')
local dockerLog = util.file(mockLog)
check(hostUid ~= nil and hostGid ~= nil
  and dockerLog:find('\t--user\t' .. hostUid .. ':' .. hostGid .. '\t', 1, true) ~= nil,
  'Docker worker must use the invoking host account for writable volumes')
check(dockerLog:find('HOME=/tmp', 1, true) ~= nil,
  'unprivileged container workers must have a writable HOME')
check(dockerLog:find('PIP_USER=1', 1, true) == nil,
  'container workers must not force user-site pip installs inside vcpkg virtualenvs')
check(vcpkgPython.addEnvironment({ PIP_USER = '1' }, '/forge/work/vcpkg/.forge-python-wheels').PIP_USER == '0',
  'vcpkg Python must defeat an inherited pip user-install setting')

local launched = invoke({ 'deps' }, empty, mockEnv)
check(launched.success, 'compiled executable must run two mock container commands: ' .. (launched.stderr or ''))
check(fs.isFile(empty .. '/work/forge-assets/Dockerfile'), 'compiled executable must materialize the image Dockerfile')
check(util.file(empty .. '/work/forge-assets/Dockerfile'):find('autoconf-2.72', 1, true) ~= nil,
  'builder image must provision Autoconf 2.72 as a cached Docker layer')
-- AlmaLinux 9 already installs curl-minimal. Installing full curl alongside it
-- fails DNF transaction resolution and must never recur in the packed ELF.
local imageRecipe = util.file(empty .. '/work/forge-assets/Dockerfile')
local packageLine = imageRecipe:match('RUN dnf install %-y git ([^\n]+)') or ''
local minimalCurl = false
local conflictingCurl = false
for package in packageLine:gmatch('%S+') do
  if package == 'curl-minimal' then minimalCurl = true end
  if package == 'curl' then conflictingCurl = true end
end
check(minimalCurl and not conflictingCurl,
  'builder image must use curl-minimal, not the conflicting full curl RPM')
check(fs.isFile(empty .. '/work/forge-assets/deps/vcpkg.json'), 'compiled executable must materialize vcpkg assets')
local embedded = empty .. '/work/forge-assets/forge'
check(fs.isFile(embedded), 'container context must carry self-contained compiled binary')
local embeddedHelp, why = process.run(embedded, { 'help' }, { stdout = 'capture', stderr = 'capture' })
check(embeddedHelp ~= nil and embeddedHelp.success and (embeddedHelp.stdout or ''):find('OpenMW Forge', 1, true) ~= nil, 'container context copy must be a runnable Forge command: ' .. (why or ''))
local embeddedStat = fs.stat(embedded)
local originalStat = fs.stat(binary)
check(embeddedStat ~= nil and originalStat ~= nil and embeddedStat.size == originalStat.size, 'container binary copy should match original size')
local log = util.file(mockLog)
check(log:find('build\t', 1, true) ~= nil, 'first container command must build image')
check(log:find('run\t', 1, true) ~= nil and log:find('__deps', 1, true) ~= nil, 'second container command must invoke the native worker')
check(log:find('openmw-forge:alma9-', 1, true) ~= nil, 'image identity must include builder input fingerprints')
local cachedEnv = table.clone(mockEnv)
cachedEnv.FORGE_MOCK_IMAGE_PRESENT = '1'
util.write(mockLog, '')
local cachedRun = invoke({ 'deps' }, empty, cachedEnv)
check(cachedRun.success, 'second compiled invocation should reuse a verified matching builder image')
local cachedLog = util.file(mockLog)
check(cachedLog:find('image\tinspect', 1, true) ~= nil, 'must query for matching image')
check(cachedLog:find('build\t', 1, true) == nil, 'matching image must skip redundant build')
check(cachedLog:find('run\t', 1, true) ~= nil, 'cached image must still execute the worker')


-- A published toolchain digest eliminates per-run DNF/Autoconf image layers.
-- The fallback still embeds its full reproducible build recipe.
local pinnedEnv = table.clone(mockEnv)
local pinnedImage = 'ghcr.io/example/openmw-forge-builder@sha256:' .. string.rep('a', 64)
pinnedEnv.FORGE_TOOLCHAIN_IMAGE = pinnedImage
pinnedEnv.FORGE_TOOLCHAIN_ID = pinnedImage
util.write(mockLog, '')
local pinnedRun = invoke({ 'deps' }, empty, pinnedEnv)
check(pinnedRun.success, 'compiled Forge must accept a digest-pinned toolchain image')
local fastRecipe = util.file(empty .. '/work/forge-assets/Dockerfile')
check(fastRecipe:find('FROM ' .. pinnedImage, 1, true) ~= nil,
  'pinned toolchain must become the container FROM line')
check(fastRecipe:find('dnf install', 1, true) == nil,
  'pinned toolchain must skip costly DNF/Autoconf image provisioning')
check(util.file(mockLog):find('FORGE_TOOLCHAIN_ID=' .. pinnedImage, 1, true) ~= nil,
  'dependency worker must receive the exact toolchain digest for cache identity')
local invalidEnv = table.clone(mockEnv)
invalidEnv.FORGE_TOOLCHAIN_IMAGE = 'almalinux:9\nRUN unexpected'
local invalidImage = invoke({ 'deps' }, empty, invalidEnv)
check(not invalidImage.success, 'invalid OCI image references must not permit Dockerfile injection')

local failingEnv = table.clone(mockEnv)
failingEnv.FORGE_MOCK_FAIL = 'run'
local failed = invoke({ 'deps' }, empty, failingEnv)
check(not failed.success, 'container failures must not report build success')

local source = scratch .. '/source'
local build = scratch .. '/build'
local deps = scratch .. '/deps'
local output = scratch .. '/output'
local depsOutput = scratch .. '/deps-output'
for _, path in {
  source, build .. '/resources', deps .. '/openmw-deps/installed/x64-linux-dynamic/lib',
  deps .. '/QT/6.6.3/gcc_64/lib', deps .. '/QT/6.6.3/gcc_64/plugins/platforms', output, depsOutput,
} do util.mkdir(path) end
util.write(source .. '/CMakeLists.txt', 'set(OPENMW_VERSION_MAJOR 0)\nset(OPENMW_VERSION_MINOR 49)\nset(OPENMW_VERSION_RELEASE 0)\n')
-- Compiler cache is actually mounted into the compiled build worker and
-- removable with --no-ccache, not merely mentioned in the CMake arguments.
local mockArchive = scratch .. '/mock-deps.7z'
util.write(mockArchive, 'mock archive - container worker never extracts this fixture')
util.write(mockLog, '')
local caching = invoke({ 'build', '--engine', 'podman', '--source', source,
  '--deps-archive', mockArchive }, empty, mockEnv)
check(caching.success, 'mocked compiled build with persistent ccache must succeed')
check(fs.isDir(empty .. '/work/cache/ccache'), 'compiled planner must create persistent ccache directory')
check(util.file(mockLog):find('/forge/work/ccache', 1, true) ~= nil,
  'compiled container invocation must mount ccache inside the worker')
util.write(mockLog, '')
local withoutCache = invoke({ 'build', '--engine', 'podman', '--source', source,
  '--deps-archive', mockArchive, '--no-ccache' }, empty, mockEnv)
check(withoutCache.success, 'mocked compiled no-ccache build must succeed')
check(util.file(mockLog):find('/forge/work/ccache', 1, true) == nil,
  '--no-ccache must actually omit the compiler-cache volume')

local unsupportedHeadless = invoke({ 'build', '--no-qt' }, empty)
check(not unsupportedHeadless.success and (unsupportedHeadless.stderr or ''):find('--no-qt', 1, true) ~= nil,
  'unsupported Qt-less builds must be rejected at argument parsing')

-- The lock coordinator must never create work/locks inside a user-owned
-- checkout before discovering that the build output overlaps that checkout.
local unsafeCheckout = scratch .. '/unsafe-source-root'
util.mkdir(unsafeCheckout)
util.write(unsafeCheckout .. '/CMakeLists.txt', 'project(OpenMWFixture)\n')
local unsafeInvocation = invoke({ 'build', '--mode', 'local', '--source', unsafeCheckout }, unsafeCheckout)
check(not unsafeInvocation.success, 'source-overlap preflight must fail')
check(not fs.lstat(unsafeCheckout .. '/work'),
  'source overlap must be rejected without creating even a lock directory inside the checkout')

-- Two invocations targeting one CMake tree must not race a cleanup/package.
local earlyHome = process.env('HOME')
if not earlyHome then error('HOME required for lock test') end
local lockDirectory = earlyHome .. '/.cache/openmw-forge/locks'
util.mkdir(lockDirectory)
local sharedBuildLock, lockProblem = fs.lock(lockDirectory .. '/resource-'
  .. sourceModule.key(empty .. '/work/build') .. '.lock')
if not sharedBuildLock then error(lockProblem or 'cannot lock build fixture') end

local contested = invoke({ 'build', '--engine', 'podman', '--source', source,
  '--deps-archive', mockArchive }, empty, mockEnv)
check(not contested.success and (contested.stderr or ''):find('already in use', 1, true) ~= nil,
  'second Forge invocation must refuse a locked CMake tree')
sharedBuildLock:unlock()


util.write(build .. '/openmw', 'mock compiled OpenMW executable\n')
util.write(build .. '/resources/one.txt', 'resource\n')
-- Keep tiny files in the future package stage: debug splitting must never
-- assume that every leaf entry has four bytes available for its ELF check.
util.write(build .. '/resources/empty.bin', '')
util.write(build .. '/resources/three.bin', 'abc')
util.write(deps .. '/openmw-deps/installed/x64-linux-dynamic/lib/libTest.so.1', 'test library')
local qtBase = deps .. '/QT/6.6.3/gcc_64'
local Modules = { 'Core', 'Gui', 'Widgets', 'Network', 'OpenGL', 'OpenGLWidgets', 'Svg', 'Qml', 'Quick' }
for _, module in Modules do
  util.mkdir(qtBase .. '/lib/cmake/Qt6' .. module)
  util.copy('/bin/true', qtBase .. '/lib/libQt6' .. module .. '.so.6.6.3')
  util.write(qtBase .. '/lib/cmake/Qt6' .. module .. '/Qt6' .. module .. 'Config.cmake', '# Qt fixture')
end
util.mkdir(qtBase .. '/lib/cmake/Qt6LinguistTools')
util.write(qtBase .. '/lib/cmake/Qt6LinguistTools/Qt6LinguistToolsConfig.cmake', '# Qt fixture')
util.mkdir(qtBase .. '/lib/cmake/Qt6')
util.write(qtBase .. '/lib/cmake/Qt6/Qt6Config.cmake', '# Qt fixture')
util.copy('/bin/true', qtBase .. '/plugins/platforms/libqxcb.so')
local qtOptions, qtReason = argsModule.parse({ 'package', '--deps-prefix', deps }, empty)
if not qtOptions then error(qtReason or 'could not create Qt fixture options') end
-- Regression for the CI crash at /forge/aqtinstall.log: aqtinstall's
-- relative logfile must land in the Forge-owned, writable staging directory.
local qtStaging = deps .. '/qt-install-staging'
util.resetManaged(qtStaging)
local installer = nativeQt.aqtInvocation(qtOptions, qtStaging)
check(installer.cwd == qtStaging, 'aqt must run inside the writable Qt staging directory')
check(installer.argv[#installer.argv] == qtStaging, 'aqt archive output must match Qt staging directory')
local logProbe, logProblem = process.run('touch', { 'aqtinstall.log' }, {
  cwd = installer.cwd, stdout = 'capture', stderr = 'capture',
})
check(logProbe ~= nil and logProbe.success, 'aqt working directory must support relative log creation: '
  .. (logProblem or (if logProbe then logProbe.stderr or '' else 'unknown')))
check(fs.isFile(qtStaging .. '/aqtinstall.log'), 'relative aqtinstall.log must be writable inside staging')
util.remove(qtStaging)
check(nativeQt.qualified(qtOptions), 'complete externally supplied Qt installation must be usable')
local svgLibrary = qtBase .. '/lib/libQt6Svg.so.6.6.3'
util.remove(svgLibrary)
check(not nativeQt.qualified(qtOptions), 'Qt cache must reject missing non-Core modules')
util.write(svgLibrary, 'CORRUPTED')
check(not nativeQt.qualified(qtOptions), 'Qt cache must reject a corrupt native ELF library')
for size = 0, 3 do
  util.write(svgLibrary, string.rep('Q', size))
  check(not nativeQt.qualified(qtOptions), 'Qt cache must reject a ' .. tostring(size) .. '-byte library without crashing')
end
util.copy('/bin/true', svgLibrary)
local coreLibrary = qtBase .. '/lib/libQt6Core.so.6.6.3'
util.remove(coreLibrary)
check(not nativeQt.qualified(qtOptions), 'Qt lib directory without Core library must not qualify')
util.copy('/bin/true', coreLibrary)
local qtMarker = qtBase .. '/.openmw-forge-managed'
util.write(qtMarker, 'openmw-forge-managed-v1\n')
util.write(qtBase .. '/.forge-qt-id', 'qt=wrong\n')
check(not nativeQt.qualified(qtOptions), 'managed Qt cache must reject stale installer/version identity')
util.write(qtBase .. '/.forge-qt-id', nativeQt.identity(qtOptions))
check(nativeQt.qualified(qtOptions), 'managed Qt cache must accept a complete matching installation')

local linked, problem = fs.symlink('libTest.so.1', deps .. '/openmw-deps/installed/x64-linux-dynamic/lib/libTest.so')
if not linked then error(problem or 'cannot create test symlink') end

local result = invoke({
  'package', '--mode', 'local', '--source', source, '--build-dir', build,
  '--deps-prefix', deps, '--output-dir', output, '--deps-output', depsOutput,
  '--stage-only',
}, empty)
check(result.success, 'the compiled executable must stage an existing OpenMW build: ' .. (result.stderr or ''))
local stage = build .. '/package-staging/openmw-0.49.0-Linux-64Bit'
check(fs.isFile(stage .. '/openmw.x86_64'), 'missing staged binary')
check(fs.isFile(stage .. '/openmw'), 'missing installed OpenMW runtime wrapper')
check(fs.isFile(stage .. '/resources/one.txt'), 'missing embedded OpenMW resource')
check(fs.isFile(stage .. '/resources/empty.bin'), 'empty resource must survive staging')
check(fs.isFile(stage .. '/resources/three.bin'), 'short resource must survive staging')
check(fs.lstat(stage .. '/lib/libTest.so') ~= nil, 'vcpkg shared library symlink lost')
check(fs.isFile(stage .. '/plugins/platforms/libqxcb.so'), 'missing Qt plugin tree')
check(fs.isFile(stage .. '/README.packagecontents.txt'), 'embedded package template missing')

-- The pair is compressed completely before either existing artifact changes.
-- A crash after one rename is repaired from a small managed recovery journal.
local pairRoot = scratch .. '/archive-pair'
local PairName = 'openmw-0.49.0-Linux-64Bit'
util.mkdir(build .. '/package-staging-debug/' .. PairName .. '-debug')
util.write(build .. '/package-staging-debug/' .. PairName .. '-debug/README', 'debug symbols fixture')
releaseArtifacts.publish(pairRoot, PairName, build .. '/package-staging',
  build .. '/package-staging-debug', true)
local pairMain = pairRoot .. '/' .. PairName .. '.tar.gz'
local pairDebug = pairRoot .. '/' .. PairName .. '-debug.tar.gz'
check(fs.isFile(pairMain) and fs.isFile(pairDebug), 'both main and debug archives must be published')
-- A main-only publication beside an existing debug sidecar must throw; the fixture continues.
local mainOnlyOk = pcall(releaseArtifacts.publish, pairRoot, PairName, build .. '/package-staging',
  build .. '/package-staging-debug', false)
check(not mainOnlyOk, 'a main-only package must not coexist with a stale matching debug archive')
check(fs.isFile(pairMain) and fs.isFile(pairDebug),
  'rejected main-only publication must preserve the existing complete release pair')
local oldMain = util.file(pairMain)
local oldDebug = util.file(pairDebug)
local pendingPair = pairRoot .. '/.forge-archive-publication'
util.resetManaged(pendingPair)
util.mkdir(pendingPair .. '/previous')
util.write(pendingPair .. '/journal', PairName .. '.tar.gz 1\n' .. PairName .. '-debug.tar.gz 1\n')
local savedMain, backupError = fs.rename(pairMain, pendingPair .. '/previous/' .. PairName .. '.tar.gz')
if not savedMain then error(backupError or 'cannot stage interrupted main archive') end
local savedDebug, debugBackupError = fs.rename(pairDebug, pendingPair .. '/previous/' .. PairName .. '-debug.tar.gz')
if not savedDebug then error(debugBackupError or 'cannot stage interrupted debug archive') end
util.write(pairMain, 'interrupted new main file')
releaseArtifacts.recover(pairRoot)
check(util.file(pairMain) == oldMain and util.file(pairDebug) == oldDebug,
  'publication recovery must restore the previous complete main/debug pair')
check(not fs.exists(pendingPair), 'archive recovery must retire its transaction directory')


-- A valid tarball from the staged tree should pass the actual compiled smoke CLI.
util.copy('/usr/bin/true', stage .. '/openmw.x86_64')
util.stream('chmod', { '+x', stage .. '/openmw.x86_64' })
local valid = scratch .. '/valid.tar.gz'
util.stream('tar', { 'czf', valid, '-C', build .. '/package-staging', 'openmw-0.49.0-Linux-64Bit' })
local accepted = invoke({ 'smoke', '--archive', valid }, empty)
check(accepted.success, 'valid synthetic ELF tarball must pass the native smoke CLI: ' .. (accepted.stderr or ''))

-- OpenMW's bsatool, esmtool and niftest return exit 1 for --help even when
-- functioning correctly. The packaged binaries and their launchers must be
-- accepted only if the correct tool-specific help banner was printed.
local LegacyHelp = {
  { 'bsatool', 'Inspect and extract files from Bethesda BSA archives' },
  { 'esmtool', 'Inspect and extract from Morrowind ES files' },
  { 'niftest', 'Ensure that OpenMW can use the provided NIF' },
}

for _, fixture in LegacyHelp do
  local tool, banner = fixture[1], fixture[2]
  util.write(stage .. '/' .. tool .. '.x86_64', '#!/bin/sh\nprintf "%s\\n" "' .. banner .. '"\nexit 1\n')
  util.write(stage .. '/' .. tool,
    '#!/bin/sh\nexec "$(dirname "$0")/' .. tool .. '.x86_64" "$@"\n')
  util.stream('chmod', { '+x', stage .. '/' .. tool .. '.x86_64', stage .. '/' .. tool })
end
local toolHelpArchive = scratch .. '/tool-help.tar.gz'
util.stream('tar', { 'czf', toolHelpArchive, '-C', build .. '/package-staging', 'openmw-0.49.0-Linux-64Bit' })
local toolHelp = invoke({ 'smoke', '--archive', toolHelpArchive }, empty)
check(toolHelp.success, 'legitimate exit-one tool help and wrappers must pass smoke: ' .. (toolHelp.stderr or ''))
check((toolHelp.stdout or ''):find('PASS smoke binary + launcher niftest', 1, true) ~= nil,
  'bsatool, esmtool and niftest must all complete their binary and launcher checks')

-- An arbitrary exit 1 must never be mistaken for valid help, even for bsatool.
util.write(stage .. '/bsatool.x86_64', '#!/bin/sh\nexit 1\n')
local bogusHelpArchive = scratch .. '/bogus-tool-help.tar.gz'
util.stream('tar', { 'czf', bogusHelpArchive, '-C', build .. '/package-staging', 'openmw-0.49.0-Linux-64Bit' })
local bogusHelp = invoke({ 'smoke', '--archive', bogusHelpArchive }, empty)
check(not bogusHelp.success and (bogusHelp.stderr or ''):find('smoke bsatool.x86_64 exited with 1', 1, true) ~= nil,
  'smoke must reject exit 1 without the tool-specific help response')
for _, fixture in LegacyHelp do
  util.remove(stage .. '/' .. fixture[1] .. '.x86_64')
  util.remove(stage .. '/' .. fixture[1])
end

-- Smoke runs unpack into a shared managed root; a second process must wait
-- rather than deleting the first run's extracted package or Dockerfiles.
local smokeGuard, smokeError = fs.lock(empty .. '/work/.forge-smoke.lock')
if not smokeGuard then error(smokeError or 'cannot guard smoke fixture') end

local collidedSmoke = invoke({ 'smoke', '--archive', valid }, empty)
check(not collidedSmoke.success and (collidedSmoke.stderr or ''):find('already in use', 1, true) ~= nil,
  'smoke workspace must be exclusive across Forge processes')
smokeGuard:unlock()

local missingQt = invoke({ 'smoke', '--archive', valid, '--with-qt' }, empty)
check(not missingQt.success, 'Qt release check must reject a package without a Qt launcher')
check((missingQt.stderr or ''):find('required OpenMW Qt launcher', 1, true) ~= nil,
  'Qt smoke test must explain missing GUI launcher')

local pathArchive = scratch .. '/traversal.tar.gz'
util.stream('tar', { 'czf', pathArchive, '--transform=s#^openmw-0.49.0-Linux-64Bit#../escape#',
  '-C', build .. '/package-staging', 'openmw-0.49.0-Linux-64Bit' })
local traversal = invoke({ 'smoke', '--archive', pathArchive }, empty)
check(not traversal.success, 'compiled executable must reject parent-directory tar members')

local absoluteArchive = scratch .. '/absolute.tar.gz'
util.stream('tar', { 'czf', absoluteArchive, '--transform=s#^openmw-0.49.0-Linux-64Bit#/root/escape#',
  '-C', build .. '/package-staging', 'openmw-0.49.0-Linux-64Bit' })
local absolute = invoke({ 'smoke', '--archive', absoluteArchive }, empty)
check(not absolute.success, 'compiled executable must reject absolute tar members')

local archiveSource = scratch .. '/malicious'
util.mkdir(archiveSource)
local unsafeLink, unsafeError = fs.symlink('../../../escape', archiveSource .. '/escape')
if not unsafeLink then error(unsafeError or 'cannot create test archive link') end
local tarball = scratch .. '/unsafe.tar.gz'
util.stream('tar', { 'czf', tarball, '-C', scratch, 'malicious' })
local unsafeRoot = scratch .. '/unsafe-cwd'
util.mkdir(unsafeRoot)
local rejected = invoke({ 'smoke', '--archive', tarball }, unsafeRoot)
check(not rejected.success, 'compiled executable must reject escaping symlinks before tar extraction')
check(not fs.isDir(unsafeRoot .. '/work/forge-smoke'), 'rejected archive must not be unpacked')

-- Historical P0 regression: --clean must not erase an unowned build directory.
local victim = scratch .. '/victim'
util.mkdir(victim)
util.write(victim .. '/KEEP.txt', 'do not delete me')
local destructive = invoke({
  'build', '--mode', 'local', '--source', source, '--build-dir', victim,
  '--no-prepare', '--clean',
}, empty)
check(not destructive.success, 'cleaning an unowned directory must fail')
check(fs.isFile(victim .. '/KEEP.txt'), 'failed clean must retain unrelated user files')
check((destructive.stderr or ''):find('refusing --clean', 1, true) ~= nil, 'clean must explain ownership failure')

-- Historical false-green regression: a launcher is not the OpenMW binary.
local missingMain = scratch .. '/missing-main.tar.gz'
local originalMain = stage .. '/openmw.x86_64'
local swapped = stage .. '/openmw-launcher.x86_64'
util.copy(originalMain, swapped)
util.remove(originalMain)
util.stream('tar', { 'czf', missingMain, '-C', build .. '/package-staging', 'openmw-0.49.0-Linux-64Bit' })
local noMain = invoke({ 'smoke', '--archive', missingMain }, empty)
check(not noMain.success, 'an archive without openmw must never pass smoke')
check((noMain.stderr or ''):find('required OpenMW executable', 1, true) ~= nil,
  'smoke must identify missing mandatory executable')
util.copy(swapped, originalMain)

-- Relative POSIX symlink launchers must resolve relative to the link, not CWD.
local launcherBin = build .. '/test-bin'
util.mkdir(launcherBin)
local linkedLauncher, linkedError = fs.symlink('../package-staging/openmw-0.49.0-Linux-64Bit/openmw', launcherBin .. '/openmw')
if not linkedLauncher then error(linkedError or 'cannot create launcher symlink fixture') end
local linkedRun, linkedRunError = process.run(launcherBin .. '/openmw', { '--help' }, { cwd = empty, stdout = 'capture', stderr = 'capture' })
if not linkedRun then error(linkedRunError or 'failed to invoke linked launcher') end
check(linkedRun.success, 'packaged OpenMW launcher must work through a relative symlink from another CWD')

-- A valid raw ELF with a broken user-facing POSIX launcher must fail smoke.
util.write(stage .. '/openmw', '#!/bin/sh\nexit 37\n')
util.stream('chmod', { '+x', stage .. '/openmw' })
local brokenWrapper = scratch .. '/broken-wrapper.tar.gz'
util.stream('tar', { 'czf', brokenWrapper, '-C', build .. '/package-staging', 'openmw-0.49.0-Linux-64Bit' })
local wrapperFailure = invoke({ 'smoke', '--archive', brokenWrapper }, empty)
check(not wrapperFailure.success, 'broken installed launcher must fail smoke')
check((wrapperFailure.stderr or ''):find('launcher exited with 37', 1, true) ~= nil,
  'smoke must expose packaged launcher exit status')

-- Publication must not replace a known-good tarball on tar failure.
local existingArtifact = output .. '/openmw-0.49.0-Linux-64Bit.tar.gz'
util.write(existingArtifact, 'previous-good-archive')
util.copy(mockedBin .. '/podman', mockedBin .. '/tar')
local tarFailEnv = table.clone(mockEnv)
tarFailEnv.FORGE_MOCK_FAIL = 'czf'
local publication = invoke({
  'package', '--mode', 'local', '--source', source, '--build-dir', build,
  '--deps-prefix', deps, '--output-dir', output, '--deps-output', depsOutput,
  '--build-type', 'Debug', '--no-compat', '--no-smoke',
}, empty, tarFailEnv)
check(not publication.success, 'tar compression error must fail the package')
check(util.file(existingArtifact) == 'previous-good-archive', 'failed tar must retain previous artifact')

-- Actual Git, not a mocked Git command: rewrite an HTTPS fixture URL to a
-- temporary local repository for a fully offline fork/ref checkout test.
local upstream = scratch .. '/upstream'
local checkoutCwd = scratch .. '/checkout-cwd'
util.mkdir(upstream)
util.mkdir(checkoutCwd)
util.stream('git', { 'init', '-b', 'main', upstream })
util.write(upstream .. '/CMakeLists.txt', 'set(OPENMW_VERSION_MAJOR 0)\nset(OPENMW_VERSION_MINOR 49)\nset(OPENMW_VERSION_RELEASE 0)\n')
util.stream('git', { '-C', upstream, 'add', '.' })
util.stream('git', { '-C', upstream, '-c', 'user.name=Forge Fixture', '-c', 'user.email=fixture@example.invalid',
  'commit', '-m', 'main branch' })
local mainRev = util.checked('git', { '-C', upstream, 'rev-parse', 'HEAD' }):gsub('%s+$', '')
util.stream('git', { '-C', upstream, 'checkout', '-b', 'feature/fork' })
util.write(upstream .. '/CMakeLists.txt', 'set(OPENMW_VERSION_MAJOR 0)\nset(OPENMW_VERSION_MINOR 50)\nset(OPENMW_VERSION_RELEASE 0)\n')
util.stream('git', { '-C', upstream, 'add', '.' })
util.stream('git', { '-C', upstream, '-c', 'user.name=Forge Fixture', '-c', 'user.email=fixture@example.invalid',
  'commit', '-m', 'fork feature' })
local featureRev = util.checked('git', { '-C', upstream, 'rev-parse', 'HEAD' }):gsub('%s+$', '')
local Url = 'https://forge-fixture.invalid/OpenMW.git'
local gitconfig = scratch .. '/fixture-gitconfig'
util.write(gitconfig, '[url "file://' .. upstream .. '"]\n    insteadOf = ' .. Url .. '\n')
local gitEnv = { GIT_CONFIG_GLOBAL = gitconfig, GIT_TERMINAL_PROMPT = '0' }
local checkoutPath = sourceModule.path(checkoutCwd, Url)
local featureRun = invoke({ 'build', '--mode', 'local', '--repo', Url, '--ref', 'feature/fork', '--no-prepare' }, checkoutCwd, gitEnv)
check(not featureRun.success, 'without vcpkg, a real remote checkout should not claim build success')
check(fs.isFile(checkoutPath .. '/CMakeLists.txt'), 'managed checkout must fetch OpenMW CMake source')
check(util.file(checkoutPath .. '/.git/forge-revision') == featureRev .. '\n', 'feature branch must resolve exact SHA')
check(util.file(checkoutPath .. '/CMakeLists.txt'):find('MINOR 50', 1, true) ~= nil, 'feature branch contents missing')
local mainRun = invoke({ 'build', '--mode', 'local', '--repo', Url, '--ref', 'main', '--no-prepare' }, checkoutCwd, gitEnv)
check(not mainRun.success, 'missing vcpkg must still fail after switching branches')
check(util.file(checkoutPath .. '/.git/forge-revision') == mainRev .. '\n', 'branch switch must resolve main commit')
check(util.file(checkoutPath .. '/CMakeLists.txt'):find('MINOR 49', 1, true) ~= nil, 'main branch contents missing')

-- Different forks and branches cannot accidentally reuse one CMake build root.
local featurePlan = invoke({ 'build', '--repo', Url, '--ref', 'feature/fork', '--dry-run' }, checkoutCwd)
local mainPlan = invoke({ 'build', '--repo', Url, '--ref', 'main', '--dry-run' }, checkoutCwd)
check(featurePlan.success and mainPlan.success, 'both refs must plan without side effects')
check(featurePlan.stdout ~= mainPlan.stdout, 'separate remote refs must produce distinct plans')

local currentSource, canonicalError = fs.canonicalize(checkoutPath)
if not currentSource then error(canonicalError or 'cannot canonicalize fixture source') end
local home = process.env('HOME')
if not home then error('HOME required for locks') end
local sourceLocks = home .. '/.cache/openmw-forge/locks'
util.mkdir(sourceLocks)
local guardedSource, sourceLockError = fs.lock(sourceLocks .. '/resource-' .. sourceModule.key(currentSource) .. '.lock')
if not guardedSource then error(sourceLockError or 'cannot lock source fixture') end
local conflicting = invoke({ 'build', '--repo', Url, '--ref', 'feature/fork', '--no-prepare' }, checkoutCwd, gitEnv)
check(not conflicting.success and (conflicting.stderr or ''):find('resource already in use', 1, true) ~= nil,
  'source checkout lock must cover the entire managed fork build, not just Git fetch')
check(util.file(checkoutPath .. '/.git/forge-revision') == mainRev .. '\n',
  'contested fork build must leave the selected source revision unchanged')
guardedSource:unlock()


-- A different caller root cannot bypass a lock for the same absolute build tree.
local canonicalBuild, buildCanonFailure = fs.canonicalize(build)
if not canonicalBuild then error(buildCanonFailure or 'cannot canonicalize shared build') end
local sharedBuildGuard, sharedBuildError = fs.lock(sourceLocks .. '/resource-' .. sourceModule.key(canonicalBuild) .. '.lock')
if not sharedBuildGuard then error(sharedBuildError or 'cannot guard shared build') end
local foreignRoot = scratch .. '/different-caller'
util.mkdir(foreignRoot)
local crossRootBuild = invoke({ 'package', '--mode', 'local', '--source', source,
  '--build-dir', build, '--deps-prefix', deps, '--deps-output', depsOutput, '--output-dir', output,
  '--stage-only' }, foreignRoot)
check(not crossRootBuild.success and (crossRootBuild.stderr or ''):find('resource already in use', 1, true) ~= nil,
  'different caller roots must contend on the same canonical build path')
sharedBuildGuard:unlock()

local remoteStage = invoke({ 'package', '--mode', 'local', '--repo', Url, '--ref', 'main',
  '--build-dir', build, '--deps-prefix', deps, '--deps-output', depsOutput, '--output-dir', output,
  '--stage-only' }, checkoutCwd, gitEnv)
check(remoteStage.success, 'remote OpenMW commit must package with provenance: ' .. (remoteStage.stderr or ''))
local remotePackage = build .. '/package-staging/openmw-0.49.0-g' .. mainRev:sub(1, 12) .. '-Linux-64Bit'
check(fs.isFile(remotePackage .. '/FORGE_BUILD_SOURCE.txt'), 'managed source must embed revision provenance')
check(util.file(remotePackage .. '/FORGE_BUILD_SOURCE.txt'):find(mainRev, 1, true) ~= nil,
  'package provenance must contain the resolved full SHA')

util.write(checkoutPath .. '/CMakeLists.txt', 'local uncommitted edits')
local dirty = invoke({ 'build', '--mode', 'local', '--repo', Url, '--ref', 'feature/fork', '--no-prepare' }, checkoutCwd, gitEnv)
check(not dirty.success, 'managed checkout must refuse to discard local changes')
check(util.file(checkoutPath .. '/CMakeLists.txt') == 'local uncommitted edits',
  'source checkout must retain locally modified files after failed switch')

-- Unowned staging and smoke scratch trees are never implicitly replaced.
local foreignBuild = scratch .. '/foreign-build'
util.mkdir(foreignBuild .. '/resources')
util.mkdir(foreignBuild .. '/package-staging')
util.write(foreignBuild .. '/openmw', 'test')
util.write(foreignBuild .. '/resources/one.txt', 'test')
util.write(foreignBuild .. '/package-staging/KEEP.txt', 'sacred')
local foreignPackage = invoke({ 'package', '--mode', 'local', '--source', source,
  '--build-dir', foreignBuild, '--deps-prefix', deps, '--deps-output', depsOutput,
  '--output-dir', output, '--stage-only' }, empty)
check(not foreignPackage.success, 'packaging must refuse unowned staging trees')
check(fs.isFile(foreignBuild .. '/package-staging/KEEP.txt'), 'staging refusal must preserve the unowned directory')

-- An internal worker is not entitled to write through a symlinked source
-- alias merely because its lexical paths look disjoint.
local srcAlias = scratch .. '/alias-to-source'
local madeAlias, aliasFailure = fs.symlink(source, srcAlias)
if not madeAlias then error(aliasFailure or 'cannot create source alias') end
local hiddenBuild = source .. '/hidden-in-source'
local rejectedInternal = invoke({ '__package', '--source', source,
  '--build-dir', srcAlias .. '/hidden-in-source', '--deps-prefix', deps,
  '--deps-output', depsOutput, '--output-dir', output, '--stage-only' }, empty)
check(not rejectedInternal.success and (rejectedInternal.stderr or ''):find('overlaps OpenMW source', 1, true) ~= nil,
  'internal package must enforce canonical source protection before staging')
check(not fs.exists(hiddenBuild), 'internal worker rejection must not create source build files')

local foreignCwd = scratch .. '/foreign-cwd'
util.mkdir(foreignCwd .. '/work/forge-smoke')
util.write(foreignCwd .. '/work/forge-smoke/KEEP.txt', 'sacred')
local foreignSmoke = invoke({ 'smoke', '--archive', valid }, foreignCwd)
check(not foreignSmoke.success, 'smoke must not overwrite an unowned scratch directory')
check(fs.isFile(foreignCwd .. '/work/forge-smoke/KEEP.txt'), 'smoke refusal must preserve unrelated files')

-- Emulate the write-privileged GitHub publisher with a Jess-compiled fake gh.
-- The build runner never receives a release-capable token; this checks the
-- transfer boundary, expected checksum set and provenance binding offline.
util.copy(mockedBin .. '/podman', mockedBin .. '/gh')
local releaseDir = scratch .. '/release-candidate'
util.mkdir(releaseDir)
local fakeRevision = string.rep('a', 40)
local releaseName = 'openmw-0.53.0-g' .. fakeRevision:sub(1, 12) .. '-Linux-64Bit'
local releaseMain = releaseDir .. '/' .. releaseName .. '.tar.gz'
local releaseDebug = releaseDir .. '/' .. releaseName .. '-debug.tar.gz'
util.copy(valid, releaseMain)
util.copy(valid, releaseDebug)
local sourceNotes = releaseDir .. '/SOURCE.txt'
local sourceText = 'OpenMW repository: https://gitlab.com/OpenMW/openmw.git\n'
  .. 'OpenMW requested ref: master\nOpenMW resolved SHA: ' .. fakeRevision .. '\n'
util.write(sourceNotes, sourceText)
local checksumLines: { string } = {}
for _, path in { releaseMain, releaseDebug, sourceNotes } do
  local hash = util.checked('sha256sum', { path }):match('^([0-9a-f]+)')
  if not hash then error('could not hash release fixture') end
  table.insert(checksumLines, hash .. '  ' .. (fs.fileName(path) or ''))
end

util.write(releaseDir .. '/SHA256SUMS', table.concat(checksumLines, '\n') .. '\n')

local publisherEnv = table.clone(mockEnv)
publisherEnv.GITHUB_ACTIONS = 'true'
publisherEnv.GH_TOKEN = 'fixture-only-not-a-secret'
local function publishFixture(env: { [string]: string }): dream_process_Result
  local result, failure = process.run(jessBin, { 'run', '--trusted', '--package', '.',
    'tools/uberbranch.jsl', '--publish-artifacts', releaseDir }, {
    cwd = root, env = env, stdout = 'capture', stderr = 'capture',
  })

  if not result then error('failed to invoke publisher: ' .. (failure or '')) end
  return result
end

local withoutToken = table.clone(publisherEnv)
withoutToken.GH_TOKEN = ''
check(not publishFixture(withoutToken).success, 'publisher must require a release-capable token')
util.write(mockLog, '')
local published = publishFixture(publisherEnv)
check(published.success, 'verified release candidate should reach fake gh: ' .. (published.stderr or ''))
local releaseLog = util.file(mockLog)
check(releaseLog:find('release\tupload\tdas-uberbranch', 1, true) ~= nil,
  'publisher must upload the validated artifacts to das-uberbranch')

local updatingEnv = table.clone(publisherEnv)
updatingEnv.FORGE_MOCK_GH_ASSETS = 'openmw-0.50.0-Linux-64Bit.tar.gz\nopenmw-0.50.0-Linux-64Bit-debug.tar.gz\nKEEP.bin'
util.write(mockLog, '')
local updated = publishFixture(updatingEnv)
check(updated.success, 'rolling prerelease must replace old qualified archives')
local updateLog = util.file(mockLog)
check(updateLog:find('release\tdelete-asset\tdas-uberbranch\topenmw-0.50.0-Linux-64Bit.tar.gz', 1, true) ~= nil,
  'rolling release must prune old main archives')
check(updateLog:find('release\tdelete-asset\tdas-uberbranch\topenmw-0.50.0-Linux-64Bit-debug.tar.gz', 1, true) ~= nil,
  'rolling release must prune matching old debug archives')
check(updateLog:find('KEEP.bin', 1, true) == nil,
  'rolling release must preserve unrelated release assets')

local failedManifestEnv = table.clone(publisherEnv)
failedManifestEnv.FORGE_MOCK_FAIL_MANIFEST = '1'
util.write(mockLog, '')
local failedManifest = publishFixture(failedManifestEnv)
check(not failedManifest.success, 'checksum completion marker upload failure must fail publication')
check(util.file(mockLog):find('release\tdelete-asset', 1, true) == nil,
  'publication must never prune old assets before checksum completion marker succeeds')

local initialEnv = table.clone(publisherEnv)
initialEnv.FORGE_MOCK_GH_MISSING = '1'
util.write(mockLog, '')
local created = publishFixture(initialEnv)
check(created.success, 'publisher should create a new prerelease when it does not exist')
check(util.file(mockLog):find('release\tcreate\tdas-uberbranch', 1, true) ~= nil,
  'new rolling release must be created with the configured tag')

util.write(mockLog, '')
util.write(releaseMain, 'tampered after build')
local tampered = publishFixture(publisherEnv)
check(not tampered.success, 'publisher must reject a tampered tarball')
check(util.file(mockLog) == '', 'tampered tarball must never reach gh')
util.copy(valid, releaseMain)
util.write(sourceNotes, sourceText:gsub('master', '../escape'))
local wrongSource = publishFixture(publisherEnv)
check(not wrongSource.success, 'publisher must reject source-ref mismatch')

print(`PASS Jess-native compiled integration: {cases} assertions`)
