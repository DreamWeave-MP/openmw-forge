#!/usr/bin/env -S jess run --trusted --package .
--!strict
local fs = require '@dream/fs'
local process = require '@dream/process'
local args = require '@forge/args'
local planning = require '@forge/plan'
local executor = require '@forge/execute'

local Help = [[
OpenMW Forge — standalone Jess-native AlmaLinux 9 build tool

Usage: openmw-forge COMMAND [OPTIONS]
Commands:
  deps       Build, export and ABI-verify pinned vcpkg dependencies
  build      Prepare, configure, compile, test (optional) and package OpenMW
  pipeline   Build dependencies, then OpenMW, from one invocation
  package    Assemble package from an existing build tree
  verify     Validate an existing dependency export and ABI
  smoke      Smoke test an OpenMW .tar.gz archive
  doctor     Check local prerequisites (no installation)
  help       Print this help

Common switches:
  --source PATH             Existing checkout (never changes Git branch)
  --repo HTTPS|SSH          OpenMW fork URL; use instead of --source
  --ref BRANCH|TAG|SHA      Remote revision with --repo (default: HEAD)
  --mode container|local    Default: container
  --engine podman|docker    Default: podman
  --deps-archive FILE|HTTPS_URL   Existing dependency export (build)
  --deps-sha256 HEX          Required for HTTPS archives; verifies cached data
  --deps-output PATH        Dependency export directory
  --build-dir PATH          CMake build root
  --deps-prefix PATH        Extracted vcpkg and Qt root
  --output-dir PATH         OpenMW packaging output directory
  --jobs N                 Default: 3 (specify machine capacity)
  --triplet NAME            Default: x64-linux-dynamic
  --build-type TYPE         Default: RelWithDebInfo
  --qt-version X.Y.Z        Default: 6.6.3
  --clean --portable --stage-only --run-tests --gtest-filter FILTER
  --no-system-packages --no-prepare --no-ccache
  --no-compat --no-smoke     Opt out of package validation steps
  --cmake-arg ARG           Repeatable
  --distros CSV --with-qt    Smoke test in isolated distro containers
  --dry-run                 Print exact plan; execute nothing

Only AlmaLinux 9 is a supported build baseline. Run the compiled Forge
executable from any directory; no workspace is needed.

Try: forge build --help, forge pipeline --help, forge --version.
]]

local CommandHelp: { [string]: string } = {
  pipeline = [[pipeline: build dependencies, compile OpenMW, test, then package
Usage: forge pipeline (--repo URL --ref REF | --source DIR) [OPTIONS]
  --repo URL --ref REF  Build any HTTPS/SSH fork and Git ref (default ref: HEAD)
  --source DIR         Build an existing checkout without changing its branch
  --engine docker      Use Docker rather than Podman
  --jobs N             Parallel build jobs; --run-tests enables GoogleTests
  --output-dir DIR     Destination for main and debug release tarballs
  --dry-run            Print planned stages without network or filesystem writes
Examples:
  forge pipeline --repo https://gitlab.com/OpenMW/openmw.git --ref master --run-tests
  forge pipeline --source ~/src/openmw --engine docker --jobs 8
]],
  build = [[build: compile and package OpenMW using existing dependencies
Usage: forge build (--source DIR | --repo URL --ref REF) [OPTIONS]
  --deps-archive FILE  Locally exported vcpkg .7z/.tar.xz or verified HTTPS URL
  --deps-sha256 HEX    Required SHA-256 for remote archives
  --no-prepare         Reuse already extracted dependencies and Qt
  --run-tests          Build and execute OpenMW GoogleTests
  --build-dir DIR --deps-prefix DIR --output-dir DIR
  --mode container|local --engine podman|docker --jobs N
]],
  deps = [[deps: compile and export the pinned AlmaLinux 9 vcpkg dependencies
Usage: forge deps [--engine podman|docker] [--jobs N] [--deps-output DIR]
  Uses persistent vcpkg source/download and binary caches. The output is a
  verified .7z dependency export and build metadata in artifacts/deps/.
]],
  package = [[package: assemble a tarball from an existing OpenMW build tree
Usage: forge package --source DIR --build-dir DIR --deps-prefix DIR [OPTIONS]
  Requires built OpenMW binaries, resources, Qt plugins and dependency libs.
  Checks AlmaLinux 9 ELF ABI and exercises packaged launchers by default.
  --stage-only stages files without publishing tarballs.
]],
  verify = [[verify: validate an existing vcpkg dependency export and ABI
Usage: forge verify [--deps-output DIR]
]],
  smoke = [[smoke: validate archive safety, ELF ABI and packaged entry points
Usage: forge smoke --archive FILE [--distros almalinux-9,ubuntu-24.04]
  Both the .x86_64 binary and user-facing POSIX launcher must execute.
  --with-qt additionally tests available OpenMW GUI programs.
]],
  doctor = [[doctor: test the selected build environment, without installing
Usage: forge doctor [--mode container --engine podman|docker | --mode local]
  Local builds require AlmaLinux 9. Container builds require a working engine.
]],
}

local root, cwdError = fs.cwd()
if root == nil then
  error(cwdError or 'cannot read current directory')
end
local raw: { string } = { ... }
local options, parseError = args.parse(raw, root)
if options == nil then
  error(parseError or 'invalid arguments')
end

if options.command == 'help' then
  print(CommandHelp[options.helpFor] or Help)
  return
end

if options.command == 'version' then
  print('OpenMW Forge 0.1.0 | Jess native | AlmaLinux 9')
  return
end

local internalWorker = string.sub(options.command, 1, 2) == '__'
if internalWorker then options.command = string.sub(options.command, 3) end

local function absolute(value: string): string
  if value == '' then
    return value
  end
  local fixed, failure = fs.absolute(value)
  if not fixed then
    error(failure or `cannot resolve {value}`)
  end
  return fixed
end

options.source = absolute(options.source)
options.build = absolute(options.build)
options.deps = absolute(options.deps)
options.output = absolute(options.output)
options.depsOutput = absolute(options.depsOutput)
if options.archive ~= '' and string.sub(options.archive, 1, 8) ~= 'https://' then
  local absolute, failure = fs.absolute(options.archive)
  if absolute == nil then
    error(failure or 'cannot resolve archive path')
  end
  options.archive = absolute
end

local plan, validationError = planning.build(options)
if plan == nil then
  error(validationError or 'invalid build plan')
end

if internalWorker then
  if options.dryRun then error('internal worker commands do not support --dry-run') end
  local safe, reason = executor.executeWorker(options)
  if not safe then error(reason or 'unsafe internal invocation') end
  return
end

if options.dryRun then
  print(`OpenMW Forge | AlmaLinux 9 | {options.mode} | DRY RUN`)
  print(planning.display(plan))
  return
end
local ok, failure = executor.execute(plan, options)
if not ok then
  error(failure or 'build failed')
end
print('OpenMW Forge: completed successfully')
