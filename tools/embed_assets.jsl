#!/usr/bin/env jess
--!strict
-- Regenerate the compile-time asset map from the retained upstream inputs.
local fs = require '@dream/fs'

type Asset = { key: string, text: string }
local assets: { Asset } = {}
local root = fs.cwd()
if not root or not fs.isFile(root .. '/jess.toml') then
  error('run tools/embed_assets.jsl from the OpenMW Forge repository root')
end

local function collect(directory: string, prefix: string, include: (string) -> boolean)
  local files, failure = fs.walk(directory, { include = 'files', sort = true })
  if not files then error(failure or 'cannot inspect vendor directory: ' .. directory) end

  for _, relative in files.paths do
    if not include(relative) then continue end

    local contents, problem = fs.readFileString(directory .. '/' .. relative)
    if not contents then error(problem or 'cannot read vendor input: ' .. relative) end
    table.insert(assets, { key = prefix .. '/' .. relative, text = contents })
  end
end

collect(root .. '/vendor/deps', 'deps', function(path: string): boolean
  return path == 'vcpkg.json' or path:sub(1, 6) == 'ports/' or path:sub(1, 9) == 'triplets/'
end)

collect(root .. '/vendor/openmw', 'openmw', function(path: string): boolean
  return path:sub(1, 10) == 'templates/'
end)

collect(root .. '/vendor/builder', 'builder', function(path: string): boolean
  return path == 'Dockerfile'
end)

table.sort(assets, function(left: Asset, right: Asset): boolean return left.key < right.key end)
local output = {
  '--!strict',
  '-- Generated by tools/embed_assets.jsl. Run that executable after editing vendor inputs.',
  'local files: { [string]: string } = {',
}

for _, asset in assets do
  local delimiter: string? = nil
  for size = 3, 12 do
    local equals = string.rep('=', size)
    if not asset.text:find(']' .. equals .. ']', 1, true) then delimiter = equals break end
  end

  if not delimiter then error('asset cannot be represented safely as a Luau long string: ' .. asset.key) end
  table.insert(output, "  ['" .. asset.key .. "'] = [" .. delimiter .. '[' .. asset.text .. ']' .. delimiter .. '],')
end

table.insert(output, '}')
table.insert(output, 'return table.freeze(files)')
local successful, failure = fs.writeFile(root .. '/src/assets.jsl', table.concat(output, '\n') .. '\n', {
  atomic = true,
})

if not successful then error(failure or 'cannot write src/assets.jsl') end
print(`Embedded {#assets} vendor assets into src/assets.jsl`)
