#!/usr/bin/env -S jess run --trusted --package .
--!strict
local fs = require '@dream/fs'
local process = require '@dream/process'
local source = require '@forge/source'
local uber = require '@forge/uberbranch'
local config = require '@forge/uberbranch-config'
local root, failure = fs.cwd()
if not root then error(failure or 'cannot determine repository root') end
local valid, reason = uber.validate(config)
if not valid or not source.validRepo(config.repository) or not source.validRef(config.ref) then
  error(reason or 'invalid configured upstream release source')
end
local output = process.env('GITHUB_OUTPUT')
if not output or output == '' then error('GITHUB_OUTPUT is required') end
local values = 'repository=' .. config.repository .. '\nref=' .. config.ref .. '\nrelease_tag=' .. config.releaseTag .. '\n'
local ok, problem = fs.writeFile(output, values, { append = true })
if not ok then error(problem or 'cannot write release configuration outputs') end
