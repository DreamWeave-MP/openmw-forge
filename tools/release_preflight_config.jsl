#!/usr/bin/env -S jess run --trusted --package .
--!strict
local fs = require '@dream/fs'
local process = require '@dream/process'
local json = require '@jess/json'
local source = require '@forge/source'
local uber = require '@forge/uberbranch'
local root, failure = fs.cwd()
if not root then error(failure or 'cannot determine repository root') end
local requestedProfile = process.env('FORGE_RELEASE_PROFILE') or 'clockwork'
local profilesValid, profilesFailure = uber.validateProfiles()
if not profilesValid then error(profilesFailure or 'invalid configured release profiles') end
local selected = uber.profile(requestedProfile)
local valid, reason = uber.validate(selected)
if not valid or not source.validRepo(selected.repository) or not source.validRef(selected.ref) then
  error(reason or ('invalid configured release source for profile ' .. requestedProfile))
end

-- Canonical settings: sorted keys, compact. The preflight input fingerprint hashes this
-- exact text, so its byte layout is a contract.
local cmakeArgs: { string } = {}
for _, arg in selected.cmakeArgs do table.insert(cmakeArgs, arg) end

local profileSettingsJson = json.encodeTable {
  schema = 'forge-profile-settings/v1',
  profile = selected.id,
  repository = selected.repository,
  ref = selected.ref,
  release_tag = selected.releaseTag,
  jobs = tostring(selected.jobs),
  distros = selected.distros,
  cmake_args = cmakeArgs,
  features = {
    vulkan = selected.features.vulkan,
    luau = selected.features.luau,
    lua_ui = selected.features.luaUi,
  },
  test_policy = {
    google_tests = selected.testPolicy.googleTests,
    package_smoke = selected.testPolicy.packageSmoke,
    qt_smoke = selected.testPolicy.qtSmoke,
  },
}

if profileSettingsJson == '' then error('release profile settings serialized to empty JSON') end

local output = process.env('GITHUB_OUTPUT')
if not output or output == '' then error('GITHUB_OUTPUT is required') end
local values = 'profile=' .. selected.id .. '\nrepository=' .. selected.repository .. '\nref=' .. selected.ref
  .. '\nrelease_tag=' .. selected.releaseTag .. '\nartifact_namespace=' .. selected.artifactNamespace .. '\nprofile_settings_json=' .. profileSettingsJson .. '\n'
local ok, problem = fs.writeFile(output, values, { append = true })
if not ok then error(problem or 'cannot write release configuration outputs') end
