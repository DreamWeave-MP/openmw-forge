--!strict
local test = require '@jess/test'
local args = require '@forge/args'
local planning = require '@forge/plan'
local profile = require '@forge/config'
local nativeOpenmw = require '@forge/native-openmw'
local nativeArchive = require '@forge/native-archive'
local nativeDeps = require '@forge/native-deps'
local assets = require '@forge/assets'
local source = require '@forge/source'
local uber = require '@forge/uberbranch'
local uberConfig = require '@forge/uberbranch-config'
local suite = test.new()

local Root = '/tmp/forge-root'
local Source = '/tmp/openmw-source'

local function parsed(values: { string }): args.Options
  local result, reason = args.parse(values, Root)
  if not result then error(reason or 'unexpected parse failure') end
  return result
end

local function plan(values: { string }): planning.Plan
  local options = parsed(values)
  local result, failure = planning.build(options)
  if not result then error(failure or 'unexpected planning failure') end
  return result
end

local function fails(values: { string }, reason: string)
  local options, parseError = args.parse(values, Root)
  if not options then
    test.expect(parseError or '').toContain(reason)
    return
  end
  local result, planningError = planning.build(options)
  test.expect(result).toBeNil()
  test.expect(planningError or '').toContain(reason)
end

local function has(values: { string }, wanted: string): boolean
  for _, value in values do
    if value == wanted then return true end
  end
  return false
end

local function shellFree(result: planning.Plan)
  for _, step in result.steps do
    test.expect(step.program == 'bash').toBeFalsy()
    test.expect(step.program == 'sh').toBeFalsy()
    for _, value in step.args do
      test.expect(value == '/builder/scripts/build_binaries.sh').toBeFalsy()
      test.expect(value == 'bash').toBeFalsy()
    end
  end
end

suite.describe('profile and CLI', function()
  suite.it('pins the AlmaLinux 9 ABI contract', function()
    test.expect(profile.image).toBe('almalinux:9')
    test.expect(profile.profile).toBe('alma9')
    test.expect(profile.triplet).toBe('x64-linux-dynamic')
  end)

  suite.it('has built-in help', function()
    test.expect(parsed({}).command).toBe('help')
    test.expect(parsed({ 'help' }).command).toBe('help')
    test.expect(parsed({ '--help' }).command).toBe('help')
    test.expect(parsed({ 'build', '--help' }).helpFor).toBe('build')
    test.expect(parsed({ 'help', 'smoke' }).helpFor).toBe('smoke')
    test.expect(parsed({ '--version' }).command).toBe('version')
  end)

  suite.it('defaults to the container profile', function()
    local options = parsed({ 'deps' })
    test.expect(options.mode).toBe('container')
    test.expect(options.engine).toBe('podman')
    test.expect(options.triplet).toBe(profile.triplet)
    test.expect(options.jobs).toBe(3)
  end)

  suite.it('preserves arbitrary CMake arguments as values', function()
    local options = parsed({ 'build', '--cmake-arg', '-DHELLO=a b', '--cmake-arg=-DX=$HOME' })
    test.expect(options.cmakeArgs).toEqual({ '-DHELLO=a b', '-DX=$HOME' })
  end)

  suite.it('accepts both --flag=value and --flag value', function()
    local options = parsed({ 'build', '--source=/tmp/a', '--jobs', '8', '--engine=docker' })
    test.expect(options.source).toBe('/tmp/a')
    test.expect(options.jobs).toBe(8)
    test.expect(options.engine).toBe('docker')
  end)

  suite.it('rejects unknown commands and flags', function()
    fails({ 'erase' }, 'unknown command')
    fails({ 'deps', '--execute-rm' }, 'unknown option')
  end)

  suite.it('rejects missing and empty options', function()
    fails({ 'deps', '--deps-output' }, 'missing value')
    fails({ 'deps', '--deps-output=' }, 'missing value')
  end)

  suite.it('bounds parallelism', function()
    for _, value in { '0', '-3', '3.14', 'many', '1025' } do
      fails({ 'deps', '--jobs', value }, '--jobs must be an integer')
    end
  end)

  suite.it('allows packed runtime internal phases', function()
    for _, command in { '__deps', '__build', '__package', '__verify', '__smoke' } do
      test.expect(parsed({ command }).command).toBe(command)
    end
  end)
end)

suite.describe('shell-free execution planning', function()
  suite.it('plans dependency build in one Alma 9 container image', function()
    local result = plan({ 'deps' })
    test.expect(#result.steps).toBe(2)
    test.expect(result.steps[1].program).toBe('podman')
    test.expect(has(result.steps[1].args, 'openmw-forge:alma9')).toBeTruthy()
    test.expect(has(result.steps[2].args, '__deps')).toBeTruthy()
    test.expect(has(result.steps[2].args, '/usr/local/bin/openmw-forge')).toBeTruthy()
    shellFree(result)
  end)

  suite.it('forwards dependency build concurrency and clean/preprovisioned flags', function()
    local result = plan({ 'deps', '--jobs', '12', '--no-system-packages', '--clean' })
    test.expect(has(result.steps[2].args, '--jobs')).toBeTruthy()
    test.expect(has(result.steps[2].args, '12')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--no-system-packages')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--clean')).toBeTruthy()
  end)

  suite.it('supports direct Jess-native local dependency builds', function()
    local result = plan({ 'deps', '--mode', 'local' })
    test.expect(#result.steps).toBe(1)
    test.expect(result.steps[1].program).toBe('@forge')
    test.expect(result.steps[1].args[1]).toBe('deps')
    shellFree(result)
  end)

  suite.it('reuses one image for the complete pipeline', function()
    local result = plan({ 'pipeline', '--source', Source })
    test.expect(#result.steps).toBe(3)
    test.expect(has(result.steps[2].args, '__deps')).toBeTruthy()
    test.expect(has(result.steps[3].args, '__build')).toBeTruthy()
    test.expect(has(result.steps[3].args, '/depout/vcpkg-x64-linux-dynamic.7z')).toBeTruthy()
    shellFree(result)
  end)

  suite.it('builds an existing dependency archive in a container', function()
    local result = plan({ 'build', '--source', Source, '--deps-archive', '/tmp/deps.7z' })
    test.expect(#result.steps).toBe(2)
    test.expect(has(result.steps[2].args, '/input/deps.7z')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--deps-archive')).toBeTruthy()
  end)

  suite.it('never silently accepts HTTP artifacts', function()
    fails({ 'build', '--source', Source, '--deps-archive', 'http://example.org/a.7z' }, 'only https')
  end)

  suite.it('forwards an explicit HTTPS archive', function()
    local result = plan({ 'build', '--source', Source, '--deps-archive', 'https://example.org/a.7z', '--deps-sha256', string.rep('a', 64) })
    test.expect(has(result.steps[2].args, 'https://example.org/a.7z')).toBeTruthy()
  end)

  suite.it('preserves untrusted CMake arguments as one argv field', function()
    local value = '-DFLAG=hello; $(touch /tmp/exploit)'
    local result = plan({ 'build', '--source', Source, '--cmake-arg', value })
    test.expect(has(result.steps[2].args, value)).toBeTruthy()
    test.expect(planning.display(result)).toContain("'-DFLAG=hello; $(touch /tmp/exploit)'")
    shellFree(result)
  end)

  suite.it('supports Docker volumes without SELinux label suffixes', function()
    local result = plan({ 'build', '--source', Source, '--engine', 'docker' })
    test.expect(result.steps[2].program).toBe('docker')
    test.expect(has(result.steps[2].args, Source .. ':/src:ro')).toBeTruthy()
    test.expect(has(result.steps[2].args, Source .. ':/src:ro,z')).toBeFalsy()
  end)

  suite.it('labels Podman writable volumes privately', function()
    local result = plan({ 'build', '--source', Source })
    test.expect(has(result.steps[2].args, Root .. '/work/build:/build:Z')).toBeTruthy()
  end)

  suite.it('runs package-only without recompiling', function()
    local result = plan({ 'package', '--source', Source, '--portable', '--no-smoke' })
    test.expect(#result.steps).toBe(2)
    test.expect(has(result.steps[2].args, '__package')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--portable')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--no-smoke')).toBeTruthy()
    shellFree(result)
  end)

  suite.it('forwards independent tests and compatibility options', function()
    local result = plan({ 'build', '--source', Source, '--run-tests', '--gtest-filter', 'MySuite.*', '--no-compat' })
    test.expect(has(result.steps[2].args, '--run-tests')).toBeTruthy()
    test.expect(has(result.steps[2].args, 'MySuite.*')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--no-compat')).toBeTruthy()
  end)

  suite.it('supports reusing prepared dependencies', function()
    local result = plan({ 'build', '--source', Source, '--no-prepare' })
    test.expect(has(result.steps[2].args, '--no-prepare')).toBeTruthy()
    test.expect(has(result.steps[2].args, '/input/deps.7z')).toBeFalsy()
  end)

  suite.it('supports direct local build and package stages', function()
    for _, command in { 'build', 'package' } do
      local result = plan({ command, '--mode', 'local', '--source', Source })
      test.expect(#result.steps).toBe(1)
      test.expect(result.steps[1].program).toBe('@forge')
      test.expect(result.steps[1].args[1]).toBe(command)
    end
  end)

  suite.it('makes verification and smoke tests Jess commands', function()
    local verify = plan({ 'verify' })
    local smoke = plan({ 'smoke', '--archive', '/tmp/a.tar.gz' })
    test.expect(verify.steps[1].program).toBe('@forge')
    test.expect(smoke.steps[1].program).toBe('@forge')
    shellFree(verify)
    shellFree(smoke)
  end)

  suite.it('can select multi-distro smoke profiles', function()
    local result = plan({ 'smoke', '--archive', '/tmp/a.tar.gz', '--distros', 'almalinux-9,debian-12' })
    test.expect(result.steps[1].program).toBe('@forge')
  end)

  suite.it('does not modify anything in doctor or dry-run plans', function()
    local doctor = plan({ 'doctor' })
    test.expect(#doctor.steps).toBe(0)
    test.expect(#doctor.directories).toBe(0)
    local dry = plan({ 'deps', '--dry-run' })
    test.expect(#dry.steps).toBe(2)
  end)
end)

suite.describe('forks, sources, identity and resilient build plans', function()
  suite.it('supports independent managed checkouts for arbitrary HTTPS and SSH forks', function()
    local first = plan({ 'build', '--repo', 'https://github.com/example/OpenMW.git', '--ref', 'feat/custom-renderer' })
    local second = plan({ 'build', '--repo', 'https://github.com/another/OpenMW.git', '--ref', 'main' })
    test.expect(first.steps[1].program).toBe('@forge')
    test.expect(first.steps[1].args[1]).toBe('source')
    test.expect(second.steps[1].args[1]).toBe('source')
    test.expect(first.steps[1].cwd).toBe(Root)
    test.expect(source.path(Root, 'https://github.com/example/OpenMW.git') == source.path(Root, 'https://github.com/another/OpenMW.git')).toBeFalsy()
    test.expect(source.validRepo('git@github.com:example/OpenMW.git')).toBeTruthy()
    test.expect(source.validRepo('ssh://git@git.example/OpenMW.git')).toBeTruthy()
    test.expect(source.validRepo('https://git.example:8443/forks/OpenMW.git')).toBeTruthy()
    test.expect(source.validRef('refs/heads/feat/large-world')).toBeTruthy()
    test.expect(source.validRef('feature/été')).toBeTruthy()
    shellFree(first)
  end)

  suite.it('does not rewrite a user checkout or accept Git argument injection', function()
    fails({ 'build', '--source', Source, '--ref', 'other-branch' }, '--ref requires --repo')
    fails({ 'build', '--source', Source, '--repo', 'https://example.org/openmw.git' }, 'cannot be combined')
    fails({ 'build', '--repo', 'file:///tmp/local.git' }, 'invalid --repo')
    fails({ 'build', '--repo', 'https://example.org/openmw.git', '--ref=--upload-pack=evil' }, 'missing value')
    fails({ 'build', '--repo', 'https://example.org/openmw.git', '--ref', 'foo..bar' }, 'invalid --ref')
    fails({ 'build', '--repo', 'https://example.org/openmw.git', '--ref', 'foo@{1}' }, 'invalid --ref')
    fails({ 'deps', '--repo', 'https://example.org/openmw.git' }, '--repo requires')
  end)

  suite.it('rejects unsigned download plans and propagates verified hash to workers', function()
    fails({ 'build', '--source', Source, '--deps-archive', 'https://example.org/deps.7z' }, 'require --deps-sha256')
    fails({ 'build', '--source', Source, '--deps-archive', 'https://example.org/deps.7z', '--deps-sha256', 'abc' }, '64 hexadecimal')
    fails({ 'build', '--source', Source, '--deps-archive', 'https://example.org/deps.7z', '--deps-sha256', string.rep('x', 64) }, '64 hexadecimal')
    local digest = string.rep('a', 64)
    local item = plan({ 'build', '--source', Source, '--deps-archive', 'https://example.org/deps.7z', '--deps-sha256', digest })
    test.expect(has(item.steps[2].args, '--deps-sha256')).toBeTruthy()
    test.expect(has(item.steps[2].args, digest)).toBeTruthy()
  end)

  suite.it('does not mislabel tar.xz archives as .7z inside containers', function()
    local item = plan({ 'build', '--source', Source, '--deps-archive', '/tmp/deps.tar.xz' })
    test.expect(has(item.steps[2].args, '/input/deps.tar.xz')).toBeTruthy()
    local volumes = table.concat(item.steps[2].args, ' ')
    test.expect(volumes).toContain('/tmp/deps.tar.xz:/input/deps.tar.xz:ro')
  end)

  suite.it('persists vcpkg downloads and compiled binary caches across containers', function()
    local item = plan({ 'deps' })
    local volumes = table.concat(item.steps[2].args, ' ')
    test.expect(volumes).toContain('/work/cache/vcpkg:/forge/work/vcpkg:Z')
    test.expect(volumes).toContain('/work/cache/vcpkg-binaries:/forge/work/vcpkg-binaries:Z')
    test.expect(has(item.steps[2].args, '--no-system-packages')).toBeTruthy()
  end)
end)

suite.describe('path and configuration safety', function()
  suite.it('normalizes path traversals', function()
    test.expect(planning.normalize('/tmp/a/../b//./')).toBe('/tmp/b')
    test.expect(planning.normalize('/../../etc')).toBeNil()
    test.expect(planning.normalize('relative')).toBeNil()
  end)

  suite.it('rejects destructive write roots', function()
    fails({ 'deps', '--deps-output', '/' }, 'unsafe path')
    fails({ 'build', '--source', Source, '--build-dir', '/' }, 'unsafe path')
  end)

  suite.it('rejects nested writable roots', function()
    fails({ 'build', '--source', Source, '--build-dir', Root .. '/work/deps/sub' }, 'must be disjoint')
  end)

  suite.it('rejects source and outputs crossing', function()
    fails({ 'build', '--source', Source, '--build-dir', Source .. '/out' }, 'must be disjoint')
    fails({ 'build', '--source', Source, '--output-dir', '/tmp' }, 'must be disjoint')
  end)

  suite.it('rejects unsupported modes, engines, types, and triplets', function()
    fails({ 'deps', '--mode', 'distrobox' }, 'mode must be')
    fails({ 'deps', '--mode', 'vm' }, 'mode must be')
    fails({ 'deps', '--engine', 'zsh' }, 'engine must be')
    fails({ 'build', '--source', Source, '--build-type', 'Chaos' }, 'invalid CMake')
    fails({ 'deps', '--triplet', 'x64;whoami' }, 'invalid triplet')
  end)

  suite.it('rejects missing required source or tarballs', function()
    fails({ 'build' }, '--source or --repo is required')
    fails({ 'pipeline' }, '--source or --repo is required')
    fails({ 'package' }, '--source or --repo is required')
    fails({ 'smoke' }, 'smoke requires --archive')
    fails({ 'smoke', '--archive', '/tmp/deps.7z' }, '.tar.gz')
  end)

  suite.it('rejects incompatible options before execution', function()
    fails({ 'deps', '--run-tests' }, '--run-tests requires')
    fails({ 'pipeline', '--source', Source, '--no-prepare' }, 'incompatible')
    fails({ 'pipeline', '--source', Source, '--deps-archive', '/tmp/a.7z' }, 'generates its own')
    fails({ 'deps', '--no-smoke' }, 'require build, pipeline, or package')
    fails({ 'deps', '--with-qt' }, 'only valid for smoke')
  end)
end)

suite.describe('adversarial 7z metadata validation', function()
  local function rejects(listing: string)
    -- Invalid 7z metadata intentionally throws; the test asserts fail-closed behavior.
    local accepted = pcall(function() nativeArchive.validate7zListing(listing) end)
    test.expect(accepted).toBeFalsy()
  end

  local function entry(path: string, extra: string?): string
    return '7-Zip listing\n----------\nPath = package/installed/x64-linux-dynamic/lib/\nAttributes = D\n'
      .. 'Path = ' .. path .. '\n' .. (extra or '')
  end

  suite.it('accepts normal dependency archive members and internal relative symlinks', function()
    nativeArchive.validate7zListing(entry('package/installed/x64-linux-dynamic/lib/libfoo.so.1',
      'Attributes = A_ lrwxrwxrwx\nSymbolic Link = libfoo.so.1.2\n'))
  end)

  suite.it('rejects traversal, absolute Windows paths, and escaping symlink targets', function()
    for _, path in { '../escape', '/etc/passwd', 'C:/Windows/System32', 'package/../escape' } do
      rejects(entry(path))
    end
    local escaping = entry('package/installed/x64-linux-dynamic/lib/libbad.so',
      'Attributes = A_ lrwxrwxrwx\nSymbolic Link = ../../../../../etc/passwd\n')
    rejects(escaping)
  end)

  suite.it('fails closed when 7z metadata hides a symbolic-link target', function()
    local uninspectable = entry('package/installed/x64-linux-dynamic/lib/libfoo.so',
      'Attributes = A_ lrwxrwxrwx\n')
    rejects(uninspectable)
    rejects('invalid listing')
  end)
end)

suite.describe('embedded assets, versions, and archive names', function()
  suite.it('embeds vcpkg manifest and overlays in the Jess executable', function()
    test.expect(assets['deps/vcpkg.json']).toContain('boost-geometry')
    test.expect(assets['deps/triplets/x64-linux-dynamic.cmake']).toContain('VCPKG_TARGET_ARCHITECTURE')
    test.expect(assets['openmw/templates/runtime_wrapper.sh.in']).toContain('LD_LIBRARY_PATH')
  end)

  suite.it('compares ABI versions numerically', function()
    test.expect(nativeDeps.newer('2.35', '2.34')).toBeTruthy()
    test.expect(nativeDeps.newer('3.4.9', '3.4.29')).toBeFalsy()
    test.expect(nativeDeps.newer('3.4.29', '3.4.29')).toBeFalsy()
    test.expect(nativeDeps.newer('1.3.14', '1.3.13')).toBeTruthy()
  end)

  suite.it('rejects unsafe tar member names', function()
    for _, value in { '/etc/passwd', '../escape', 'nested/../escape', 'a/./b', 'C:\\etc', '' } do
      test.expect(nativeArchive.isSafeName(value)).toBeFalsy()
    end
  end)

  suite.it('accepts nested portable tar member names', function()
    for _, value in { 'openmw-0.49/', 'openmw-0.49/lib/libfoo.so.1', 'data/icons/foo.png' } do
      test.expect(nativeArchive.isSafeName(value)).toBeTruthy()
    end
  end)
end)

suite.describe('scheduled das-uberbranch release contract', function()
  suite.it('tracks the official master branch in one Jess configuration', function()
    local valid, reason = uber.validate(uberConfig)
    test.expect(valid).toBeTruthy()
    test.expect(reason).toBeNil()
    test.expect(uberConfig.repository).toBe('https://gitlab.com/OpenMW/openmw.git')
    test.expect(uberConfig.ref).toBe('master')
    test.expect(uberConfig.releaseTag).toBe('das-uberbranch')
  end)

  suite.it('only accepts safe repository references and the expected release tag', function()
    for _, record in {
      { repository = 'http://not-https.invalid/openmw', ref = 'master', releaseTag = 'das-uberbranch', jobs = 8 },
      { repository = uberConfig.repository, ref = '../escape', releaseTag = 'das-uberbranch', jobs = 8 },
      { repository = uberConfig.repository, ref = 'master', releaseTag = 'stable', jobs = 8 },
      { repository = uberConfig.repository, ref = 'master', releaseTag = 'das-uberbranch', jobs = 0 },
    } do
      local valid = uber.validate(record)
      test.expect(valid).toBeFalsy()
    end
  end)

  suite.it('uses a separate Docker pipeline with GoogleTests and selected source', function()
    local command = uber.buildArgs(uberConfig, '/tmp/forge-uber-fixture')
    test.expect(has(command, 'pipeline')).toBeTruthy()
    test.expect(has(command, '--repo')).toBeTruthy()
    test.expect(has(command, uberConfig.repository)).toBeTruthy()
    test.expect(has(command, '--ref')).toBeTruthy()
    test.expect(has(command, uberConfig.ref)).toBeTruthy()
    test.expect(has(command, '--run-tests')).toBeTruthy()
    test.expect(has(command, '/tmp/forge-uber-fixture')).toBeTruthy()
  end)

  suite.it('never mistakes a debug tarball for the main release', function()
    test.expect(uber.isMainTarball('openmw-0.53.0-gabc123def456-Linux-64Bit.tar.gz')).toBeTruthy()
    test.expect(uber.isMainTarball('openmw-0.53.0-gabc123def456-Linux-64Bit-debug.tar.gz')).toBeFalsy()
    test.expect(uber.isMainTarball('something-else.tar.gz')).toBeFalsy()
  end)
end)

return suite
