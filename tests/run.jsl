local clockworkSmoke = require '@forge/native-clockwork-smoke'
local nativePackage = require '@forge/native-package'
local sdkCache = require '@forge/native-sdk-cache'
local nativeDeps = require '@forge/native-deps'
local vcpkgPython = require '@forge/native-vcpkg-python'
local assets = require '@forge/assets'
local source = require '@forge/source'
local uber = require '@forge/uberbranch'
local uberConfig = require '@forge/uberbranch-config'
local releaseProfiles = require '@forge/release-profiles'
local suite = test.new()

suite.describe('Clockwork Vulkan frame qualification', function()
  suite.it('uses Clockwork CI’s pinned example suite and immutable builder identity', function()
    local root = '/tmp/clockwork-runtime-smoke-fixture'
    util.remove(root)
    util.mkdir(root)
    util.write(root .. '/.gitlab-ci.yml', table.concat({
      'EXAMPLE_SUITE_REVISION: a1ba6fc9d7315c2158ef4c60349fc4e71b7ca343',
      'EXAMPLE_SUITE_REVISION: a1ba6fc9d7315c2158ef4c60349fc4e71b7ca343',
      '',
    }, '\n'))
    local revision = clockworkSmoke.exampleSuiteRevision(root)
    test.expect(revision).toBe('a1ba6fc9d7315c2158ef4c60349fc4e71b7ca343')
    test.expect(clockworkSmoke.fullSha(revision)).toBeTruthy()
    test.expect(clockworkSmoke.fullSha('c5e5a9a6362c35512823884753d2d5284af204fa')).toBeTruthy()
    test.expect(clockworkSmoke.fullSha('c5e5a9a6')).toBeFalsy()
    test.expect(clockworkSmoke.containerName('4239', revision)).toBe(
      'forge-clockwork-vulkan-4239-a1ba6fc9d731')
  end)

  suite.it('builds a network-isolated runtime command over exact read-only build inputs', function()
    local command = clockworkSmoke.command('docker', 'forge-runtime-test',
      'forge-clockwork-vulkan-runtime:4239-a1ba6fc9d731',
      '/tmp/source', '/tmp/build', '/tmp/package', '/tmp/deps', '/tmp/example-suite', '/tmp/runtime-evidence',
      'a1ba6fc9d7315c2158ef4c60349fc4e71b7ca343')
    local joined = table.concat(command, '\n')
    test.expect(joined).toContain('--network\nnone')
    test.expect(joined).toContain('/tmp/source:/source:ro')
    test.expect(joined).toContain('/tmp/build:/build:ro')
    test.expect(joined).toContain('/tmp/package:/package:ro')
    test.expect(joined).toContain('/tmp/deps:/deps:ro')
    test.expect(joined).toContain('/tmp/example-suite:/example-suite:ro')
    test.expect(joined).toContain('/tmp/runtime-evidence:/output:rw')
    test.expect(joined).toContain('run_renderer_startup.py')
    test.expect(joined).toContain('/source/CI/run_vulkan_capture.py')
    test.expect(joined).toContain('NativeCodeGenTest.DisabledOrUnavailableCodegenRunsInterpreted')
    test.expect(joined).toContain('LuaUiContentTest.NestedContentChangesInvalidateParentContent')
    test.expect(joined).toContain('LuaUiLayout.NestedContentChangesUpdateTheRetainedDescendant')
    test.expect(joined).toContain('--headless')
    test.expect(joined).toContain('VK_DRIVER_FILES')
    -- Invalid moving tags must throw so runtime evidence cannot use an unpinned base.
    local ok = pcall(function()
      clockworkSmoke.command('docker', 'forge-runtime-test', 'ghcr.io/example/forge-builder:latest',
        '/tmp/source', '/tmp/build', '/tmp/package', '/tmp/deps', '/tmp/example-suite', '/tmp/runtime-evidence',
        'a1ba6fc9d7315c2158ef4c60349fc4e71b7ca343')
    end)
    test.expect(ok).toBeFalsy()
    test.expect(table.concat(clockworkSmoke.boundedCommand('docker', 2400, command), '\n'))
      .toContain('--kill-after=10s\n2400s\ndocker')
    test.expect(clockworkSmoke.runtimeDockerfile(
      'ghcr.io/example/forge-builder@sha256:' .. string.rep('b', 64)))
      .toContain('mesa-vulkan-drivers-24.1.2-3.el9.alma.2')
  end)

  suite.it('accepts only complete Vulkan renderer and scene-capture evidence', function()
    local root = '/tmp/clockwork-runtime-evidence'
    util.remove(root)
    util.mkdir(root .. '/runner/renderer_startup_output')
    util.mkdir(root .. '/vulkan-capture/capture')
    util.write(root .. '/runner/renderer_startup_output/result.json',
      '{"timed_out":false,"returncode":0,"errors":[],"renderer":{"entry":"vulkan 1.3","requested":"vulkan 1.3"}}\n')
    util.write(root .. '/vulkan-capture/capture.json',
      '{"timed_out":false,"returncode":0,"errors":[],"captures":["capture.omwcap"],"icd":"lvp_icd.x86_64.json"}\n')
    util.write(root .. '/vulkan-capture/capture/scene.omwcap', 'nonempty capture fixture')
    util.write(root .. '/vulkaninfo.txt', 'deviceName = llvmpipe (LLVM 18.1.8, 256 bits)\n')
    util.write(root .. '/vulkan-runtime-packages.txt', 'mesa-vulkan-drivers-24.1.2-3.el9.alma.2\n')
    util.write(root .. '/luau-ui-tests.txt', table.concat({
      '[       OK ] NativeCodeGenTest.DisabledOrUnavailableCodegenRunsInterpreted',
      '[       OK ] LuaUiContentTest.NestedContentChangesInvalidateParentContent',
      '[       OK ] LuaUiLayout.NestedContentChangesUpdateTheRetainedDescendant',
      '[       OK ] LuaUiLayout.ResolvesRelativeChildSizeAndAnchoredPosition',
    }, '\n') .. '\n')

    local function fixtureJson(path: string, query: string): boolean
      local data = util.file(path)
      if path:find('renderer_startup_output', 1, true) then
        return query:find('.renderer.entry', 1, true) ~= nil
          and data:find('"timed_out":false', 1, true) ~= nil
          and data:find('"errors":[]', 1, true) ~= nil
          and data:find('"entry":"vulkan 1.3"', 1, true) ~= nil
          and data:find('"requested":"vulkan 1.3"', 1, true) ~= nil
      end
      return query:find('.captures | length', 1, true) ~= nil
        and data:find('"timed_out":false', 1, true) ~= nil
        and data:find('"errors":[]', 1, true) ~= nil
        and data:find('"captures":["capture.omwcap"]', 1, true) ~= nil
        and data:find('"icd":"lvp_icd', 1, true) ~= nil
    end

    local function fixtureHashes(paths: { string }): string
      test.expect(#paths).toBe(6)
      return 'fixture-evidence-sha256\n'
    end
    local valid, reason = clockworkSmoke.validateEvidence(root,
      'c5e5a9a6362c35512823884753d2d5284af204fa', 'a1ba6fc9d7315c2158ef4c60349fc4e71b7ca343',
      'ghcr.io/example/forge-builder@sha256:' .. string.rep('b', 64), fixtureJson, fixtureHashes)
    test.expect(valid).toBeTruthy()
    test.expect(reason).toBeNil()
    test.expect(util.file(root .. '/CLOCKWORK-VULKAN-QUALIFICATION.txt')).toContain('Renderer: vulkan 1.3')
    test.expect(util.file(root .. '/CLOCKWORK-VULKAN-QUALIFICATION.txt'))
      .toContain('Clockwork source SHA: c5e5a9a6362c35512823884753d2d5284af204fa')
    test.expect(util.file(root .. '/CLOCKWORK-VULKAN-QUALIFICATION.txt'))
      .toContain('Builder image: ghcr.io/example/forge-builder@sha256:')

    util.write(root .. '/runner/renderer_startup_output/result.json',
      '{"timed_out":false,"returncode":0,"errors":[],"renderer":{"entry":"opengl","requested":"vulkan 1.3"}}\n')
    local rejected, failure = clockworkSmoke.validateEvidence(root,
      'c5e5a9a6362c35512823884753d2d5284af204fa', 'a1ba6fc9d7315c2158ef4c60349fc4e71b7ca343',
      'ghcr.io/example/forge-builder@sha256:' .. string.rep('b', 64), fixtureJson, fixtureHashes)
    test.expect(rejected).toBeFalsy()
    test.expect(failure).toContain('clean Vulkan 1.3 run')
  end)
end)

suite.describe('Clockwork release workflow', function()
  suite.it('keeps the experimental release manual, profile-isolated, and digest-pinned', function()
    local root, failure = fs.cwd()
    test.expect(root ~= nil and failure == nil).toBeTruthy()
    if not root then return end
    local workflow = util.file(root .. '/.github/workflows/das-uberbranch-clockwork.yml')
    local upstreamWorkflow = util.file(root .. '/.github/workflows/das-uberbranch.yml')
    local candidateVerifier = util.file(root .. '/tools/release_candidate.sh')
    test.expect(workflow).toContain('workflow_dispatch:')
    test.expect(workflow).toContain('force_rebuild:')
    local schedule = workflow:find('schedule:', 1, true)
    test.expect(schedule).toBeNil()
    test.expect(workflow).toContain('openmw-forge-das-uberbranch-clockwork')
    test.expect(workflow).toContain('FORGE_RELEASE_PROFILE: clockwork')
    test.expect(workflow).toContain('needs.preflight.outputs.should_build == \'true\'')
    test.expect(workflow).toContain('lfs pull origin "$suite_sha"')
    test.expect(workflow).toContain('FORGE_CLOCKWORK_EXAMPLE_SUITE: ${{ github.workspace }}/work/example-suite')
    test.expect(workflow).toContain('refusing fallback toolchains')
    test.expect(workflow).toContain('artifacts/uberbranch-clockwork/${{ github.run_id }}-${{ github.run_attempt }}/*')
    test.expect(workflow).toContain('needs: [preflight, recover-candidate, build]')
    test.expect(workflow).toContain('contents: write')
    test.expect(workflow).toContain('clockwork-vulkan-qualification-')
    test.expect(workflow).toContain('bash tests/release_preflight.sh')
    test.expect(workflow).toContain('bash tests/release_candidate.sh')
    test.expect(workflow).toContain('candidate_run_id:')
    test.expect(workflow).toContain('force_republish:')
    test.expect(workflow).toContain('actions: read')
    test.expect(workflow).toContain('tools/release_candidate.sh "$CANDIDATE_RUN_ID"')
    test.expect(workflow).toContain('--verify-artifacts "$PWD/recovered-candidate"')
    test.expect(workflow).toContain('candidate_valid=true')
    test.expect(candidateVerifier).toContain('falling back to a cold build')
    test.expect(workflow).toContain('candidate-republish')
    test.expect(workflow).toContain('ccache --show-stats')
    test.expect(workflow).toContain('openmw-das-uberbranch-clockwork-candidate-${{ github.run_id }}-${{ github.run_attempt }}')
    test.expect(upstreamWorkflow).toContain('candidate_run_id:')
    test.expect(upstreamWorkflow).toContain('force_republish:')
    test.expect(upstreamWorkflow).toContain('tools/release_candidate.sh "$CANDIDATE_RUN_ID"')
    test.expect(upstreamWorkflow).toContain('openmw-das-uberbranch-candidate-${{ github.run_id }}-${{ github.run_attempt }}')
    test.expect(upstreamWorkflow).toContain('ccache --show-stats')
  end)
end)

suite.describe('bounded OpenMW GUI smoke startup', function()
  suite.it('accepts a live GUI only without fatal Qt or loader diagnostics', function()
    for _, name in { 'openmw-launcher', 'openmw-cs', 'openmw-wizard' } do
      local alive = nativeSmoke.validateBoundedResult(name, name .. '.x86_64', 0, true, '', '')
      test.expect(alive).toBeTruthy()
      local badLoader = nativeSmoke.validateBoundedResult(name, name, 0, true, '',
        'error while loading shared libraries: libEGL.so.1: cannot open shared object file')
      test.expect(badLoader).toBeFalsy()
      local badQt = nativeSmoke.validateBoundedResult(name, name, 0, true, '',
        'Could not load the Qt platform plugin "offscreen"')
      test.expect(badQt).toBeFalsy()
      local crash = nativeSmoke.validateBoundedResult(name, name, 139, false, '', '')
      test.expect(crash).toBeFalsy()
      local exited = nativeSmoke.validateBoundedResult(name, name, 0, false, '', '')
      test.expect(exited).toBeTruthy()
      local badExit = nativeSmoke.validateBoundedResult(name, name, 1, false, '', '')
      test.expect(badExit).toBeFalsy()
    end
  end)

  suite.it('launches GUI startup without treating --help as a file to open', function()
    for _, name in { 'openmw-launcher', 'openmw-cs', 'openmw-wizard' } do
      local invocation = nativeSmoke.smokeInvocationArgs(name)
      test.expect(#invocation).toBe(0)
      local fatal = nativeSmoke.validateBoundedResult(name, name, 0, true,
        "Fatal error: Failed to open '--help' for reading", '')
      test.expect(fatal).toBeFalsy()
    end

    for _, name in { 'openmw', 'bsatool', 'esmtool', 'niftest' } do
      local invocation = nativeSmoke.smokeInvocationArgs(name)
      test.expect(#invocation).toBe(1)
      test.expect(invocation[1]).toBe('--help')
    end
  end)

  suite.it('never accepts a long-running command line tool as a working GUI', function()
    local stuck = nativeSmoke.validateBoundedResult('openmw', 'openmw', 0, true, '', '')
    test.expect(stuck).toBeFalsy()
    local normal = nativeSmoke.validateBoundedResult('openmw', 'openmw', 0, false, '', '')
    test.expect(normal).toBeTruthy()
    local toolHelp = nativeSmoke.validateBoundedResult('bsatool', 'bsatool', 1, false,
      'Inspect and extract files from Bethesda BSA archives', '')
    test.expect(toolHelp).toBeTruthy()
  end)
end)

suite.describe('packaged executable smoke contracts', function()
  suite.it('provides GL, EGL, GLib, GSSAPI and Wayland runtimes for graphical distro smoke tests', function()
    for _, tag in { 'almalinux-9', 'fedora-latest' } do
      local recipe = nativeSmoke.imageDockerfile(tag)
      test.expect(recipe).toContain('mesa-libGL libglvnd-egl glib2 krb5-libs libwayland-cursor libwayland-egl')
      test.expect(recipe).toContain('RUN dnf install -y ')
    end

    -- The actual Debian/Ubuntu package names differ across the time64 switch.
    for _, tag in { 'debian-12', 'ubuntu-22.04' } do
      local recipe = nativeSmoke.imageDockerfile(tag)
      test.expect(recipe).toContain('libgl1 libegl1 libglib2.0-0 libgssapi-krb5-2 libwayland-cursor0 libwayland-egl1')
      test.expect(recipe).toContain('RUN apt-get update && apt-get install -y ')
    end

    for _, tag in { 'debian-13', 'ubuntu-24.04' } do
      local recipe = nativeSmoke.imageDockerfile(tag)
      test.expect(recipe).toContain('libgl1 libegl1 libglib2.0-0t64 libgssapi-krb5-2 libwayland-cursor0 libwayland-egl1')
      test.expect(recipe).toContain('RUN apt-get update && apt-get install -y ')
    end

    test.expect(nativeSmoke.imageDockerfile('opensuse-tumbleweed'))
      .toContain('Mesa-libGL1 Mesa-libEGL1 libglib-2_0-0 krb5 libwayland-cursor0 libwayland-egl1')
    test.expect(nativeSmoke.imageDockerfile('archlinux'))
      .toContain('pacman -Sy --noconfirm --needed libglvnd glib2 krb5 wayland')
    test.expect(nativeSmoke.imageDockerfile('voidlinux'))
      .toContain('xbps-install -Sy libglvnd glib mit-krb5-libs wayland')

    for _, tag in { 'archlinux', 'voidlinux' } do
      test.expect(nativeSmoke.imageDockerfile(tag)).toContain('libglvnd')
    end
  end)

  suite.it('provides the system Vulkan loader without bundling an ICD', function()
    local packages: { [string]: string } = {
      ['almalinux-9'] = 'vulkan-loader',
      ['debian-12'] = 'libvulkan1',
      ['debian-13'] = 'libvulkan1',
      ['ubuntu-22.04'] = 'libvulkan1',
      ['ubuntu-24.04'] = 'libvulkan1',
      ['fedora-latest'] = 'vulkan-loader',
      ['archlinux'] = 'vulkan-icd-loader',
      ['opensuse-tumbleweed'] = 'libvulkan1',
      ['voidlinux'] = 'vulkan-loader',
    }

    for distro, loaderPackage in packages do
      local baseImage = nativeSmoke.imageDockerfile(distro)
      local vulkanImage = nativeSmoke.imageDockerfile(distro, true)
      test.expect(vulkanImage).toContain(loaderPackage)
      local loaderInBaseImage = string.find(baseImage, loaderPackage)
      test.expect(loaderInBaseImage).toBeNil()
    end
    test.expect(nativePackage.VulkanRuntimePolicy).toContain('does not bundle libvulkan.so.1')
    test.expect(nativePackage.VulkanRuntimePolicy).toContain('vendor driver/ICD')
  end)

  suite.it('requires Clockwork Vulkan, Luau UI resources and all dependency licenses', function()
    local root = '/tmp/clockwork-package-assets'
    util.remove(root)
    util.mkdir(root .. '/stage/resources/shaders')
    util.mkdir(root .. '/source/files/licenses')
    util.write(root .. '/stage/resources/shaders/runtime.glsl', '// shader')
    local features, parseError = args.parse({ 'build', '--require-feature', 'vulkan', '--require-feature', 'lua-ui' }, '/tmp/forge-root')
    if not features then error(parseError or 'cannot parse feature fixture') end
    local valid, reason = nativePackage.validateFeatureAssets(root .. '/stage', root .. '/source', features)
    test.expect(valid).toBeFalsy()
    test.expect(reason).toContain('luau.txt')

    local licenseFiles: { string } = {
      'luau.txt', 'glslang.txt', 'spirv-headers.txt', 'spirv-tools.txt',
      'vulkan-headers.txt', 'vulkan-memory-allocator.txt',
    }

    for _, filename in licenseFiles do
      util.write(root .. '/source/files/licenses/' .. filename, 'license fixture')
    end
    util.mkdir(root .. '/stage/resources/lua_libs')
    util.write(root .. '/stage/resources/lua_libs/content.lua', '-- Lua UI')
    valid = nativePackage.stageFeatureAssets(root .. '/stage', root .. '/source', features)
    test.expect(valid).toBeTruthy()
    for _, filename in licenseFiles do
      test.expect(fs.isFile(root .. '/stage/licenses/' .. filename)).toBeTruthy()
    end
    test.expect(util.file(root .. '/stage/VULKAN-RUNTIME.txt')).toContain('system')

    util.remove(root .. '/stage/resources/lua_libs/content.lua')
    valid, reason = nativePackage.validateFeatureAssets(root .. '/stage', root .. '/source', features)
    test.expect(valid).toBeFalsy()
    test.expect(reason).toContain('lua_libs/content.lua')

    local upstream, upstreamError = args.parse({ 'build' }, '/tmp/forge-root')
    if not upstream then error(upstreamError or 'cannot parse upstream fixture') end
    valid = nativePackage.stageFeatureAssets(root .. '/upstream-stage', root .. '/source', upstream)
    test.expect(valid).toBeTruthy()
    test.expect(fs.isFile(root .. '/upstream-stage/VULKAN-RUNTIME.txt')).toBeFalsy()
    util.remove(root)
  end)

  suite.it('reports all missing SONAMEs and version errors from ldd', function()
    local sample = [[/pkg/openmw-cs.x86_64:
        libgssapi_krb5.so.2 => not found
        libQt6Core.so.6 => /pkg/lib/libQt6Core.so.6 (0x1234)
/pkg/plugins/platforms/libqxcb.so:
        libXrender.so.1 => not found
]]
    local errors = nativeSmoke.closureProblems(sample, '', 0)
    test.expect(#errors).toBe(2)
    test.expect(errors[1]).toContain('/pkg/openmw-cs.x86_64')
    test.expect(errors[1]).toContain('libgssapi_krb5.so.2')
    test.expect(errors[2]).toContain('/pkg/plugins/platforms/libqxcb.so')
    test.expect(errors[2]).toContain('libXrender.so.1')

    local duplicates = nativeSmoke.closureProblems([[/pkg/openmw.x86_64:
        libfoo.so.1 => not found
        libfoo.so.1 => not found
]], '', 0)
    test.expect(#duplicates).toBe(1)
    test.expect(duplicates[1]).toContain('/pkg/openmw.x86_64')

    local versions = nativeSmoke.closureProblems('',
      "/pkg/lib/libQt6Core.so.6: /lib/libc.so.6: version `GLIBC_2.38' not found", 1)
    test.expect(#versions).toBe(1)
    test.expect(versions[1]).toContain('GLIBC_2.38')

    local okay = nativeSmoke.closureProblems('statically linked\n', '', 0)
    test.expect(#okay).toBe(0)
    local failure = nativeSmoke.closureProblems('', 'ldd: command not found', 127)
    test.expect(#failure).toBe(1)
    test.expect(failure[1]).toContain('command not found')
  end)

  suite.it('groups missing SONAME diagnostics without hiding other loader errors', function()
    local summaries = nativeSmoke.summarizeClosureFailures({
      'almalinux-9: /pkg/lib/libQt6WaylandClient.so.6: libwayland-cursor.so.0 => not found',
      'almalinux-9: /pkg/plugins/platforms/libqwayland-egl.so: libwayland-cursor.so.0 => not found',
      'ubuntu-24.04: /pkg/plugins/platforms/libqwayland-egl.so: libwayland-cursor.so.0 => not found',
      'ubuntu-24.04: /pkg/openmw-cs.x86_64: symbol lookup error: missing symbol',
    })
    test.expect(#summaries).toBe(3)
    test.expect(summaries[1]).toContain('almalinux-9: libwayland-cursor.so.0')
    test.expect(summaries[1]).toContain('2 affected ELF reports')
    test.expect(summaries[2]).toContain('ubuntu-24.04: libwayland-cursor.so.0')
    test.expect(summaries[3]).toContain('symbol lookup error')
  end)

  suite.it('runs a bounded dependency audit with the packaged runtime paths', function()
    local entries = { '/pkg/openmw-cs.x86_64', '/pkg/plugins/platforms/libqxcb.so' }
    local command = nativeSmoke.closureCommand('forge-smoke:test', '/fixture:/pkg:ro',
      entries, 1, #entries)
    test.expect(command[1]).toBe('run')
    test.expect(command[2]).toBe('--rm')
    test.expect(table.concat(command, ' ')).toContain('--network none')
    test.expect(table.concat(command, ' ')).toContain('LD_LIBRARY_PATH=/pkg/lib')
    test.expect(table.concat(command, ' ')).toContain('QT_PLUGIN_PATH=/pkg/plugins')
    test.expect(table.concat(command, ' ')).toContain('120s ldd')
    test.expect(command[#command - 1]).toBe('/pkg/openmw-cs.x86_64')
    test.expect(command[#command]).toBe('/pkg/plugins/platforms/libqxcb.so')
  end)

  suite.it('accepts only the documented exit-one OpenMW help responses', function()
    for _, fixture in {
      { 'bsatool', 'Inspect and extract files from Bethesda BSA archives' },
      { 'esmtool', 'Inspect and extract from Morrowind ES files' },
      { 'niftest', 'Ensure that OpenMW can use the provided NIF' },
    } do
      local tool = fixture[1]
      local banner = fixture[2]
      local accepted = nativeSmoke.validateHelpResult(tool, tool .. '.x86_64', false, 1, nil,
        banner .. '\nAllowed options\n', '')
      test.expect(accepted).toBeTruthy()
      local noBanner = nativeSmoke.validateHelpResult(tool, tool, false, 1, nil, '', '')
      test.expect(noBanner).toBeFalsy()
      local wrongStatus = nativeSmoke.validateHelpResult(tool, tool, false, 2, nil, banner, '')
      test.expect(wrongStatus).toBeFalsy()
      local noisyFailure = nativeSmoke.validateHelpResult(tool, tool, false, 1, nil, banner,
        'cannot open shared object')
      test.expect(noisyFailure).toBeFalsy()
    end
  end)

  suite.it('still rejects unrelated failures and successful loader errors', function()
    local normal = nativeSmoke.validateHelpResult('openmw', 'openmw', true, 0, nil, 'OpenMW help', '')
    test.expect(normal).toBeTruthy()
    local failed = nativeSmoke.validateHelpResult('openmw', 'openmw', false, 1, nil, 'help', '')
    test.expect(failed).toBeFalsy()
    local loader = nativeSmoke.validateHelpResult('openmw', 'openmw', true, 0, nil, '',
      'symbol lookup error')
    test.expect(loader).toBeFalsy()
    local bogus = nativeSmoke.validateHelpResult('bsatool', 'bsatool', true, 0, nil, '', '')
    test.expect(bogus).toBeFalsy()
  end)
end)

local Root = '/tmp/forge-root'
local Source = '/tmp/openmw-source'

local function parsed(values: { string }): args.Options
  local result, reason = args.parse(values, Root)
  if not result then error(reason or 'unexpected parse failure') end
  return result
end

local function plan(values: { string }): planning.Plan
  local options = parsed(values)
  local result, failure = planning.build(options)
  if not result then error(failure or 'unexpected planning failure') end
  return result
end

local function fails(values: { string }, reason: string)
  local options, parseError = args.parse(values, Root)
  if not options then
    test.expect(parseError or '').toContain(reason)
    return
  end
  local result, planningError = planning.build(options)
  test.expect(result).toBeNil()
  test.expect(planningError or '').toContain(reason)
end

local function has(values: { string }, wanted: string): boolean
  for _, value in values do
    if value == wanted then return true end
  end
  return false
end

local function shellFree(result: planning.Plan)
  for _, step in result.steps do
    test.expect(step.program == 'bash').toBeFalsy()
    test.expect(step.program == 'sh').toBeFalsy()
    for _, value in step.args do
      test.expect(value == '/builder/scripts/build_binaries.sh').toBeFalsy()
      test.expect(value == 'bash').toBeFalsy()
    end
  end
end

suite.describe('profile and CLI', function()
  suite.it('runs aqt in its writable Qt staging directory, not /forge', function()
    local options = parsed({ 'build', '--deps-prefix', '/deps' })
    local staging = '/deps/qt-install-staging'
    local command = nativeQt.aqtInvocation(options, staging)
    test.expect(command.program).toBe('python3')
    test.expect(command.cwd).toBe(staging)
    test.expect(command.argv[1]).toBe('-m')
    test.expect(command.argv[2]).toBe('aqt')
    test.expect(command.argv[3]).toBe('install-qt')
    test.expect(has(command.argv, options.qtVersion)).toBeTruthy()
    test.expect(command.argv[#command.argv - 1]).toBe('-O')
    test.expect(command.argv[#command.argv]).toBe(staging)
  end)

  suite.it('keeps manifest-mode vcpkg installed state in the writable checkout', function()
    local checkout = '/forge/work/vcpkg'
    test.expect(nativeDeps.installedRoot(checkout)).toBe(checkout .. '/installed')
    test.expect(nativeDeps.installedRootFlag(checkout)).toBe('--x-install-root=' .. checkout .. '/installed')
    test.expect(nativeDeps.installedRoot(checkout) == '/forge/work/forge-assets/deps/vcpkg_installed').toBeFalsy()
  end)

  suite.it('pins Jinja2 build-tool wheels and preserves unrelated Python environment settings', function()
    local wheels = vcpkgPython.wheels
    test.expect(#wheels).toBe(2)
    for _, wheel in wheels do
      test.expect(wheel.url:find('https://files.pythonhosted.org/', 1, true) == 1).toBeTruthy()
      test.expect(wheel.sha256:match('^[0-9a-f]+$') ~= nil).toBeTruthy()
      test.expect(#wheel.sha256).toBe(64)
    end
    local original = { PATH = '/toolchain/bin', CC = 'gcc' }
    local updated = vcpkgPython.addEnvironment(original, '/forge/work/vcpkg/.forge-python-wheels')
    test.expect(updated.PATH).toBe(original.PATH)
    test.expect(updated.CC).toBe('gcc')
    test.expect(updated.PIP_FIND_LINKS).toBe('/forge/work/vcpkg/.forge-python-wheels')
    test.expect(updated.PIP_CONSTRAINT).toBe('/forge/work/vcpkg/.forge-python-wheels/constraints.txt')
    test.expect(updated.PIP_NO_INPUT).toBe('1')
    test.expect(updated.PIP_NO_INDEX).toBeNil()
    test.expect(updated.PIP_USER).toBe('0')
    test.expect(original.PIP_FIND_LINKS).toBeNil()
  end)

  suite.it('disables inherited user-site pip installs in vcpkg virtualenvs', function()
    local original = { PATH = '/toolchain/bin', PIP_USER = '1' }
    local updated = vcpkgPython.addEnvironment(original, '/forge/work/vcpkg/.forge-python-wheels')
    test.expect(original.PIP_USER).toBe('1')
    test.expect(updated.PIP_USER).toBe('0')
    test.expect(updated.PATH).toBe('/toolchain/bin')
  end)

  suite.it('pins the AlmaLinux 9 ABI contract', function()
    test.expect(profile.image).toBe('almalinux:9')
    test.expect(profile.profile).toBe('alma9')
    test.expect(profile.triplet).toBe('x64-linux-dynamic')
  end)

  suite.it('has built-in help', function()
    test.expect(parsed({}).command).toBe('help')
    test.expect(parsed({ 'help' }).command).toBe('help')
    test.expect(parsed({ '--help' }).command).toBe('help')
    test.expect(parsed({ 'build', '--help' }).helpFor).toBe('build')
    test.expect(parsed({ 'help', 'smoke' }).helpFor).toBe('smoke')
    test.expect(parsed({ '--version' }).command).toBe('version')
  end)

  suite.it('defaults to the container profile', function()
    local options = parsed({ 'deps' })
    test.expect(options.mode).toBe('container')
    test.expect(options.engine).toBe('podman')
    test.expect(options.triplet).toBe(profile.triplet)
    test.expect(options.jobs).toBe('auto')
  end)

  suite.it('preserves arbitrary CMake arguments as values', function()
    local options = parsed({ 'build', '--cmake-arg', '-DHELLO=a b', '--cmake-arg=-DX=$HOME' })
    test.expect(options.cmakeArgs).toEqual({ '-DHELLO=a b', '-DX=$HOME' })
  end)

  suite.it('accepts only unique required feature assertions', function()
    local options = parsed({ 'build', '--require-feature', 'vulkan', '--require-feature=luau' })
    test.expect(options.requiredFeatures).toEqual({ 'vulkan', 'luau' })
    fails({ 'build', '--require-feature', 'opengl' }, '--require-feature must be')
    fails({ 'build', '--require-feature', 'vulkan', '--require-feature', 'vulkan' }, 'duplicate required feature')
  end)

  suite.it('accepts both --flag=value and --flag value', function()
    local options = parsed({ 'build', '--source=/tmp/a', '--jobs', '8', '--engine=docker' })
    test.expect(options.source).toBe('/tmp/a')
    test.expect(options.jobs).toBe(8)
    test.expect(options.engine).toBe('docker')
  end)

  suite.it('rejects unknown commands and flags', function()
    fails({ 'erase' }, 'unknown command')
    fails({ 'deps', '--execute-rm' }, 'unknown option')
  end)

  suite.it('rejects missing and empty options', function()
    fails({ 'deps', '--deps-output' }, 'missing value')
    fails({ 'deps', '--deps-output=' }, 'missing value')
  end)

  suite.it('supports CPU-aware parallelism and explicit job counts', function()
    test.expect(parsed({ 'build', '--jobs', 'auto' }).jobs).toBe('auto')
    test.expect(parsed({ 'build', '--jobs=auto' }).jobs).toBe('auto')
    test.expect(util.resolveJobs(4)).toBe(4)
    for _, value in { '0', '-3', '3.14', 'many', '1025' } do
      fails({ 'deps', '--jobs', value }, '--jobs must be auto or an integer')
    end
  end)

  suite.it('allows packed runtime internal phases', function()
    for _, command in { '__deps', '__build', '__package', '__verify', '__smoke' } do
      test.expect(parsed({ command }).command).toBe(command)
    end
  end)
end)

suite.describe('shell-free execution planning', function()
  suite.it('plans dependency build in one Alma 9 container image', function()
    local result = plan({ 'deps' })
    test.expect(#result.steps).toBe(2)
    test.expect(result.steps[1].program).toBe('podman')
    test.expect(has(result.steps[1].args, 'openmw-forge:alma9')).toBeTruthy()
    test.expect(has(result.steps[2].args, '__deps')).toBeTruthy()
    test.expect(has(result.steps[2].args, '/usr/local/bin/openmw-forge')).toBeTruthy()
    shellFree(result)
  end)

  suite.it('forwards dependency build concurrency and clean/preprovisioned flags', function()
    local result = plan({ 'deps', '--jobs', '12', '--no-system-packages', '--clean' })
    test.expect(has(result.steps[2].args, '--jobs')).toBeTruthy()
    test.expect(has(result.steps[2].args, '12')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--no-system-packages')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--clean')).toBeTruthy()
  end)

  suite.it('persists compiler cache as a writable host volume for container builds', function()
    local result = plan({ 'build', '--engine', 'docker', '--source', Source, '--deps-archive', '/tmp/deps.7z' })
    local expected = Root .. '/work/cache/ccache'
    test.expect(has(result.directories, expected)).toBeTruthy()
    test.expect(has(result.steps[2].args, expected .. ':/forge/work/ccache')).toBeTruthy()
  end)

  suite.it('never mounts a compiler cache when ccache is explicitly disabled', function()
    local result = plan({ 'build', '--source', Source, '--deps-archive', '/tmp/deps.7z', '--no-ccache' })
    test.expect(has(result.directories, Root .. '/work/cache/ccache')).toBeFalsy()
    for _, value in result.steps[2].args do
      test.expect(value:find('/forge/work/ccache', 1, true) == nil).toBeTruthy()
    end
  end)

  suite.it('does not mount a compiler cache for packaging-only operations', function()
    local result = plan({ 'package', '--source', Source })
    test.expect(has(result.directories, Root .. '/work/cache/ccache')).toBeFalsy()
    for _, value in result.steps[2].args do
      test.expect(value:find('/forge/work/ccache', 1, true) == nil).toBeTruthy()
    end
  end)

  suite.it('supports direct Jess-native local dependency builds', function()
    local result = plan({ 'deps', '--mode', 'local' })
    test.expect(#result.steps).toBe(1)
    test.expect(result.steps[1].program).toBe('@forge')
    test.expect(result.steps[1].args[1]).toBe('deps')
    shellFree(result)
  end)

  suite.it('reuses one image for the complete pipeline', function()
    local result = plan({ 'pipeline', '--source', Source })
    test.expect(#result.steps).toBe(3)
    test.expect(has(result.steps[2].args, '__deps')).toBeTruthy()
    test.expect(has(result.steps[3].args, '__build')).toBeTruthy()
    test.expect(has(result.steps[3].args, '/depout/vcpkg-x64-linux-dynamic.7z')).toBeTruthy()
    shellFree(result)
  end)

  suite.it('builds an existing dependency archive in a container', function()
    local result = plan({ 'build', '--source', Source, '--deps-archive', '/tmp/deps.7z' })
    test.expect(#result.steps).toBe(2)
    test.expect(has(result.steps[2].args, '/input/deps.7z')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--deps-archive')).toBeTruthy()
  end)

  suite.it('never silently accepts HTTP artifacts', function()
    fails({ 'build', '--source', Source, '--deps-archive', 'http://example.org/a.7z' }, 'only https')
  end)

  suite.it('forwards an explicit HTTPS archive', function()
    local result = plan({ 'build', '--source', Source, '--deps-archive', 'https://example.org/a.7z', '--deps-sha256', string.rep('a', 64) })
    test.expect(has(result.steps[2].args, 'https://example.org/a.7z')).toBeTruthy()
  end)

  suite.it('preserves untrusted CMake arguments as one argv field', function()
    local value = '-DFLAG=hello; $(touch /tmp/exploit)'
    local result = plan({ 'build', '--source', Source, '--cmake-arg', value })
    test.expect(has(result.steps[2].args, value)).toBeTruthy()
    test.expect(planning.display(result)).toContain("'-DFLAG=hello; $(touch /tmp/exploit)'")
    shellFree(result)
  end)

  suite.it('supports Docker volumes without SELinux label suffixes', function()
    local result = plan({ 'build', '--source', Source, '--engine', 'docker' })
    test.expect(result.steps[2].program).toBe('docker')
    test.expect(has(result.steps[2].args, Source .. ':/src:ro')).toBeTruthy()
    test.expect(has(result.steps[2].args, Source .. ':/src:ro,z')).toBeFalsy()
  end)

  suite.it('labels Podman writable volumes privately', function()
    local result = plan({ 'build', '--source', Source })
    test.expect(has(result.steps[2].args, Root .. '/work/build:/build:Z')).toBeTruthy()
  end)

  suite.it('runs package-only without recompiling', function()
    local result = plan({ 'package', '--source', Source, '--portable', '--no-smoke' })
    test.expect(#result.steps).toBe(2)
    test.expect(has(result.steps[2].args, '__package')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--portable')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--no-smoke')).toBeTruthy()
    shellFree(result)
  end)

  suite.it('forwards independent tests and compatibility options', function()
    local result = plan({ 'build', '--source', Source, '--run-tests', '--gtest-filter', 'MySuite.*', '--no-compat' })
    test.expect(has(result.steps[2].args, '--run-tests')).toBeTruthy()
    test.expect(has(result.steps[2].args, 'MySuite.*')).toBeTruthy()
    test.expect(has(result.steps[2].args, '--no-compat')).toBeTruthy()
  end)

  suite.it('supports reusing prepared dependencies', function()
    local result = plan({ 'build', '--source', Source, '--no-prepare' })
    test.expect(has(result.steps[2].args, '--no-prepare')).toBeTruthy()
    test.expect(has(result.steps[2].args, '/input/deps.7z')).toBeFalsy()
  end)

  suite.it('supports direct local build and package stages', function()
    for _, command in { 'build', 'package' } do
      local result = plan({ command, '--mode', 'local', '--source', Source })
      test.expect(#result.steps).toBe(1)
      test.expect(result.steps[1].program).toBe('@forge')
      test.expect(result.steps[1].args[1]).toBe(command)
    end
  end)

  suite.it('makes verification and smoke tests Jess commands', function()
    local verify = plan({ 'verify' })
    local smoke = plan({ 'smoke', '--archive', '/tmp/a.tar.gz' })
    test.expect(verify.steps[1].program).toBe('@forge')
    test.expect(smoke.steps[1].program).toBe('@forge')
    shellFree(verify)
    shellFree(smoke)
  end)

  suite.it('can select multi-distro smoke profiles', function()
    local result = plan({ 'smoke', '--archive', '/tmp/a.tar.gz', '--distros', 'almalinux-9,debian-12' })
    test.expect(result.steps[1].program).toBe('@forge')
  end)

  suite.it('does not modify anything in doctor or dry-run plans', function()
    local doctor = plan({ 'doctor' })
    test.expect(#doctor.steps).toBe(0)
    test.expect(#doctor.directories).toBe(0)
    local dry = plan({ 'deps', '--dry-run' })
    test.expect(#dry.steps).toBe(2)
  end)
end)

suite.describe('forks, sources, identity and resilient build plans', function()
  suite.it('supports independent managed checkouts for arbitrary HTTPS and SSH forks', function()
    local first = plan({ 'build', '--repo', 'https://github.com/example/OpenMW.git', '--ref', 'feat/custom-renderer' })
    local second = plan({ 'build', '--repo', 'https://github.com/another/OpenMW.git', '--ref', 'main' })
    test.expect(first.steps[1].program).toBe('@forge')
    test.expect(first.steps[1].args[1]).toBe('source')
    test.expect(second.steps[1].args[1]).toBe('source')
    test.expect(first.steps[1].cwd).toBe(Root)
    test.expect(source.path(Root, 'https://github.com/example/OpenMW.git') == source.path(Root, 'https://github.com/another/OpenMW.git')).toBeFalsy()
    test.expect(source.validRepo('git@github.com:example/OpenMW.git')).toBeTruthy()
    test.expect(source.validRepo('ssh://git@git.example/OpenMW.git')).toBeTruthy()
    test.expect(source.validRepo('https://git.example:8443/forks/OpenMW.git')).toBeTruthy()
    test.expect(source.validRef('refs/heads/feat/large-world')).toBeTruthy()
    test.expect(source.validRef('feature/été')).toBeTruthy()
    shellFree(first)
  end)

  suite.it('does not rewrite a user checkout or accept Git argument injection', function()
    fails({ 'build', '--source', Source, '--ref', 'other-branch' }, '--ref requires --repo')
    fails({ 'build', '--source', Source, '--repo', 'https://example.org/openmw.git' }, 'cannot be combined')
    fails({ 'build', '--repo', 'file:///tmp/local.git' }, 'invalid --repo')
    fails({ 'build', '--repo', 'https://example.org/openmw.git', '--ref=--upload-pack=evil' }, 'missing value')
    fails({ 'build', '--repo', 'https://example.org/openmw.git', '--ref', 'foo..bar' }, 'invalid --ref')
    fails({ 'build', '--repo', 'https://example.org/openmw.git', '--ref', 'foo@{1}' }, 'invalid --ref')
    fails({ 'deps', '--repo', 'https://example.org/openmw.git' }, '--repo requires')
  end)

  suite.it('rejects unsigned download plans and propagates verified hash to workers', function()
    fails({ 'build', '--source', Source, '--deps-archive', 'https://example.org/deps.7z' }, 'require --deps-sha256')
    fails({ 'build', '--source', Source, '--deps-archive', 'https://example.org/deps.7z', '--deps-sha256', 'abc' }, '64 hexadecimal')
    fails({ 'build', '--source', Source, '--deps-archive', 'https://example.org/deps.7z', '--deps-sha256', string.rep('x', 64) }, '64 hexadecimal')
    local digest = string.rep('a', 64)
    local item = plan({ 'build', '--source', Source, '--deps-archive', 'https://example.org/deps.7z', '--deps-sha256', digest })
    test.expect(has(item.steps[2].args, '--deps-sha256')).toBeTruthy()
    test.expect(has(item.steps[2].args, digest)).toBeTruthy()
  end)

  suite.it('does not mislabel tar.xz archives as .7z inside containers', function()
    local item = plan({ 'build', '--source', Source, '--deps-archive', '/tmp/deps.tar.xz' })
    test.expect(has(item.steps[2].args, '/input/deps.tar.xz')).toBeTruthy()
    local volumes = table.concat(item.steps[2].args, ' ')
    test.expect(volumes).toContain('/tmp/deps.tar.xz:/input/deps.tar.xz:ro')
  end)

  suite.it('persists vcpkg downloads and compiled binary caches across containers', function()
    local item = plan({ 'deps' })
    local volumes = table.concat(item.steps[2].args, ' ')
    test.expect(volumes).toContain('/work/cache/vcpkg:/forge/work/vcpkg:Z')
    test.expect(volumes).toContain('/work/cache/vcpkg-binaries:/forge/work/vcpkg-binaries:Z')
    test.expect(has(item.steps[2].args, '--no-system-packages')).toBeTruthy()
  end)
end)

suite.describe('path and configuration safety', function()
  suite.it('normalizes path traversals', function()
    test.expect(planning.normalize('/tmp/a/../b//./')).toBe('/tmp/b')
    test.expect(planning.normalize('/../../etc')).toBeNil()
    test.expect(planning.normalize('relative')).toBeNil()
  end)

  suite.it('rejects destructive write roots', function()
    fails({ 'deps', '--deps-output', '/' }, 'unsafe path')
    fails({ 'build', '--source', Source, '--build-dir', '/' }, 'unsafe path')
  end)

  suite.it('rejects nested writable roots', function()
    fails({ 'build', '--source', Source, '--build-dir', Root .. '/work/deps/sub' }, 'must be disjoint')
  end)

  suite.it('rejects source and outputs crossing', function()
    fails({ 'build', '--source', Source, '--build-dir', Source .. '/out' }, 'must be disjoint')
    fails({ 'build', '--source', Source, '--output-dir', '/tmp' }, 'must be disjoint')
  end)

  suite.it('rejects unsupported modes, engines, types, and triplets', function()
    fails({ 'deps', '--mode', 'distrobox' }, 'mode must be')
    fails({ 'deps', '--mode', 'vm' }, 'mode must be')
    fails({ 'deps', '--engine', 'zsh' }, 'engine must be')
    fails({ 'build', '--source', Source, '--build-type', 'Chaos' }, 'invalid CMake')
    fails({ 'deps', '--triplet', 'x64;whoami' }, 'invalid triplet')
  end)

  suite.it('rejects missing required source or tarballs', function()
    fails({ 'build' }, '--source or --repo is required')
    fails({ 'pipeline' }, '--source or --repo is required')
    fails({ 'package' }, '--source or --repo is required')
    fails({ 'smoke' }, 'smoke requires --archive')
    fails({ 'smoke', '--archive', '/tmp/deps.7z' }, '.tar.gz')
  end)

  suite.it('rejects incompatible options before execution', function()
    fails({ 'deps', '--run-tests' }, '--run-tests requires')
    fails({ 'pipeline', '--source', Source, '--no-prepare' }, 'incompatible')
    fails({ 'pipeline', '--source', Source, '--deps-archive', '/tmp/a.7z' }, 'generates its own')
    fails({ 'deps', '--no-smoke' }, 'require build, pipeline, or package')
    fails({ 'deps', '--with-qt' }, 'only valid for smoke')
  end)
end)

suite.describe('adversarial 7z metadata validation', function()
  local function rejects(listing: string)
    -- Invalid 7z metadata intentionally throws; the test asserts fail-closed behavior.
    local accepted = pcall(function() nativeArchive.validate7zListing(listing) end)
    test.expect(accepted).toBeFalsy()
  end

  local function entry(path: string, extra: string?): string
    return '7-Zip listing\n----------\nPath = package/installed/x64-linux-dynamic/lib/\nAttributes = D\n'
      .. 'Path = ' .. path .. '\n' .. (extra or '')
  end

  suite.it('uses a contained-link-compatible 7z policy without disabling all safety', function()
    local argv = nativeArchive.extractionArgs('/isolated/staging', '/cache/sdk.7z')
    test.expect(#argv).toBe(5)
    test.expect(argv[1]).toBe('x')
    test.expect(argv[2]).toBe('-y')
    test.expect(argv[3]).toBe('-snld10')
    test.expect(argv[4]).toBe('-o/isolated/staging')
    test.expect(argv[5]).toBe('/cache/sdk.7z')
    test.expect(table.concat(argv, ' '):find('-snld20', 1, true) == nil).toBeTruthy()
  end)

  suite.it('accepts chained library links and parent-relative in-tree service links', function()
    local prefix = 'package/installed/x64-linux-dynamic/lib/'
    local listing = '7-Zip listing\n----------\n'
      .. 'Path = ' .. prefix .. 'libfoo.so.1.2\nAttributes = A\n'
      .. 'Path = ' .. prefix .. 'libfoo.so.1\nAttributes =  lrwxrwxrwx\nSize = 13\n'
      .. 'Path = ' .. prefix .. 'libfoo.so\nAttributes =  lrwxrwxrwx\nSize = 11\n'
      .. 'Path = ' .. prefix .. 'systemd/system/dbus.socket\nAttributes = A\n'
      .. 'Path = ' .. prefix .. 'systemd/system/sockets.target.wants/dbus.socket\n'
      .. 'Attributes =  lrwxrwxrwx\nSize = 14\n'
    local targets: { [string]: string } = {
      [prefix .. 'libfoo.so.1'] = 'libfoo.so.1.2',
      [prefix .. 'libfoo.so'] = 'libfoo.so.1',
      [prefix .. 'systemd/system/sockets.target.wants/dbus.socket'] = '../dbus.socket',
    }
    nativeArchive.validate7zListing(listing, nil, true)
    nativeArchive.validate7zListing(listing, function(path: string): string
      local target = targets[path]
      if not target then error('unexpected fixture link: ' .. path) end
      return target
    end)
  end)

  suite.it('accepts normal dependency archive members and internal relative symlinks', function()
    nativeArchive.validate7zListing(entry('package/installed/x64-linux-dynamic/lib/libfoo.so.1',
      'Attributes = A_ lrwxrwxrwx\nSymbolic Link = libfoo.so.1.2\n'))
  end)

  suite.it('rejects traversal, absolute Windows paths, and escaping symlink targets', function()
    for _, path in { '../escape', '/etc/passwd', 'C:/Windows/System32', 'package/../escape' } do
      rejects(entry(path))
    end
    local escaping = entry('package/installed/x64-linux-dynamic/lib/libbad.so',
      'Attributes = A_ lrwxrwxrwx\nSymbolic Link = ../../../../../etc/passwd\n')
    rejects(escaping)
  end)

  suite.it('fails closed when 7z metadata hides a symbolic-link target', function()
    local uninspectable = entry('package/installed/x64-linux-dynamic/lib/libfoo.so',
      'Attributes = A_ lrwxrwxrwx\nSize = 13\n')
    rejects(uninspectable)
    rejects('invalid listing')
  end)

  suite.it('accepts a native 7z symlink whose target is stored as entry data', function()
    local member = 'package/installed/x64-linux-dynamic/debug/lib/libexpat.so'
    local target = 'libexpat.so.1'
    local inspected = 0
    nativeArchive.validate7zListing(entry(member,
      'Attributes =  lrwxrwxrwx\nSize = ' .. tostring(#target) .. '\n'), function(path: string): string
      inspected += 1
      test.expect(path).toBe(member)
      return target
    end)
    test.expect(inspected).toBe(1)
  end)

  suite.it('preflights compressed links without decompressing their payloads', function()
    local path = 'package/installed/x64-linux-dynamic/lib/libfoo.so'
    local listing = entry(path, 'Attributes =  lrwxrwxrwx\nSize = 13\n')
    nativeArchive.validate7zListing(listing, nil, true)

    -- The old API must still fail closed without an explicit preflight flag.
    rejects(listing)

    local inspected = 0
    nativeArchive.validate7zListing(listing, function(member: string): string
      inspected += 1
      test.expect(member).toBe(path)
      return 'libfoo.so.123'
    end)
    test.expect(inspected).toBe(1)
  end)

  suite.it('still rejects unsafe link bytes after a metadata-only preflight', function()
    local path = 'package/installed/x64-linux-dynamic/lib/libfoo.so'
    local target = '../../../../../etc/passwd'
    local listing = entry(path, 'Attributes =  lrwxrwxrwx\nSize = ' .. tostring(#target) .. '\n')
    nativeArchive.validate7zListing(listing, nil, true)
    -- The post-extraction unsafe-link rejection is expected to throw.
    local ok = pcall(function()
      nativeArchive.validate7zListing(listing, function(_member: string): string
        return target
      end)
    end)
    test.expect(ok).toBeFalsy()
  end)

  suite.it('requires link metadata and extracted targets to agree', function()
    local path = 'package/installed/x64-linux-dynamic/lib/libfoo.so'
    local listing = entry(path, 'Attributes = A_ lrwxrwxrwx\nSymbolic Link = libfoo.so.1\n')
    nativeArchive.validate7zListing(listing, nil, true)
    -- The metadata-vs-actual-target mismatch must throw on validation.
    local ok = pcall(function()
      nativeArchive.validate7zListing(listing, function(_member: string): string
        return 'libbar.so.1'
      end)
    end)
    test.expect(ok).toBeFalsy()
  end)

  suite.it('rejects ambiguous archive names and special links before extracting', function()
    local prefix = 'package/installed/x64-linux-dynamic/lib/'
    rejects(entry(prefix .. 'foo//bar'))
    rejects(entry(prefix .. 'foo\nbar'))
    rejects(entry(prefix .. 'foo', 'Hard Link = /etc/passwd\n'))
    rejects('7-Zip listing\n----------\nPath = ' .. prefix .. 'foo/\nAttributes = D\n'
      .. 'Path = ' .. prefix .. 'foo\nAttributes = A\n')

    local link = '7-Zip listing\n----------\nPath = ' .. prefix .. 'alias\n'
      .. 'Attributes =  lrwxrwxrwx\nSize = 7\n'
      .. 'Path = ' .. prefix .. 'alias/subdir/file\nAttributes = A\n'
    -- A child entry beneath an archived link must fail pre-extraction.
    local ok = pcall(function() nativeArchive.validate7zListing(link, nil, true) end)
    test.expect(ok).toBeFalsy()
  end)

  suite.it('rejects unsafe or inconsistent symlink data before extraction', function()
    local member = 'package/installed/x64-linux-dynamic/lib/libfoo.so'
    local function withTarget(target: string, size: number?): string
      return entry(member, 'Attributes = A_ lrwxrwxrwx\nSize = '
        .. tostring(size or #target) .. '\n')
    end

    local function rejectTarget(listing: string, target: string)
      -- An unsafe archived link deliberately throws; the test verifies rejection.
      local ok = pcall(function()
        nativeArchive.validate7zListing(listing, function(_path: string): string return target end)
      end)
      test.expect(ok).toBeFalsy()
    end
    rejectTarget(withTarget('/etc/passwd'), '/etc/passwd')
    rejectTarget(withTarget('../../../../../escape'), '../../../../../escape')
    rejectTarget(withTarget('libfoo.so.1', 200), 'libfoo.so.1')
    rejectTarget(entry(member, 'Attributes = A_ lrwxrwxrwx\nSize = 99999\n'), 'anything')
  end)

  suite.it('rejects duplicate entries and extraction through archived symlinks', function()
    rejects('7-Zip listing\n----------\nPath = package/installed/lib/libfoo.so\n'
      .. 'Path = package/installed/lib/libfoo.so\n')
    rejects('7-Zip listing\n----------\n'
      .. 'Path = package/installed/lib/alias\n'
      .. 'Attributes = A_ lrwxrwxrwx\nSymbolic Link = target\n'
      .. 'Path = package/installed/lib/alias/malicious.so\nAttributes = A\n')
  end)
end)

suite.describe('Qt build contract', function()
  suite.it('rejects unsupported headless builds rather than failing during CMake', function()
    local options, message = args.parse({ 'build', '--no-qt' }, '/tmp/forge')
    test.expect(options).toBeNil()
    test.expect(message).toContain('--no-qt')
  end)
end)

suite.describe('embedded assets, versions, and archive names', function()
  suite.it('embeds vcpkg manifest and overlays in the Jess executable', function()
    test.expect(assets['deps/vcpkg.json']).toContain('boost-geometry')
    test.expect(assets['deps/triplets/x64-linux-dynamic.cmake']).toContain('VCPKG_TARGET_ARCHITECTURE')
    test.expect(assets['openmw/templates/runtime_wrapper.sh.in']).toContain('LD_LIBRARY_PATH')
  end)

  suite.it('pins a content-addressed dependency SDK protocol', function()
    local fields = sdkCache.metadata('profile=alma9\ninputs_sha256=abc\narchive_sha256=def\n')
    test.expect(fields.profile).toBe('alma9')
    test.expect(fields.inputs_sha256).toBe('abc')
    test.expect(fields.archive_sha256).toBe('def')
  end)

  suite.it('checks ABI imports rather than the ELF version definitions', function()
    local definedOnly = 'Version definition section .gnu.version_d contains 2 entries:\n'
      .. '  Name: GLIBC_2.35\n'
      .. 'Version symbols section .gnu.version contains 2 entries:\n'
      .. '  GLIBC_2.35\n'
    local noImport = nativeAbi.incompatibleNeed(definedOnly)
    test.expect(noImport).toBeNil()

    local required = definedOnly .. 'Version needs section .gnu.version_r contains 1 entry:\n'
      .. '  File: libc.so.6\n'
      .. '  Name: GLIBC_2.35  Flags: none  Version: 2\n'
    local symbol, version, maximum = nativeAbi.incompatibleNeed(required)
    test.expect(symbol).toBe('GLIBC')
    test.expect(version).toBe('2.35')
    test.expect(maximum).toBe('2.34')
    local current = required:gsub('GLIBC_2.35  Flags', 'GLIBC_2.34  Flags')
    local currentNeed = nativeAbi.incompatibleNeed(current)
    test.expect(currentNeed).toBeNil()
    local libcxx = 'Version needs section .gnu.version_r contains 1 entry:\n'
      .. '  Name: GLIBCXX_3.4.30  Flags: none  Version: 3\n'
    local libcxxNeed = nativeAbi.incompatibleNeed(libcxx)
    test.expect(libcxxNeed).toBe('GLIBCXX')
  end)

  suite.it('pins a pre-backport AlmaLinux sysroot and audits it before provisioning', function()
    local dockerfile = assets['builder/Dockerfile']
    test.expect(dockerfile).toContain('FROM almalinux/9-base:9.5-20250519')
    for _, repo in { 'BaseOS', 'AppStream', 'CRB' } do
      test.expect(dockerfile).toContain('vault.almalinux.org/9.5/' .. repo .. '/')
    end
    test.expect(dockerfile).toContain('vault.almalinux.org/9.5/extras/')
    test.expect(dockerfile).toContain('gcc-toolset-13')
    test.expect(dockerfile).toContain('vulkan-loader-devel')
    test.expect(dockerfile).toContain('rpm -q glibc glibc-common')
    test.expect(dockerfile).toContain('nm -D --defined-only')
    test.expect(dockerfile).toContain('__memcmpeq|_dl_find_object|epoll_pwait2')
    test.expect(dockerfile).toContain('@{1,2}GLIBC_2[.]35')
    test.expect((dockerfile:find('readelf --version-info /lib64/libc.so.6', 1, true))).toBeNil()
    local early = dockerfile:find('RUN dnf install -y binutils', 1, true)
    local heavy = dockerfile:find('RUN dnf install -y git tar', 1, true)
    local late = dockerfile:find('RUN rpm -q glibc glibc-common', 1, true)
    test.expect(early ~= nil and heavy ~= nil and late ~= nil).toBeTruthy()
    if early and heavy and late then
      test.expect(early < heavy and heavy < late).toBeTruthy()
    end
    test.expect(profile.sdkRecipe).toContain('alma95')
  end)

  suite.it('runs the exact-revision Clockwork Vulkan probe in CI against the built image', function()
    local root, failure = fs.cwd()
    test.expect(root ~= nil and failure == nil).toBeTruthy()
    if not root then return end
    local workflow = util.file(root .. '/.github/workflows/forge-toolchain.yml')
    local probe = util.file(root .. '/tests/clockwork-vulkan-probe/CMakeLists.txt')
    local linkProbe = util.file(root .. '/tests/clockwork-vulkan-probe/vulkan_link_probe.cpp')
    test.expect(workflow).toContain('Build builder image and qualify Clockwork Vulkan')
    test.expect(workflow).toContain('docker/build-push-action@v7')
    test.expect(workflow).toContain('docker run --rm')
    test.expect(workflow).toContain('clockwork_vulkan_link_probe')
    test.expect(workflow).toContain('git ls-remote https://gitlab.com/OursCodeur/openmw.git refs/heads/clockwork-alpha')
    test.expect(probe).toContain('CACHE STRING')
    test.expect(probe).toContain('safe.directory=')
    test.expect(probe).toContain('TARGET Vulkan::Vulkan')
    test.expect(probe).toContain('vk_mem_alloc.h')
    test.expect(probe).toContain('clockwork_vulkan_link_probe vulkan_link_probe.cpp')
    test.expect(linkProbe).toContain('#define VMA_IMPLEMENTATION')
    test.expect(linkProbe).toContain('vkCreateInstance')
  end)

  suite.it('records memory and disk capacity before and after the expensive OpenMW build', function()
    local root, failure = fs.cwd()
    test.expect(root ~= nil and failure == nil).toBeTruthy()
    if not root then return end
    local workflow = util.file(root .. '/.github/workflows/das-uberbranch.yml')
    local resources = util.file(root .. '/tools/ci_resources.jsl')
    test.expect(workflow).toContain('tools/ci_resources.jsl --before-build')
    test.expect(workflow).toContain('tools/ci_resources.jsl --after-build')
    test.expect(workflow).toContain('always() && !cancelled() && steps.openmw-build.outcome != \'skipped\'')
    test.expect(resources).toContain("process.run('free', { '-h' }")
    test.expect(resources).toContain('memory.peak')
    test.expect(resources).toContain("util.checked('df', { '-h', root })")
  end)

  suite.it('compares ABI versions numerically', function()
    test.expect(nativeAbi.newer('2.35', '2.34')).toBeTruthy()
    test.expect(nativeAbi.newer('3.4.9', '3.4.29')).toBeFalsy()
    test.expect(nativeAbi.newer('3.4.29', '3.4.29')).toBeFalsy()
    test.expect(nativeAbi.newer('1.3.14', '1.3.13')).toBeTruthy()
  end)

  suite.it('rejects unsafe tar member names', function()
    for _, value in { '/etc/passwd', '../escape', 'nested/../escape', 'a/./b', 'C:\\etc', '' } do
      test.expect(nativeArchive.isSafeName(value)).toBeFalsy()
    end
  end)

  suite.it('accepts nested portable tar member names', function()
    for _, value in { 'openmw-0.49/', 'openmw-0.49/lib/libfoo.so.1', 'data/icons/foo.png' } do
      test.expect(nativeArchive.isSafeName(value)).toBeTruthy()
    end
  end)
end)

suite.describe('scheduled das-uberbranch release contract', function()
  suite.it('tracks the official master branch in one Jess configuration', function()
    local valid, reason = uber.validate(uberConfig)
    test.expect(valid).toBeTruthy()
    test.expect(reason).toBeNil()
    test.expect(uberConfig.repository).toBe('https://gitlab.com/OpenMW/openmw.git')
    test.expect(uberConfig.ref).toBe('master')
    test.expect(uberConfig.releaseTag).toBe('das-uberbranch')
    test.expect(uberConfig.jobs).toBe('auto')
  end)

  suite.it('validates both profiles and rejects unknown profile ids', function()
    local valid, reason = uber.validateProfiles()
    test.expect(valid).toBeTruthy()
    test.expect(reason).toBeNil()
    local known = uber.profile('clockwork')
    test.expect(known.releaseTag).toBe('das-uberbranch-clockwork')
    -- Unknown ids throw intentionally; this fixture verifies the diagnostic instead of aborting the suite.
    local ok = pcall(uber.profile, 'unknown')
    test.expect(ok).toBeFalsy()
  end)

  suite.it('rejects release tag and artifact namespace collisions', function()
    local clockwork = releaseProfiles.clockwork
    local duplicateTag = {
      id = clockwork.id, repository = clockwork.repository, ref = clockwork.ref,
      releaseTag = releaseProfiles.upstream.releaseTag, releaseTitle = clockwork.releaseTitle,
      jobs = clockwork.jobs, cmakeArgs = clockwork.cmakeArgs, artifactNamespace = clockwork.artifactNamespace,
      distros = clockwork.distros, features = clockwork.features,
      testPolicy = clockwork.testPolicy,
    }
    local tagValid, tagError = uber.validateProfiles({ upstream = releaseProfiles.upstream, clockwork = duplicateTag })
    test.expect(tagValid).toBeFalsy()
    test.expect(tagError).toBe('release tag collision between clockwork and upstream')

    duplicateTag.releaseTag = clockwork.releaseTag
    duplicateTag.artifactNamespace = releaseProfiles.upstream.artifactNamespace
    local namespaceValid, namespaceError = uber.validateProfiles({ upstream = releaseProfiles.upstream, clockwork = duplicateTag })
    test.expect(namespaceValid).toBeFalsy()
    test.expect(namespaceError).toBe('artifact namespace collision between clockwork and upstream')
  end)

  suite.it('requires Vulkan-enabled CMake configuration when a profile requires Vulkan', function()
    local clockwork = releaseProfiles.clockwork
    local invalid = {
      id = clockwork.id, repository = clockwork.repository, ref = clockwork.ref,
      releaseTag = clockwork.releaseTag, releaseTitle = clockwork.releaseTitle,
      jobs = clockwork.jobs, cmakeArgs = {}, artifactNamespace = clockwork.artifactNamespace,
      distros = clockwork.distros, features = clockwork.features,
      testPolicy = clockwork.testPolicy,
    }
    local valid, reason = uber.validate(invalid)
    test.expect(valid).toBeFalsy()
    test.expect(reason).toBe('profile requires Vulkan but OPENMW_USE_VULKAN is not ON')
  end)

  suite.it('uses a separate Docker pipeline with GoogleTests and selected source', function()
    local command = uber.buildArgs(uberConfig, '/tmp/forge-uber-fixture')
    test.expect(has(command, 'pipeline')).toBeTruthy()
    test.expect(has(command, '--repo')).toBeTruthy()
    test.expect(has(command, uberConfig.repository)).toBeTruthy()
    test.expect(has(command, '--ref')).toBeTruthy()
    test.expect(has(command, uberConfig.ref)).toBeTruthy()
    test.expect(has(command, '--run-tests')).toBeTruthy()
    test.expect(has(command, '--jobs')).toBeTruthy()
    test.expect(has(command, 'auto')).toBeTruthy()
    test.expect(has(command, '/tmp/forge-uber-fixture')).toBeTruthy()
  end)

  suite.it('honors profile GoogleTest, package smoke, and Qt smoke policies', function()
    local base = releaseProfiles.upstream
    local upstream = {
      id = base.id, repository = base.repository, ref = base.ref,
      releaseTag = base.releaseTag, releaseTitle = base.releaseTitle, jobs = base.jobs,
      cmakeArgs = base.cmakeArgs, artifactNamespace = base.artifactNamespace,
      distros = base.distros, features = base.features,
      testPolicy = { googleTests = false, packageSmoke = true, qtSmoke = false },
    }
    local valid, reason = uber.validate(upstream)
    test.expect(valid).toBeTruthy()
    test.expect(reason).toBeNil()
    local command = uber.buildArgs(upstream, '/tmp/forge-policy-fixture')
    test.expect(has(command, '--run-tests')).toBeFalsy()
    local smoke = uber.smokeArgs(upstream, '/tmp/openmw.tar.gz')
    test.expect(smoke ~= nil).toBeTruthy()
    test.expect(has(smoke or {}, '--with-qt')).toBeFalsy()
    test.expect(has(smoke or {}, 'vulkan')).toBeFalsy()

    upstream.testPolicy = { googleTests = true, packageSmoke = false, qtSmoke = false }
    local testsOnly = uber.buildArgs(upstream, '/tmp/forge-policy-fixture')
    test.expect(has(testsOnly, '--run-tests')).toBeTruthy()
    test.expect(uber.smokeArgs(upstream, '/tmp/openmw.tar.gz')).toBeNil()

    upstream.testPolicy = { googleTests = true, packageSmoke = true, qtSmoke = true }
    local fullSmoke = uber.smokeArgs(upstream, '/tmp/openmw.tar.gz')
    test.expect(has(fullSmoke or {}, '--with-qt')).toBeTruthy()

    local clockwork = uber.profile('clockwork')
    local clockworkSmoke = uber.smokeArgs(clockwork, '/tmp/clockwork.tar.gz')
    test.expect(has(clockworkSmoke or {}, '--require-feature')).toBeTruthy()
    test.expect(has(clockworkSmoke or {}, 'vulkan')).toBeTruthy()
  end)

  suite.it('requires exact-source Vulkan frame evidence before Clockwork provenance is qualified', function()
    local root, failure = fs.cwd()
    test.expect(root ~= nil and failure == nil).toBeTruthy()
    if not root then return end
    local orchestrator = util.file(root .. '/src/uberbranch.jsl')
    local genericSmoke = orchestrator:find('local smoke = smokeArgs(settings, main)', 1, true)
    local vulkanGate = orchestrator:find('clockworkSmoke.run(checkout', 1, true)
    local qualificationCopy = orchestrator:find("util.write(output .. '/VULKAN-QUALIFICATION.txt'", 1, true)
    local provenance = orchestrator:find("local notes = output .. '/SOURCE.txt'", 1, true)
    test.expect(genericSmoke ~= nil and vulkanGate ~= nil and qualificationCopy ~= nil and provenance ~= nil).toBeTruthy()
    if genericSmoke and vulkanGate and qualificationCopy and provenance then
      test.expect(genericSmoke < vulkanGate and vulkanGate < qualificationCopy and qualificationCopy < provenance)
        .toBeTruthy()
    end
    test.expect(orchestrator).toContain('if settings.features.vulkan then')
    test.expect(orchestrator).toContain('FORGE_CLOCKWORK_EXAMPLE_SUITE')
    test.expect(orchestrator).toContain("error('Clockwork runtime smoke requires exactly one staged OpenMW package')")
    test.expect(orchestrator).toContain('clockworkSmoke.run(checkout, root .. \'/work/build\'')
  end)

  suite.it('publishes Clockwork Vulkan evidence only with the checksummed qualified release', function()
    local root, failure = fs.cwd()
    test.expect(root ~= nil and failure == nil).toBeTruthy()
    if not root then return end
    local orchestrator = util.file(root .. '/src/uberbranch.jsl')
    local verifier = orchestrator:sub(orchestrator:find('local function verifyArtifacts', 1, true) or 1)
    test.expect(verifier).toContain('Clockwork release is missing Vulkan runtime qualification evidence')
    test.expect(verifier).toContain("Builder image: ' .. expectedBuilder")
    test.expect(verifier).toContain("VULKAN-QUALIFICATION.txt'] = qualificationPath")
    test.expect(verifier).toContain('table.insert(publishFiles, qualificationPath)')
    test.expect(verifier).toContain('table.insert(publishFiles, checksums)')
    test.expect(verifier).toContain("elseif argv[scan] == '--verify-artifacts' then")
    test.expect(verifier).toContain('PASS candidate artifacts match current preflight identity and checksums')
    local qualificationOrder = verifier:find('table.insert(publishFiles, qualificationPath)', 1, true)
    local checksumOrder = verifier:find('table.insert(publishFiles, checksums)', 1, true)
    test.expect(qualificationOrder ~= nil and checksumOrder ~= nil and qualificationOrder < checksumOrder)
      .toBeTruthy()
  end)

  suite.it('keeps Clockwork flags and artifact namespace separate from upstream', function()
    local clockwork = uber.profile('clockwork')
    local command = uber.buildArgs(clockwork, '/tmp/clockwork-output')
    test.expect(has(command, clockwork.repository)).toBeTruthy()
    test.expect(has(command, clockwork.ref)).toBeTruthy()
    test.expect(has(command, '-DOPENMW_USE_VULKAN=ON')).toBeTruthy()
    test.expect(has(command, '-DOPENMW_USE_SYSTEM_GLSLANG=OFF')).toBeTruthy()
    test.expect(has(command, '-DOPENMW_USE_SYSTEM_VULKAN_HEADERS=OFF')).toBeTruthy()
    test.expect(has(command, '-DOPENMW_USE_SYSTEM_VMA=OFF')).toBeTruthy()
    test.expect(has(command, '--require-feature')).toBeTruthy()
    test.expect(has(command, 'vulkan')).toBeTruthy()
    test.expect(has(command, 'luau')).toBeTruthy()
    test.expect(has(command, 'lua-ui')).toBeTruthy()
    test.expect(clockwork.artifactNamespace).toBe('uberbranch-clockwork')
    test.expect(clockwork.releaseTag == uberConfig.releaseTag).toBeFalsy()
  end)

  suite.it('rejects missing Clockwork feature configuration or compiled source entries', function()
    local cache = [=[
OPENMW_USE_VULKAN:BOOL=ON
OPENMW_USE_SYSTEM_GLSLANG:BOOL=OFF
OPENMW_USE_SYSTEM_VULKAN_HEADERS:BOOL=OFF
OPENMW_USE_SYSTEM_VMA:BOOL=OFF
CMAKE_EXPORT_COMPILE_COMMANDS:BOOL=ON
BUILD_OPENMW:BOOL=ON
BUILD_OPENMW_TESTS:BOOL=ON
BUILD_COMPONENTS_TESTS:BOOL=ON
]=]
    local compileCommands = [=[
"file": "/src/components/vulkan/device.cpp"
"file": "/build/components/devicetable.cpp"
"file": "/src/components/lua/nativecodegen.cpp"
"file": "/build/extern/fetched/luau/VM/src/lvmexecute.cpp"
"file": "/build/extern/fetched/luau/Compiler/src/Compiler.cpp"
"file": "/build/extern/fetched/luau/CodeGen/src/CodeGen.cpp"
"file": "/src/components/lua_ui/content.cpp"
"file": "/src/apps/openmw/mwlua/uibindings.cpp"
"file": "/src/apps/components_tests/lua/testluaunativecodegen.cpp"
"file": "/src/apps/components_tests/lua/testuicontent.cpp"
]=]
    local valid = nativeFeatureGate.validate(cache, compileCommands, { 'vulkan', 'luau', 'lua-ui' }, true)
    test.expect(valid).toBeTruthy()

    local upstreamCache = [=[
CMAKE_EXPORT_COMPILE_COMMANDS:BOOL=ON
BUILD_OPENMW_TESTS:BOOL=ON
BUILD_COMPONENTS_TESTS:BOOL=ON
]=]
    local upstream, upstreamReason = nativeFeatureGate.validate(upstreamCache,
      'apps/components_tests/testcomponents.cpp', {}, true)
    test.expect(upstream).toBeTruthy()
    test.expect(upstreamReason).toBeNil()

    local disabledVulkan = cache:gsub('OPENMW_USE_VULKAN:BOOL=ON', 'OPENMW_USE_VULKAN:BOOL=OFF')
    local disabled, reason = nativeFeatureGate.validate(disabledVulkan, compileCommands,
      { 'vulkan', 'luau', 'lua-ui' }, true)
    test.expect(disabled).toBeFalsy()
    test.expect(reason).toContain('OPENMW_USE_VULKAN must be ON')

    local missingLuauSource = compileCommands:gsub('/CodeGen/src/CodeGen%.cpp', '/CodeGen/src/not-built.cpp')
    local absent, sourceReason = nativeFeatureGate.validate(cache, missingLuauSource,
      { 'vulkan', 'luau', 'lua-ui' }, true)
    test.expect(absent).toBeFalsy()
    test.expect(sourceReason).toContain('/CodeGen/src/CodeGen.cpp')

    local testsDisabled = cache:gsub('BUILD_COMPONENTS_TESTS:BOOL=ON', 'BUILD_COMPONENTS_TESTS:BOOL=OFF')
    local noTests, testsReason = nativeFeatureGate.validate(testsDisabled, compileCommands,
      { 'vulkan', 'luau', 'lua-ui' }, true)
    test.expect(noTests).toBeFalsy()
    test.expect(testsReason).toContain('GoogleTests must be enabled')
  end)

  suite.it('separates verified SDK preparation from release compilation', function()
    local dependencies = uber.depsArgs(uberConfig)
    test.expect(dependencies[1]).toBe('deps')
    test.expect(has(dependencies, '--engine')).toBeTruthy()
    test.expect(has(dependencies, 'auto')).toBeTruthy()
    local build = uber.buildOnlyArgs(uberConfig, '/tmp/forge-output')
    test.expect(build[1]).toBe('build')
    test.expect(has(build, '--run-tests')).toBeTruthy()
    test.expect(has(build, 'auto')).toBeTruthy()
    test.expect(has(build, uberConfig.repository)).toBeTruthy()
    test.expect(has(build, '/tmp/forge-output')).toBeTruthy()
    local pinnedSha = string.rep('a', 40)
    local pinned = uber.buildOnlyArgs(uberConfig, '/tmp/forge-output', pinnedSha)
    test.expect(has(pinned, pinnedSha)).toBeTruthy()
    test.expect(has(pinned, uberConfig.ref)).toBeFalsy()
  end)

  suite.it('never mistakes a debug tarball for the main release', function()
    test.expect(uber.isMainTarball('openmw-0.53.0-gabc123def456-Linux-64Bit.tar.gz')).toBeTruthy()
    test.expect(uber.isMainTarball('openmw-0.53.0-gabc123def456-Linux-64Bit-debug.tar.gz')).toBeFalsy()
    test.expect(uber.isMainTarball('something-else.tar.gz')).toBeFalsy()
  end)
end)

return suite
